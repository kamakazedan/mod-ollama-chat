OllamaChat.Emote.Style.NAT_PETLOVER = "pet|pet|pat|cuddle|love|purr|awe|cheer|wave"
OllamaChat.Emote.Style.NAT_LOREBUFF = "ponder|point|nod|sigh|eyebrow|doubt|bow"
OllamaChat.Emote.Style.NAT_GOSSIP = "gasp|giggle|wink|snicker|shifty|eyebrow|smirk"
