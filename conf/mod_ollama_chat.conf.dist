#    OllamaChat.Echo.Enable
#    OllamaChat.Echo.Words
#    OllamaChat.Echo.Bots
#    OllamaChat.Echo.WindowMinutes
#    OllamaChat.Echo.CommonWords
#        Nobody can list every phrase a model falls back on, so they are
#        counted as they go out. A run of Words words that says something --
#        not every word in CommonWords -- that Bots other bots have said in the
#        last WindowMinutes is an echo: "fight one huge murloc" the fourth time
#        that hour, whoever says it, wherever. A line that echoes is dropped,
#        or, when owed to someone, asked for again (RetryOwed). A phrase the
#        line being answered has is fair game, and a name in brackets ("[Look
#        to the Stars]") is no phrase at all: no run counts any of its words.
#        The tank's answers in a dungeon are not looked at (they are kept from
#        repeating themselves by PartyCommands.RecentAcks). CommonWords:
#        single words, separated by |, the glue a phrase is not made of.
#        Default: 1, 4, 3, 60, (below)
OllamaChat.Echo.Enable = 1
OllamaChat.Echo.Words = 4
OllamaChat.Echo.Bots = 3
OllamaChat.Echo.WindowMinutes = 60
OllamaChat.Echo.CommonWords = "i|im|ive|ill|id|you|your|youre|ur|u|ya|the|a|an|to|of|in|on|at|for|with|and|or|but|so|it|its|is|are|was|were|be|been|am|do|does|did|dont|doesnt|didnt|not|no|yes|yeah|yep|just|get|got|go|going|gonna|can|cant|will|wont|would|could|should|what|how|why|where|when|who|that|this|there|here|they|them|we|us|me|my|he|she|his|her|have|has|had|if|then|than|too|up|out|all|any|some|one|lol|haha|ok|okay|oh|ah|like|really|well|now|anyone|someone|need|want|know|think|see|mean|sure|right|bit|lot|much|more|good|nice|thanks|ty|thx|about|from|by|as|off|over|still|again|back|yet|never|always|maybe|might|let|lets|make|take|give|come|say|said|thing|things|stuff|way|time|mate|guys|lads|man|though|tho|even|only|also"

#    OllamaChat.Response.DropVocatives
#        Words people get called that nobody here says: "just some cave mobs
#        kid" goes out as "just some cave mobs". Only where the word addresses
#        someone -- ending a sentence, before a comma, or opening the line --
#        never where it is what is talked about ("the kid in Stormwind", "my
#        kid"). A reply that was nothing else is dropped. Single words,
#        separated by |. Empty disables.
#        Default: "kid|kiddo"
OllamaChat.Response.DropVocatives = "kid|kiddo"

#    OllamaChat.Response.PetNames
#    OllamaChat.Response.PetNameStyles
#    OllamaChat.Response.PetNameEveryLines
#        Pet names people get called ("sugar", "darling", "hun"), and the
#        styles that call people them (personality keys, separated by |).
#        One of those styles keeps one at most once in PetNameEveryLines of
#        its lines; everyone else never says them. A model copies what is in
#        the chat above it: one bot called people "sugar", and soon half of
#        General was ending every line with it. Taken out the way
#        DropVocatives are, only where it addresses someone ("the ah is a
#        nightmare sugar" -> "the ah is a nightmare"); a reply that was
#        nothing else is dropped. PetNames empty disables; PetNameEveryLines
#        0 or 1 lets those styles use one every line.
#        Default: (below), "NAT_BUTTERFLY", 4
OllamaChat.Response.PetNames = "sugar|darling|dahling|darl|hun|hon|hunny|honey|sweetie|sweetheart|sweetcheeks|sugarplum|babe|babes|cutie|cupcake|doll|petal|treacle|buttercup|pumpkin|sunshine"
OllamaChat.Response.PetNameStyles = "NAT_BUTTERFLY"
OllamaChat.Response.PetNameEveryLines = 4

#    OllamaChat.Response.Swaps
#        Phrases people have stopped saying, and what they say now: a bot's
#        line says the new words instead. Each entry is old=new, separated by
#        |; several new ones, separated by commas, and one is picked each time
#        ("good point=true,fair"). Only where the phrase is a remark of its
#        own -- "Fair point, but..." goes out as "Fair, but...", "ok fair
#        point lol" as "ok fair lol" -- never where it is something talked
#        about: after "a", "the", "that's", "very" and the like ("that's a
#        fair point" stays), or before "about", "on", "there" and the like
#        ("fair point about the gear" stays). The new words keep the old
#        ones' capitals. Matched on whole words, case and apostrophes
#        ignored. Empty disables.
#        Default: "fair point=fair"
OllamaChat.Response.Swaps = "fair point=fair"

#    OllamaChat.Response.InsultWords
#    OllamaChat.Response.ProvokeWords
#    OllamaChat.Response.InsultPersonalities
#    OllamaChat.Response.InsultCooldownSeconds
#        An insult has its place: banter someone started, or someone being
#        rude first. Out of nowhere it is just wrong -- "are you doing
#        yowler?" got "nah just chilling here you knob". A reply that throws
#        one of InsultWords at someone ("you knob", "u absolute muppet",
#        "nice try noob") keeps it only when the line it answers had an
#        insult or a ProvokeWords word in it ("stfu", "ur mum", "fuck off"),
#        or when the bot's chat style is in InsultPersonalities -- and even
#        then once in InsultCooldownSeconds for that bot. Otherwise it is
#        taken out, with the "you" ("youre a", "ur such a") that went with
#        it. Talking about someone ("dont be a knob", "that pillock in
#        trade") is left alone. Words that are something else too (melon,
#        mug, clown) are not on the list: "selling melon" would lose its
#        melon. Words as CrowdText reads them; a trailing * matches any
#        ending. Empty InsultWords turns this off.
#        Default: (below), NAT_RUDE|NAT_KEYBOARD, 600
OllamaChat.Response.InsultWords = "knob|knobhead|knobend|nob|nobhead|twat|dickhead|bellend|pillock|wanker|tosser|prat|muppet|numpty|plonker|wally|idiot|moron|berk|noob|nub|loser|weirdo"
OllamaChat.Response.ProvokeWords = "fuck*|shit*|bastard*|bollocks|stfu|gtfo|shut up|ur mum|your mum|ur nan|your nan|yo mama|ur mom|your mom|l2p|learn to play|rekt|cope|useless|clueless|stupid|dumb|bad at|suck|sucks|banter|bants"
OllamaChat.Response.InsultPersonalities = "NAT_RUDE|NAT_KEYBOARD"
OllamaChat.Response.InsultCooldownSeconds = 600

#    OllamaChat.Banter.Words
#    OllamaChat.Banter.Text
#        A bot called a noob answered "Fair point, I'll keep farming". A real
#        player's line with one of Words (| separated, lowercase; a word
#        ending in * matches any word it starts), or with one of
#        Response.InsultWords, is a tease: each reply prompt is told so, near
#        the end, with Text -- it is banter, not a real complaint, and a bot it
#        was aimed at gives as good as it gets, in its own style, with one
#        kind of comeback picked each time ("{~a|b}"). {player_name} said it,
#        {tease} is the word. Someone who said they feel picked on
#        (Gear.BackOffWords) gets none of this for Gear.BackOffMinutes. No
#        double quotes inside it. Empty Text turns it off.
#        Default: (below)
OllamaChat.Banter.Words = "noob|noobs|nub|newb|n00b|scrub|clown|git gud|get good|l2p|learn to play|ur mum|your mum|ur mom|your mom|yo mama|ur nan|your nan|you suck|u suck|ur bad|youre bad|you are bad|tryhard|try hard|cringe"
OllamaChat.Banter.Text = "{player_name} is having a go ('{tease}'): that is banter, not a real complaint, and players here give as good as they get. If it was at you, fire one back in your own style -- {~a cheeky comeback about something real|mock outrage|turning it right back on them|a your mum joke|a daft threat to duel them over it|calling them a noob right back} -- and if it was at someone else, you can pile in on either side. Do not take it seriously, agree with it or apologise."

#    OllamaChat.State.Dead
#    OllamaChat.State.Ghost
#        Added to a dead bot's prompt, so what it says fits: lying where it
#        fell, or released and running back as a ghost. Empty leaves it out.
OllamaChat.State.Dead = "Right now you are dead: you died and are lying where you fell."
OllamaChat.State.Ghost = "Right now you are dead: you released your spirit and are running back to your body as a ghost."

###############################################################################
#
#   OLLAMA CHAT - CONVERSATION GOVERNOR
#
#   Four independent brakes, because bot chat runs away in four different ways.
#   If bots are talking endlessly among themselves, these are the settings to
#   reach for -- in particular RequireRecentHuman, which does most of the work.
#
###############################################################################

#    OllamaChat.BotConversation.MaxChainDepth
#        How many bot-replies-to-bot hops a conversation may run before it is
#        cut. A message from a real player is depth 0.
#        Default: 3
OllamaChat.BotConversation.MaxChainDepth = 3

#    OllamaChat.BotConversation.ChanceDecayPct
#        Reply chance multiplier applied at each hop, as a percentage. At 50, a
#        20% base chance becomes 10% at depth 1 and 5% at depth 2, so chains
#        run out of energy on their own well before the hard ceiling.
#        Default: 50
OllamaChat.BotConversation.ChanceDecayPct = 50

#    OllamaChat.BotConversation.RequireRecentHuman
#        Bots may only reply to OTHER BOTS while a real player has spoken in
#        that same channel recently. Two bots alone in a guild at 4am fall
#        silent; the same two bots talking around a player keep going.
#        Default: 1
OllamaChat.BotConversation.RequireRecentHuman = 1

#    OllamaChat.BotConversation.HumanWindowSeconds
#        How long a real player's message keeps bot-to-bot chat alive.
#        Default: 120
OllamaChat.BotConversation.HumanWindowSeconds = 120

#    OllamaChat.Cooldown.PerBotSeconds
#        Minimum gap between two lines from the same bot. This paces ambient
#        chatter and is deliberately skipped for direct address -- see
#        OllamaChat.Cooldown.DirectAddressGroupSize below.
#        Default: 45
OllamaChat.Cooldown.PerBotSeconds = 45

#    OllamaChat.Cooldown.PerScopeSeconds
#        Minimum gap between any two bot lines in the same channel.
#        Default: 15
OllamaChat.Cooldown.PerScopeSeconds = 15

#    OllamaChat.Cooldown.DirectAddressGroupSize
#        Party and raid chat from a real player counts as "direct address" when
#        the group has this many members or fewer, which exempts the reply from
#        the two pacing cooldowns above.
#
#        Those cooldowns exist to stop ambient chatter running hot. In a party
#        they did the wrong thing: a bot answered the first thing said to it and
#        then ignored the next 45 seconds of conversation, which looks like the
#        bot is broken rather than like rate limiting working. A five-person
#        party is a conversation; a 25-man raid is a crowd, so above this size
#        pacing comes back.
#
#        Whispers and messages that name the bot are always direct address,
#        whatever this is set to. Set to 0 to disable the group case and pace
#        party chat like any other channel.
#
#        The global RateLimit.GlobalPerMinute ceiling still applies to direct
#        address; that one protects the LLM backend, not the pacing.
#        Default: 5
OllamaChat.Cooldown.DirectAddressGroupSize = 5

#    OllamaChat.Cooldown.ConversationWindowSeconds
#        How long a bot stays "in conversation" with someone after answering
#        them, per channel. While that window is open, everything that person
#        says in that channel counts as direct address for that bot: it skips
#        the pacing cooldowns and replies at DirectAddressReplyChance.
#
#        This is what keeps a conversation going. Without it a bot answers the
#        first line, and then the follow-ups -- which usually do not repeat the
#        bot name -- fall back to ambient pacing and it goes quiet again.
#
#        Only ever opened against a real player, never bot-to-bot; that would
#        let two bots talk each other past every brake in the governor.
#        Set to 0 to require a name mention on every single line.
#        Default: 180
OllamaChat.Cooldown.ConversationWindowSeconds = 180

#    OllamaChat.DirectAddressReplyChance
#        Reply chance used instead of the per-channel PlayerReplyChance when the
#        line is aimed at this bot -- whispered, naming it, mid-conversation, or
#        in a small party. Someone who has been talking to you does not go 50/50
#        on whether to acknowledge your next sentence.
#
#        Never lowers a channel chance that is already higher. Set to 0 to turn
#        the boost off and use the ambient per-channel chance everywhere; note
#        that 0 also restores the old behaviour where a channel set to 0%
#        ignores a bot being addressed by name.
#        Default: 95
OllamaChat.DirectAddressReplyChance = 95

#    OllamaChat.RateLimit.ScopePerMinute
#        Ceiling on bot messages per channel per minute. 0 = unlimited.
#        Default: 8
OllamaChat.RateLimit.ScopePerMinute = 8

#    OllamaChat.RateLimit.GlobalPerMinute
#        Server-wide ceiling on bot messages per minute. Also caps your LLM
#        spend. 0 = unlimited.
#        Default: 40
OllamaChat.RateLimit.GlobalPerMinute = 40

#    OllamaChat.Repetition.BotHistorySize
#        How many of its own recent lines each bot remembers for comparison.
#        Default: 12
OllamaChat.Repetition.BotHistorySize = 12

#    OllamaChat.Repetition.ScopeHistorySize
#        How many recent lines each channel remembers, so two different bots do
#        not say the same thing.
#        Default: 30
OllamaChat.Repetition.ScopeHistorySize = 30

#    OllamaChat.Repetition.SimilarityThreshold
#        0.0 - 1.0. A candidate reply scoring at or above this against recent
#        history is discarded. Scoring is the higher of content-word Jaccard
#        and character-trigram cosine. Lower = stricter.
#        Default: 0.72
OllamaChat.Repetition.SimilarityThreshold = 0.72

#    OllamaChat.Repetition.WindowSeconds
#        How long remembered lines stay eligible for comparison.
#        Default: 1800
OllamaChat.Repetition.WindowSeconds = 1800

#    OllamaChat.Repetition.OpenerHistorySize
#        Recent opening phrases (first three words) blocked per channel. This
#        catches the "every bot starts with Aye," problem, which whole-line
#        similarity scoring misses.
#        Default: 8
OllamaChat.Repetition.OpenerHistorySize = 8

#    OllamaChat.Repetition.ShortLineWindowSeconds
#        Lines of three words or fewer ("lol", "no", "hey there") are only
#        compared with what was said in this many seconds. Over a busy evening
#        the same short reaction is bound to come round again; with the full
#        WindowSeconds most reactions in an active channel would be dropped.
#        0 = use WindowSeconds for short lines too.
#        Default: 300
OllamaChat.Repetition.ShortLineWindowSeconds = 300

#    OllamaChat.Repetition.OwnRepeatNote
#        A line a bot owes someone -- an answer, a reply to whoever spoke to
#        it -- is not held back by the checks above: ask a bot the same thing
#        twice and the same answer is right. But a line it said itself lately
#        (WindowSeconds, SimilarityThreshold) to something else is: "i'm going
#        to make him an offer he can't refuse", to one bot and then the next.
#        It gets one more go, told this ({line}: what it said before). Missed
#        twice, the line is held back if a bot was owed it, and goes out if a
#        person was: better the same line than none. Lines of three words or
#        fewer never count. Empty, or Response.RetryOwed = 0: no second go.
#        Default: "You said '{line}' a moment ago, to something else: say something different this time."
OllamaChat.Repetition.OwnRepeatNote = "You said '{line}' a moment ago, to something else: say something different this time."

###############################################################################
#
#   OLLAMA CHAT - SHARED CHAT CONTEXT
#
#   Each party, guild, channel and /say area keeps a short transcript of what
#   people and bots said there, plus a few game events (level-ups, deaths,
#   duels, guildmates coming online). Bots see it with every reply, reaction
#   and ambient line, so they answer as part of the conversation instead of
#   treating each line as the first thing anyone has said.
#
#   The transcript also decides who a message is aimed at. In chat, a line
#   typed right after someone else's is usually an answer to them: that bot
#   replies, and the rest are bystanders who usually stay out of it.
#
#   Prompt placeholders: {channel_history} and {reply_hint} in
#   ChatPromptTemplate, {channel_history} in RandomChatterPromptTemplate and
#   EventChatterPromptTemplate, {pass_token} in all three. A template without
#   them gets the transcript in front and the hint at the end, so templates
#   written for older builds keep working.
#
###############################################################################

#    OllamaChat.Context.Enable
#        Keep transcripts and use them in prompts and to pick who answers.
#        Default: 1
OllamaChat.Context.Enable = 1

#    OllamaChat.Context.MaxLines
#        Most transcript lines put in one prompt.
#        Default: 10
OllamaChat.Context.MaxLines = 10

#    OllamaChat.Context.MaxAgeSeconds
#        Lines older than this are left out.
#        Default: 300
OllamaChat.Context.MaxAgeSeconds = 300

#    OllamaChat.Context.ReplyWindowSeconds
#        A line typed within this many seconds of someone else's counts as an
#        answer to them. After a longer pause it is said to the room.
#        Default: 60
OllamaChat.Context.ReplyWindowSeconds = 60

#    OllamaChat.Context.AmbientHoldSeconds
#        After a real player says something -- in their party, a channel,
#        /say nearby or guild chat -- bots say nothing unprompted there for
#        this many seconds: no ambient lines or asks while the answers come
#        in. And an unprompted line written before a real player spoke there
#        is not sent at all: "this place is a proper maze" landed in party
#        straight after a joke about a roll of 1. 0 = off.
#        Default: 60
OllamaChat.Context.AmbientHoldSeconds = 60

#    OllamaChat.Context.LeadUpText
#    OllamaChat.Context.LeadUpMaxWords
#        A short line from a real player means little on its own -- "*luck
#        intensifies*" just after rolling a 1 -- and with what came before it
#        only further up, in the transcript, it was answered as if it came
#        out of nowhere. A line of up to LeadUpMaxWords words (0: any length)
#        typed within ReplyWindowSeconds of something else gets LeadUpText,
#        last, next to the reply hint: {player_name} is who typed it,
#        {lead_up} what it came right after -- someone's line, or something
#        that happened (a loot roll, a level-up), and what that line was
#        about when it came just after one:
#          this happened: loot roll for Gloves of the Fang (...) -- Lanik won
#          it, and then you said "1 out of 100 is a proper joke."
#        Not for a line to everyone ("anyone up for deadmines?") or an order.
#        Empty LeadUpText turns it off.
#        Default: "{player_name} typed that right after {lead_up}, so it is most likely about that.", 8
OllamaChat.Context.LeadUpText = "{player_name} typed that right after {lead_up}, so it is most likely about that."
OllamaChat.Context.LeadUpMaxWords = 8

#    OllamaChat.Context.BystanderChancePct
#        When a person's line is clearly aimed at someone else, the other
#        bots' reply chance is multiplied by this percentage. Not used while
#        Crowd.Enable = 1 (see Crowd.ChimeInChance).
#        Default: 25
OllamaChat.Context.BystanderChancePct = 25

#    OllamaChat.Context.BotAddressedChance
#        Chance (before chain decay) that a bot answers another bot whose
#        line was a reply to it.
#        Default: 40
OllamaChat.Context.BotAddressedChance = 40

#    OllamaChat.Context.BotReplyPerMessage
#        1 = BotReplyChance.* is the chance that ANY bot answers a bot's line.
#        0 = one independent roll per listening bot (the older behaviour),
#            which makes a reply near-certain in a crowded channel.
#        Default: 1
OllamaChat.Context.BotReplyPerMessage = 1

#    OllamaChat.Context.BotLineReplyChance.Say
#    OllamaChat.Context.BotLineReplyChance.Party
#    OllamaChat.Context.BotLineReplyChance.Guild
#    OllamaChat.Context.BotLineReplyChance.Channel
#        With BotReplyPerMessage = 1: the chance (0-100) that a bot's line in
#        that kind of channel gets an answer from another bot. With
#        Crowd.Enable = 1 the first answer uses it as it is and each answer to
#        an answer is reduced by BotConversation.ChanceDecayPct; without crowds
#        the first hop is already reduced, so 50 is about 1 in 4.
#        BotReplyChance.* is used instead when BotReplyPerMessage = 0.
#        Default: 50, 60, 50, 40
OllamaChat.Context.BotLineReplyChance.Say = 50
OllamaChat.Context.BotLineReplyChance.Party = 60
OllamaChat.Context.BotLineReplyChance.Guild = 50
OllamaChat.Context.BotLineReplyChance.Channel = 40

#    OllamaChat.Context.BotChatWithoutRecentHuman
#        With BotReplyPerMessage = 1: bots may answer each other whenever a
#        real player can see the channel, not only within
#        BotConversation.HumanWindowSeconds of one typing there
#        (BotConversation.RequireRecentHuman is then ignored for bot lines).
#        Default: 1
OllamaChat.Context.BotChatWithoutRecentHuman = 1

#    OllamaChat.Context.SuppressPairHistory
#        Leave {chat_history} empty when {channel_history} already has recent
#        lines, so one exchange is not shown twice. Whispers always keep it.
#        Default: 1
OllamaChat.Context.SuppressPairHistory = 1

#    OllamaChat.Context.PassToken
#        What a bot answers with to say nothing at all. Such replies are
#        dropped quietly and counted as "passed by the bot" in .ollama status.
#        Default: NOREPLY
OllamaChat.Context.PassToken = NOREPLY

#    OllamaChat.Context.HistoryHeader
#        First line of a transcript. {channel} is "party chat", "guild chat",
#        "General", "/say nearby" and so on.
OllamaChat.Context.HistoryHeader = "Recent {channel}, oldest first (context only):"

#    OllamaChat.Context.HintAddressed
#    OllamaChat.Context.HintBystander
#    OllamaChat.Context.HintOpen
#        Added to a reply prompt when the line was aimed at this bot, at
#        someone else ({addressee}), or at nobody in particular.
#        {pass_token} is PassToken.
OllamaChat.Context.HintAddressed = "They are talking to you, so answer them."
OllamaChat.Context.HintBystander = "That message was most likely meant for {addressee}, not you. Usually stay out of it and reply with just {pass_token}; only chip in if a real player would, with a joke, a correction or something useful."
OllamaChat.Context.HintOpen = "It was said to everyone, not to you in particular. Answer if you know or have something to add; if the chat above already covers it, reply with just {pass_token}."

#    OllamaChat.Context.HintPublicWithGroup
#        Added to a reply prompt when someone in the bot's own group says
#        something in General, Trade or guild chat, so the answer is a line
#        for that channel and not party talk -- without it "hey all" in
#        General got "ready to move?". {player_name}, {channel} ("General",
#        "guild chat"). There, a bot told to stay is not told so either.
#        Empty disables.
OllamaChat.Context.HintPublicWithGroup = "{player_name} is in your group, but said that in {channel}, not in party chat, so answer it as a {channel} line: keep group business (moving on, pulling, waiting for someone) for party chat."

#    OllamaChat.Context.HintEvent
#        Added to event reaction prompts.
OllamaChat.Context.HintEvent = "If a real player in your place would not bother commenting, reply with just {pass_token}."

#    OllamaChat.Context.HintAmbient
#        Added after the transcript in an ambient prompt, only when there is
#        recent chat to join.
OllamaChat.Context.HintAmbient = "If that conversation is still going, you can add to it naturally instead of changing the subject."

#    OllamaChat.Context.FillerWords
#        Words that read naturally now and then and badly in every line,
#        separated by |. A trailing * matches any word starting with it
#        (haha* = haha, hahaha, ...). Empty turns rationing off.
#        Default: ""
OllamaChat.Context.FillerWords = ""

#    OllamaChat.Context.MaxFillersPerLine
#        Default: 1
OllamaChat.Context.MaxFillersPerLine = 1

#    OllamaChat.Context.FillerScopeLines
#        A filler that appeared in this many recent lines of the channel is
#        taken out of a new reply there, so bots do not echo each other's lol.
#        Default: 6
OllamaChat.Context.FillerScopeLines = 6

#    OllamaChat.Context.FillerBotCooldownSeconds
#        A bot does not use the same filler again within this many seconds.
#        A reply that is nothing but a laugh is kept as a reaction, unless a
#        bot's laugh-only line is already among the last FillerScopeLines.
#        What counts as a laugh is FillerWords; empty turns all of this off.
#        Default: 900
OllamaChat.Context.FillerBotCooldownSeconds = 900

###############################################################################
#
#   OLLAMA CHAT - TEXT EMOTICONS
#
#   People put a smiley in a line now and then -- ":)", ":D", "xD", ">.<",
#   "<3", ":O" -- and it makes chat feel alive, but only now and then: in
#   every line, from every bot, it looks silly. So:
#
#     * a bot's prompt only rarely says a smiley would do in this one, with
#       two from Offer picked at random to choose from -- NudgeChance % of
#       the time, or its chat style's own share in StyleChance (an excitable
#       or bubbly style more, a terse veteran never);
#     * whatever the model writes, a line keeps at most one (any of Tokens),
#       and none when the bot sent one in the last BotCooldownMinutes, or one
#       is among the last ScopeLines lines where it is going.
#
#   SystemPrompt still says no emoji: these are typed faces, not pictures.
#
###############################################################################

#    OllamaChat.Emoticons.Enable
#        0 keeps every line free of them (and never nudges).
#        Default: 1
OllamaChat.Emoticons.Enable = 1

#    OllamaChat.Emoticons.Tokens
#    OllamaChat.Emoticons.Offer
#        What counts as one at delivery, and what a nudge offers, separated
#        by spaces; case does not matter. (No ":|": a | in a chat line is the
#        client's markup, and never gets through.)
OllamaChat.Emoticons.Tokens = ":) :-) :( :-( :D :-D xD :P :-P ;) ;-) :O o.O O.o o.o >.< >_< <3 ^^ ^_^ :/ D: :3 =) =D -_- T_T :S ;P :]"
OllamaChat.Emoticons.Offer = ":) :D xD :P ;) :O >.< <3 ^^ :( o.O -_- :/"

#    OllamaChat.Emoticons.NudgeChance
#    OllamaChat.Emoticons.StyleChance
#    OllamaChat.Emoticons.NudgeText
#        The share of prompts (0-100) that get NudgeText ({emoticons}: two of
#        Offer, ":P or <3"); StyleChance gives chat styles their own,
#        "KEY:percent" pairs separated by spaces.
#        Default: 4, (below), (below)
OllamaChat.Emoticons.NudgeChance = 4
OllamaChat.Emoticons.StyleChance = "NAT_EXCITABLE:15 NAT_BUTTERFLY:15 NAT_HYPE:12 NAT_REACTOR:12 NAT_SOCIAL:10 NAT_FRIENDLY:8 NAT_JOKER:8 NAT_NEWBIE:8 NAT_PETLOVER:8 NAT_LOWERCASE:6 NAT_PRANKSTER:6 NAT_CHILL:5 NAT_BANTER:5 NAT_TERSE_VET:0 NAT_PROPER:1 NAT_DEADPAN:1 NAT_GRUMBLER:1 NAT_RUDE:1 NAT_LONER:1 NAT_EXPERT:1 NAT_MINMAXER:1 NAT_QUIET:2"
OllamaChat.Emoticons.NudgeText = "Some people put a smiley in a line now and then. If it really fits this one, you can use {emoticons}; most of the time you would not."

#    OllamaChat.Emoticons.BotCooldownMinutes
#    OllamaChat.Emoticons.ScopeLines
#        Default: 20, 8
OllamaChat.Emoticons.BotCooldownMinutes = 20
OllamaChat.Emoticons.ScopeLines = 8

###############################################################################
#
#   OLLAMA CHAT - CROWD REPLIES
#
#   A line said to a channel gets a planned set of answers from different
#   bots instead of one roll per listening bot capped at MaxBotsToPick (which
#   is ignored while this is on). "anyone around?" in a busy channel gets
#   three to five answers; a line aimed at one bot gets that bot, and now and
#   then someone else chiming in; "ty" or "lol" gets at most the bot it was
#   meant for.
#
#   The answers come one at a time. Each bot only starts once the previous
#   answer is in chat, and it sees that answer, so it can laugh at it,
#   disagree with it or leave it ({pass_token}). The voices are picked to
#   differ: a different personality each where possible, playful and
#   straight styles taking turns.
#
#   Bots also answer each other through the same machinery: an ambient line
#   can get one or two answers, and a crowd reply that names another bot in
#   the same crowd can get an answer back. Event reactions (gz, rip, wb) never
#   start a conversation.
#
#   Needs Context.Enable = 1. Whispers are unaffected.
#
###############################################################################

#    OllamaChat.Crowd.Enable
#        Default: 1
OllamaChat.Crowd.Enable = 1

#    OllamaChat.Crowd.MaxResponders
#        Most bots that answer one line said to everyone (1-10).
#        Default: 5
OllamaChat.Crowd.MaxResponders = 5

#    OllamaChat.Crowd.BotsPerResponder
#        How busy a place must be: one possible responder per this many bots
#        that can hear the line. With 3: up to 3 listening -> 1, 4-6 -> 2,
#        7-9 -> 3, 13 or more -> MaxResponders. An open call gets between half
#        of that and all of it; a line to nobody in particular, one up to half.
#        Default: 3
OllamaChat.Crowd.BotsPerResponder = 3

#    OllamaChat.Crowd.ChimeInChance
#    OllamaChat.Crowd.ChimeInMax
#        A line aimed at one bot: the chance (0-100) that another bot chimes in
#        as well, rolled again for each extra voice, up to ChimeInMax.
#        Default: 40, 2
OllamaChat.Crowd.ChimeInChance = 40
OllamaChat.Crowd.ChimeInMax = 2

#    OllamaChat.Crowd.AckReplyChance
#        A line that is only a laugh or a yes/no ("lol", "ok np"): the chance
#        the bot it was meant for answers at all. Nobody else does.
#        Default: 50
OllamaChat.Crowd.AckReplyChance = 50

#    OllamaChat.Crowd.ThanksWords
#    OllamaChat.Crowd.ThanksReplyChance
#        A line that is only thanks ("ty", "thanks", "cheers mate", "thank you
#        Zonin"), whispered or not: the chance anyone answers it. A
#        congratulation answered with "ty" is finished, so by default nobody
#        does. A thank-you that asks something as well ("ty, need a group
#        later?") is an ordinary line. Words separated by |; a trailing *
#        matches any word starting with it.
#        Default: (below), 0
OllamaChat.Crowd.ThanksWords = "ty|thx|thnx|thanks|thank|tyvm|tysm|tyty|ta|cheers|appreciate*|appreciated"
OllamaChat.Crowd.ThanksReplyChance = 0

#    OllamaChat.Crowd.ReplyGapMinMs
#    OllamaChat.Crowd.ReplyGapMaxMs
#        Pause after one bot's answer appears before the next bot starts on
#        theirs. Generation and TypingSimulation come on top.
#        Default: 1000, 4000
OllamaChat.Crowd.ReplyGapMinMs = 1000
OllamaChat.Crowd.ReplyGapMaxMs = 4000

#    OllamaChat.Crowd.SlotTimeoutSeconds
#        A bot whose answer has not come back in this long is skipped.
#        Default: 30
OllamaChat.Crowd.SlotTimeoutSeconds = 30

#    OllamaChat.Crowd.MaxPlanSeconds
#        A crowd still going after this long is dropped.
#        Default: 120
OllamaChat.Crowd.MaxPlanSeconds = 120

#    OllamaChat.Crowd.MaxReplyBacks
#        Answers-back between bots inside one crowd (0-6). Chances follow
#        Context.BotAddressedChance and BotConversation.ChanceDecayPct.
#        Default: 2
OllamaChat.Crowd.MaxReplyBacks = 2

#    OllamaChat.Crowd.BotLineSecondChance
#        When a bot's ambient line gets an answer: the chance a second bot
#        joins in (where at least four bots can hear it).
#        Default: 25
OllamaChat.Crowd.BotLineSecondChance = 25

#    OllamaChat.Crowd.OpenCallPhrases
#        Words and phrases that make a line said to everyone, separated by |.
#        A trailing * matches any word starting with it. A shout (a line
#        mostly in capitals) counts as well.
OllamaChat.Crowd.OpenCallPhrases = "anyone|anybody|any1|ne1|anyone else|anybody else|everyone|everybody|every1|evry1|yall|you all|guys|people|ppl|peeps|folks|someone|somebody|sum1|who else|whos here|who is here|whos around|who is around|whos on|who is on|whos up|who wants|who needs|who can|hi all|hey all|hello all|hiya all|sup all|yo all|morning all|evening all|night all|hi chat|hey chat|hello chat|yo chat|dead chat|chat dead|so quiet|too quiet|quiet in here|talk to me|say something|lfg|lfm|lf1m|lf2m|lf3m|wts|wtb|wtt"

#    OllamaChat.Crowd.AckWords
#        A line made only of these words is an acknowledgement (see
#        AckReplyChance). Single words, separated by |; a trailing * matches
#        any word starting with it.
OllamaChat.Crowd.AckWords = "ty|thx|thnx|thanks|thank|tyvm|tysm|you|u|all|ok|okay|okey|k|kk|np|yw|lol*|lool*|lmao*|lmfao*|rofl*|haha*|hehe*|xd*|gg|wp|brb|afk|bbl|bye|cya|nice|cool|yes|yeah|ya|yep|yup|no|nah|nope|ah|oh|hmm*|same|true|rip|oof|gz|grats|gratz|grz|man|mate|bro|dude|guys|everyone|everybody|yall|folks|cheers|ta|tyty|m8|lads|lad|appreciate*|appreciated"

#    OllamaChat.Crowd.PlayfulPersonalities
#        Personality keys that count as playful when a crowd mixes voices;
#        every other personality counts as straight. Separated by |.
OllamaChat.Crowd.PlayfulPersonalities = "NAT_JOKER|NAT_TROLL|NAT_CONTRARIAN|NAT_REACTOR|NAT_HYPE|NAT_BANTER|NAT_DEADPAN|NAT_EXCITABLE|NAT_GRUMBLER|NAT_PRANKSTER|NAT_GOSSIP|NAT_PVPER|NAT_BINGER|NAT_BUTTERFLY|NAT_KEYBOARD"

#    OllamaChat.Crowd.HintOpenCall
#    OllamaChat.Crowd.HintFollowUp
#    OllamaChat.Crowd.HintReplyBack
#    OllamaChat.Crowd.HintShout
#        Added to a crowd voice's prompt: the first answer to a line said to
#        everyone; any answer after someone else's; a bot answering another
#        bot that spoke to it; and, on top, when the line was shouted.
#        Placeholders: {player_name} (whoever said the line being answered),
#        {replied_to} (the same), {listeners} ("a few other players", "lots
#        of players"), {answered} (who already answered: "Lahu and Kael"),
#        {addressee} and {pass_token}.
OllamaChat.Crowd.HintOpenCall = "{player_name} said that to everyone here, and {listeners} can see the chat. Answer the way your own chat style would: a straight answer, a joke, a tease or a quick reaction are all fine."
OllamaChat.Crowd.HintFollowUp = "{answered} already answered {player_name} (see the chat above). Add your own line only if you have something different to say: your own answer, a joke, disagreeing with or teasing one of them, or just a laugh if it was funny. If you are answering one of them rather than {player_name}, use their name. Never repeat what was already said. If you have nothing to add, reply with just {pass_token}."
OllamaChat.Crowd.HintReplyBack = "{replied_to} said that to you. Answer them back if a real player would, short and in your own style; otherwise reply with just {pass_token}."
OllamaChat.Crowd.HintShout = "{player_name} typed it in capitals, like shouting; you can answer in capitals too if that suits you."

#    OllamaChat.Crowd.GreetingWords
#        A line made only of these words is a greeting to the room: "hello",
#        "hey there", "o/". It gets a few greetings back -- more in a city --
#        instead of the PlayerReplyChance roll a remark gets. "hey Brelac" is
#        still aimed at Brelac. Single words, separated by |; a trailing *
#        matches any word starting with it.
OllamaChat.Crowd.GreetingWords = "hi|hello|hey|heya|hiya|hai|helo|hallo|hullo|ello|yo|sup|wassup|wazzup|whatsup|howdy|greetings|o|morning|mornin|evening|afternoon|gm|hii*|heyy*|yoo*|helloo*|there|again"

#    OllamaChat.Crowd.FullCrowdInCities
#        In a city or an inn (see CITIES), a line said to nobody in particular
#        can be answered by up to all of the responders rather than half.
#        Default: 1
OllamaChat.Crowd.FullCrowdInCities = 1

###############################################################################
#
#   OLLAMA CHAT - CONVERSATIONS
#
#   A crowd answers one line and stops. A conversation keeps going: a few
#   bots chatting in General, Trade or /say for MinMinutes to MaxMinutes,
#   one line at a time, each typed after reading the chat so far. Others pipe
#   up now and then, people drift off, and when its time is up it winds down
#   the way people do -- a last word, a joke, "anyway gtg" -- rather than
#   stopping mid-sentence.
#
#   They start three ways: a real player says something to a channel and
#   gets a crowd of answers (FromPlayerChance); a bot's line gets answered by
#   another bot (FromBotLineChance); or, in a city, a bot brings up one of
#   the Premises (City.ConversationStartChance). You can join in at any
#   point -- your answers come first, and it carries on after them with a
#   second wind.
#
#   Needs Crowd.Enable = 1 and Context.Enable = 1. Turns are paced by the
#   conversation and still count toward RateLimit.ScopePerMinute and
#   RateLimit.GlobalPerMinute.
#
###############################################################################

#    OllamaChat.Conversation.Enable
#        Default: 1
OllamaChat.Conversation.Enable = 1

#    OllamaChat.Conversation.MinMinutes
#    OllamaChat.Conversation.MaxMinutes
#        How long a conversation runs before it winds down, rolled when it
#        starts. A real player joining in stretches it by a minute or few.
#        Default: 2, 15
OllamaChat.Conversation.MinMinutes = 2
OllamaChat.Conversation.MaxMinutes = 15

#    OllamaChat.Conversation.MinLines
#    OllamaChat.Conversation.MaxLines
#        ...or once the bots in it have said this many lines, rolled when it
#        starts, whichever comes first: chat between strangers in General is
#        a handful of lines, and left to run on it turns into one long
#        running joke. A real player joining in gives it a few more. MaxLines
#        0 leaves it to the time alone.
#        Default: 4, 10
OllamaChat.Conversation.MinLines = 4
OllamaChat.Conversation.MaxLines = 10

#    OllamaChat.Conversation.GapMinSeconds
#    OllamaChat.Conversation.GapMaxSeconds
#        Pause after a line appears before the next person starts typing.
#        It stretches by up to half again as the conversation gets older.
#        Generation and TypingSimulation come on top.
#        Default: 6, 25
OllamaChat.Conversation.GapMinSeconds = 6
OllamaChat.Conversation.GapMaxSeconds = 25

#    OllamaChat.Conversation.LullChance
#    OllamaChat.Conversation.LullMinSeconds
#    OllamaChat.Conversation.LullMaxSeconds
#        Now and then (LullChance %) the pause is a longer lull instead.
#        Default: 12, 30, 75
OllamaChat.Conversation.LullChance = 12
OllamaChat.Conversation.LullMinSeconds = 30
OllamaChat.Conversation.LullMaxSeconds = 75

#    OllamaChat.Conversation.MaxActive
#        Conversations running at once across the realm.
#        Default: 3
OllamaChat.Conversation.MaxActive = 3

#    OllamaChat.Conversation.MaxParticipants
#        Most bots in one conversation (2-10).
#        Default: 5
OllamaChat.Conversation.MaxParticipants = 5

#    OllamaChat.Conversation.JoinChance
#        Chance (0-100) that someone new pipes up instead of one of those
#        already talking.
#        Default: 15
OllamaChat.Conversation.JoinChance = 15

#    OllamaChat.Conversation.FromPlayerChance
#        A real player's line to a channel or /say that gets a crowd of
#        answers: chance the chat carries on as a conversation afterwards.
#        Lines aimed at one bot never start one. Multiplied by
#        City.ConversationBoost in a city.
#        Default: 40
OllamaChat.Conversation.FromPlayerChance = 40

#    OllamaChat.Conversation.FromBotLineChance
#        A bot's line that another bot answers: chance it turns into a
#        conversation. Multiplied by City.ConversationBoost in a city.
#        Default: 15
OllamaChat.Conversation.FromBotLineChance = 15

#    OllamaChat.Conversation.CooldownSeconds
#        After a conversation ends, bots do not start another in the same
#        channel or /say area for this long. A real player always can.
#        Default: 120
OllamaChat.Conversation.CooldownSeconds = 120

#    OllamaChat.Conversation.MaxMisses
#        Turns in a row that produce nothing (a bot passes, moved away, was
#        rate-limited) before the conversation is left to die out.
#        Default: 2
OllamaChat.Conversation.MaxMisses = 2

#    OllamaChat.Conversation.ObserveChance
#        In /say, the chance (0-100) a turn is told about a real player
#        nearby -- their mount, their pet, what they are doing -- so the bots
#        can remark on them.
#        Default: 30
OllamaChat.Conversation.ObserveChance = 30

#    OllamaChat.Conversation.AllowTrade
#    OllamaChat.Conversation.AllowSay
#        Where conversations may run besides General.
#        Default: 1, 1
OllamaChat.Conversation.AllowTrade = 1
OllamaChat.Conversation.AllowSay = 1

#    OllamaChat.Conversation.Premises
#        What a bot in a city brings up to open a conversation, separated by
#        |. Placeholders: {zone}, {faction}, {other_faction}, and any pool
#        below. A level tag in front -- "[80] ...", "[70+] ...", "[10-29] ..."
#        -- means only bots of those levels bring it up (Outlook.Enable = 1);
#        the tag is never shown to the model. No tag: any level. A side tag,
#        [horde] or [alliance], with a level tag or without, means only that
#        side's bots bring it up, whatever Outlook.Enable says: something
#        only one side does or knows -- where Mankrik's wife could be, what is
#        down the Deeprun Tram. One that has come up anywhere on the realm
#        waits PremiseCooldownMinutes before it can again.
OllamaChat.Conversation.Premises = "which class is the most overpowered right now|whether death knights ruined everything now that every other player is one|[70+] the best tank class for heroics|whether ret paladins need a nerf|[15+] the worst wipe you ever had in a dungeon|[15+] a ninja looter who rolled need on everything in a pug|[75+] Wintergrasp and who keeps winning it|the best profession for making gold|[60+] whether epic flying is worth the gold|the funniest hunter pet name you have seen|whether Arthas was always evil|whether Illidan was right all along|[80] the hardest boss in Naxxramas|[80] getting into Ulduar runs without much gear|whether achievements are worth chasing|[horde] where Mankrik's wife could be|[68+] the best place to level from 70 to 80|how expensive the auction house has got|guild drama|[75+] whether the Lich King fight will be any good|[15+] people who stand in fire|what you do on long flight paths|a name for a new alt|fishing: relaxing or the most boring thing in the game|[77+] the Argent Tournament dailies|whether Gnomish or Goblin Engineering is the better pick|[10+] whether {other_faction} is winning more battlegrounds lately|[80] a heroic you want a group for|[1-19] which starting zone is the best|[15-39] the first dungeon you ever ran|[20-59] the most annoying levelling zone|[58-69] how crowded Hellfire Peninsula gets"

#    OllamaChat.Conversation.PremiseTemplates
#    OllamaChat.Conversation.PremiseTemplateChance
#    OllamaChat.Conversation.PremiseCooldownMinutes
#    OllamaChat.Conversation.PremiseValueMemory
#    OllamaChat.Conversation.Pool.<name>
#        A fixed list goes stale: "would you rather fight one huge murloc or a
#        hundred tiny ones" was a delight the first time and a script by the
#        fourth. A template is an idea with slots, filled from a pool each
#        time -- "a silly would-you-rather question about {creature}" is about
#        murlocs once, yetis the next -- and PremiseTemplateChance % of
#        openers use one instead of Premises. A slot names a pool,
#        OllamaChat.Conversation.Pool.<name> (any name you like; a number on
#        the end, {class2}, is another pick from the same pool). Templates
#        and pool entries take level and side tags like Premises: a pool's
#        entries that are one side's own -- its cities, spots, starting
#        zones, quests, NPCs and mounts -- carry that side's tag, so "the best
#        spot in {city} to stand around in" is never Stormwind for a Horde
#        bot. Races are the same: Pool.race is each side's own races, so a
#        Horde bot talks of orcs and tauren, not gnomes and draenei; the other
#        side's come up only to be run down (Pool.enemy_race, the other
#        side's races for each). "{~this|that}" in a template is one of the
#        two, picked each time. A template with a slot
#        nothing can fill is skipped. No premise or template comes up again
#        across the realm within PremiseCooldownMinutes (when every one that
#        fits has, the one used longest ago does), and a pool's last
#        PremiseValueMemory picks are not picked again.
#        Some slots are filled from the game's own data instead of a pool, so
#        the model is handed something really in the game rather than left to
#        make one up ("a would-you-rather between two trinkets" got two that
#        do not exist):
#          {trinket}      a rare or epic trinket for about the bot's level
#          {itemset}      an armour set of rare or better pieces, likewise
#          {rare}         a rare spawn the world really spawns, likewise
#          {bosses}       after a {dungeon} or {raid}: " (its bosses: A, B and
#                         C)", from the game's own encounter list
#          {class_races}  after a {class}: the races of the bot's side that
#                         can be one (a template with it is skipped when
#                         only one race of its side can)
#        A pool of the same name is not used for these.
#        Default: "", 70, 120, 8, no pools
OllamaChat.Conversation.PremiseTemplates = "a silly would-you-rather question about {creature}|a would-you-rather between {zone} and {zone2}|which of {class} and {class2} has it easier levelling|a hot take about {class}|what {race} are really like, going by the ones you have met|[10+] running down {enemy_race}, who are on the other side|the worst thing about {profession}|whether {profession} is worth levelling at all|[15+] the best and worst bits of {dungeon}{bosses}|a daft question about {creature} that nobody ever asks|what {lore} is really up to these days|whether {lore} is any good as a leader|a rumour about {lore} that you are obviously making up for a laugh|whether {lore} or {lore2} would win in a fight|the most pointless thing about {city}|the best spot in {city} to stand around in|a name for {beast} as a hunter pet|whether {beast} or {beast2} makes the better hunter pet|whether {mount} or {mount2} looks daftest|[20+] whether {mount} is worth the gold|a guess at how many {creature} you have killed in total|whether {creature} are overrated or underrated as enemies|something you would change about {zone} if you could|the quickest way through {zone}|[10+] whether {other_faction} players are any good at {activity}|{activity}: fun or a chore|the most embarrassing way to die to {creature}|what {creature} would say if they could talk|which race on your side makes the best {class}, and which the worst (on your side, only {class_races} can be one)|the best thing to do in {zone} when you are bored|what you would do with a million gold|[30+] the toughest boss in {dungeon}{bosses}|a would-you-rather between {trinket} and {trinket2}|whether {itemset} or {itemset2} looks better|whether {rare} is worth hunting down"
OllamaChat.Conversation.PremiseTemplateChance = 70
OllamaChat.Conversation.PremiseCooldownMinutes = 120
OllamaChat.Conversation.PremiseValueMemory = 8
OllamaChat.Conversation.Pool.creature = "murlocs|kobolds|gnolls|harpies|raptors|spiders|ogres|forest trolls|quillboar|centaurs|furbolgs|satyrs|naga|wolves|bears|boars|crocolisks|gorillas|crabs|yetis|owlbeasts|basilisks|troggs|the Defias|ghouls|elementals|giants|imps|scorpids|silithid|dragonkin|turtles|bats|zombies|[55+] fel orcs|[55+] demons|[60+] arakkoa|[62+] ethereals|[65+] nerubians|[68+] vrykul|[68+] wolvar|[70+] gorlocs|[68+] magnataurs|[72+] proto-drakes|[70+] the Scourge"
