# --------------------------------------------
# RAG (Retrieval-Augmented Generation) SYSTEM
# --------------------------------------------

# OllamaChat.EnableRAG
#     Description: Enable or disable the RAG (Retrieval-Augmented Generation) feature.
#                  When enabled, the bot will analyze player messages and retrieve relevant information
#                  from JSON knowledge base files to provide more accurate and detailed responses.
#     Default:     0 (false)
OllamaChat.EnableRAG = 0



# OllamaChat.RAGDataPath
#     Description: Path to the directory containing RAG JSON data files.
#                  This should be a relative path from the server's working directory.
#                  For AzerothCore installations, this is typically ../../../modules/mod-ollama-chat/data/rag/
#                  The system will load all .json files from this directory.
#     Default:     ../../../modules/mod-ollama-chat/data/rag/
OllamaChat.RAGDataPath = ../../../modules/mod-ollama-chat/data/rag/



# OllamaChat.RAGMaxRetrievedItems
#     Description: Maximum number of relevant information items to retrieve and include in the prompt.
#                  Higher values provide more context but may exceed token limits.
#     Default:     3
OllamaChat.RAGMaxRetrievedItems = 3



# OllamaChat.RAGSimilarityThreshold
#     Description: Minimum similarity score (0.0-1.0) required for information to be considered relevant.
#                  Lower values will include more information but may be less accurate.
#                  Higher values will be more precise but may miss relevant information.
#                  Recommended range: 0.2-0.4 for good balance of relevance and coverage.
#     Default:     0.3
OllamaChat.RAGSimilarityThreshold = 0.3



# OllamaChat.RAGPromptTemplate
#     Description: Template for including RAG information in bot prompts.
#     Placeholders (named): {rag_info}
OllamaChat.RAGPromptTemplate = "RELEVANT INFORMATION:\n{rag_info}\nUse this information to provide accurate and detailed responses when applicable."
###############################################################################
#
#   OLLAMA CHAT - THINK MODE
#
###############################################################################

#    OllamaChat.ThinkMode
#        auto / on / off.
#
#        auto (default) is capability-gated AND task-gated. On startup the
#        module asks Ollama what the configured model can do (POST /api/show,
#        falling back to a live one-token probe on older Ollama). It only ever
#        sends "think" to a model that reports the capability, so a model that
#        cannot think is never asked to -- that request used to come back as
#        HTTP 400 and silence every bot on the server with nothing useful in
#        the log.
#
#        Under auto, reasoning is spent only where it changes the answer:
#            chat replies / random chatter / event chatter -> off
#              (short, latency-sensitive, nothing to reason about)
#            sentiment analysis                            -> on
#              (a judgement call, and never shown to players)
#            roleplay replies at Strictness 2              -> on
#
#        on  = always think, when the model supports it.
#        off = never think.
#
#        Everything below is detected at runtime and applied on the fly. You do
#        not need to restart, or reconfigure, after swapping models:
#
#          * A request rejected for asking to think -> think is switched off
#            for that model, logged once, and the request is retried without it.
#
#          * "think": false is a request, not a guarantee. gpt-oss and other
#            harmony-format builds reason regardless, and Ollama charges those
#            tokens to num_predict -- so a low cap is spent reasoning and the
#            reply comes back empty. The module recognises that shape (HTTP 200,
#            reasoning present, answer empty) and from then on:
#                - sends "think": "low" instead of false for this model, which
#                  is the closest to off such a model offers, and
#                - adds ReasoningTokenReserve to num_predict.
#            The request that triggered the detection is retried, so at most
#            one reply is lost while the module works this out.
#
#          * If Ollama refuses the string level, the module falls back to the
#            boolean form permanently for that model and logs it once.
#
#        ".ollama status chat" reports whatever has been detected so far.
#
#        Other providers (OllamaChat.Provider = openai / anthropic): there is
#        no capability endpoint to ask and a live probe would be a billed
#        request, so nothing is probed. Under auto, reasoning is not requested
#        at all. Under on, it is requested on every call -- as
#        "reasoning_effort" for openai, as an extended-thinking budget of
#        max(1024, ReasoningTokenReserve) tokens for anthropic -- and switched
#        off for the session if the provider rejects it. Reasoning models on
#        those services reason whether asked or not; the setting only tunes
#        them.
#        Default: auto
OllamaChat.ThinkMode = "auto"

#    OllamaChat.ThinkModeEnableForModule
#        DEPRECATED. Kept so old configs keep working: when this is 1 and
#        ThinkMode is left at "auto", think mode is forced on.
#        Prefer OllamaChat.ThinkMode.
#        Default: 0
OllamaChat.ThinkModeEnableForModule = 0

#    OllamaChat.ThinkMaxLatencyMs
#        Latency guard for auto mode. If think-enabled requests average slower
#        than this, think is disabled for the rest of the session and the
#        reason is logged. A server that swaps to a slow model degrades to fast
#        replies instead of to a dead chat channel. 0 disables the guard.
#        Default: 12000
OllamaChat.ThinkMaxLatencyMs = 12000

#    OllamaChat.CapabilityProbeTimeoutSeconds
#        Timeout for the startup capability probe only. Kept short so a missing
#        Ollama does not leave the module undecided for two minutes.
#        Default: 10
OllamaChat.CapabilityProbeTimeoutSeconds = 10

###############################################################################
#
#   OLLAMA CHAT - DISPATCHER AND HTTP
#
###############################################################################

#    OllamaChat.WorkerThreads
#        Size of the pool that performs LLM calls. This replaces the old
#        behaviour of spawning one detached thread per bot per message, which
#        was unbounded. Workers do HTTP and string work only; every reply is
#        delivered on the world thread.
#        Defaults to MaxConcurrentQueries when that is set, otherwise 4.
OllamaChat.WorkerThreads = 4

#    OllamaChat.MaxQueueDepth
#        Requests waiting for a worker. Beyond this, new requests are dropped
#        rather than queued, so a slow Ollama sheds load instead of building an
#        ever-growing backlog of stale replies. 0 = unlimited (not advised).
#        Default: 64
OllamaChat.MaxQueueDepth = 64

#    OllamaChat.HttpTimeoutSeconds
#        Connection/read/write timeout for LLM calls.
#        Default: 120
OllamaChat.HttpTimeoutSeconds = 120

#    OllamaChat.RateLimitRetries
#        How many times to retry one request after the provider answers
#        HTTP 429 (rate limited), 503 (busy) or 529 (Anthropic overloaded).
#        The wait between attempts honours the provider's Retry-After header,
#        or doubles from 2 seconds when there is none. The worker thread
#        sleeps for it, so a throttled provider slows replies down rather
#        than dropping them; the queue cap sheds load if it gets worse.
#        0 disables retries. Mostly relevant for hosted providers.
#        Default: 2
OllamaChat.RateLimitRetries = 2

#    OllamaChat.RateLimitMaxWaitSeconds
#        Upper bound on any single back-off wait, whatever Retry-After says.
#        A chat reply that arrives a minute late is worse than no reply.
#        Default: 15
OllamaChat.RateLimitMaxWaitSeconds = 15

#    OllamaChat.TypingSimulationMaxDelay
#        Ceiling on the simulated typing delay, in milliseconds. Without a cap
#        a long reply could be held back for a very long time.
#        Default: 8000
OllamaChat.TypingSimulationMaxDelay = 8000

###############################################################################
#
#   OLLAMA CHAT - RESPONSE CLEANUP
#
###############################################################################

#    OllamaChat.MaxReplyLength
#        Maximum reply length in bytes. WoW chat is limited to 255; the reply
#        is cut at the last sentence end if one is near, otherwise at a word
#        boundary, never mid-word and never mid-UTF-8-sequence.
#        Default: 240
OllamaChat.MaxReplyLength = 240

#    OllamaChat.StripMarkdown
#        Remove markdown emphasis, bullets, headings and code fences from
#        replies. Models emit these regardless of what the prompt asks for.
#        Default: 1
OllamaChat.StripMarkdown = 1

#    OllamaChat.StripDecorativeUnicode
#        Fold smart quotes and dashes to ASCII, then drop emoji and symbols the
#        3.3.5 client renders as boxes. Accented Latin characters are kept.
#        Default: 1
OllamaChat.StripDecorativeUnicode = 1

#    OllamaChat.Response.AssistantPhrases
#        Sentences containing any of these are cut from a reply ("Greetings.
#        How can I help you?" -> "Greetings."), and a reply that is nothing
#        else is dropped: players do not talk like a help desk. Phrases
#        separated by |, matched on whole words. Empty disables.
OllamaChat.Response.AssistantPhrases = "how can i help|how may i help|how can i assist|how may i assist|how can i be of|what can i do for you|what can i help you with|anything i can help you with|anything i can do for you|need help with something|need help with anything|let me know if you need anything|happy to help|glad to help|here to help|at your service|is there anything else|what brings you"

#    OllamaChat.Response.OverusedPhrases
#    OllamaChat.Response.OverusedCooldownSeconds
#        Every model has favourite lines. Once any bot has said one of these,
#        no bot says it again anywhere on the realm for the cooldown: a line
#        that would is dropped. Lines owed to someone who spoke to the bot
#        directly are exempt, so a question always gets its answer, and so is
#        a phrase the line being answered used itself. Phrases separated by
#        |, matched on whole words. Empty, or a cooldown of 0, disables.
#        Default: (below), 1200 (20 minutes)
OllamaChat.Response.OverusedPhrases = "taking forever|takes forever|take forever|took forever|so slow|too slow|such a grind|what a grind|so boring|so bored|im bored|getting bored|repair bill|repair bills|nothing to do"
OllamaChat.Response.OverusedCooldownSeconds = 1200

#    OllamaChat.Response.OffEraPhrases
#        Things that do not exist in Wrath of the Lich King. A line with one
#        of these is never said, unless it is answering a line that used the
#        same words ("can you transmog?" -> "no transmog in wrath lol").
#        Matched like the lists above, punctuation ignored, so "mythic+"
#        counts as "mythic". Empty disables.
OllamaChat.Response.OffEraPhrases = "mythic|keystone|transmog*|xmog|world quest|world quests|dragonriding|dragonflying|skyriding|timewalking|torghast|azerite|shadowlands|dragonflight|pandaria|warlords of draenor|battle for azeroth|war within|my garrison|class hall|artifact weapon|covenant ability"

#    OllamaChat.Response.FourthWallPhrases
#    OllamaChat.Response.FourthWallAllow
#    OllamaChat.Response.FourthWallMinutes
#        The fourth wall. As far as any bot knows, everyone on the realm is a
#        player like itself, so a bot does not talk about bots, AI or "real
#        players": a line with one of FourthWallPhrases is never said (one
#        owed to someone gets another go without it: RetryOwed). It is a rule
#        that can be broken, but only when a perfect opportunity appears: a
#        real player bringing it up ("are you a bot?") -- another bot raising
#        it is no opening -- and then only the first answer gets to wink at
#        it; no other bot does for FourthWallMinutes. FourthWallAllow are
#        names that only look like it and are fine anywhere: an engineer's
#        Field Repair Bot, a Clockwork Rocket Bot, Mimiron's bomb bots.
#        Matched like the lists above, on whole words, so "bot" is not
#        "bottle". An empty FourthWallPhrases disables.
#        Default: (below), (below), 10
OllamaChat.Response.FourthWallPhrases = "bot|bots|botting|botter|botters|botted|playerbot|playerbots|ai|chatbot|chatbots|chatgpt|llm|language model|artificial intelligence|programmed|my programming|real player|real players|real person|real people|actual player|actual players|actual person|actual people|fake player|fake players"
OllamaChat.Response.FourthWallAllow = "repair bot|repair bots|rocket bot|rocket bots|bomb bot|bomb bots|assault bot|assault bots|junk bot|junk bots|fire bot|fire bots|scrap bot|scrap bots|boom bot|boom bots"
OllamaChat.Response.FourthWallMinutes = 10

#    OllamaChat.Response.RarePhrases
#    OllamaChat.Response.RareCooldownSeconds
#        A chat style's hobby horse, or a joke everyone has heard: once any bot
#        has said one of these, no bot says it again anywhere on the realm for
#        the cooldown -- even in a line owed to someone, which OverusedPhrases
#        lets through (that line gets another go without it: RetryOwed).
#        Otherwise a nostalgic bot answers everything, "respawn" included,
#        with the same memory of 40-man raids, and every bit of banter is a
#        "your nan" joke. A phrase the line being answered used itself is
#        still fine: "ur mum" gets one back. Phrases separated by |, matched
#        on whole words. Empty, or a cooldown of 0, disables.
#        Default: (below), 3600 (an hour)
OllamaChat.Response.RarePhrases = "40 man|40man|forty man|40 mans|old school|back in vanilla|back in the day|the old days|old days|good old days|vanilla days|miss vanilla|miss the old|used to be better|way more epic back|ur nan|your nan|ur nans|your nans|ur mum|your mum|ur mums|your mums|ur mom|your mom|ur ma|yo mama|yo momma|ur sister|your sister|ur gran|your gran|ur granny|your granny|ur dad|your dad"
OllamaChat.Response.RareCooldownSeconds = 3600

#    OllamaChat.Response.RetryOwed
#    OllamaChat.Response.RetryNote
#        A line owed to someone -- they spoke to the bot -- that comes back with
#        one of the phrases above, or an echo (Echo.* below), is not just
#        dropped, which would leave them with no answer: the bot is asked once
#        more, with RetryNote ({phrase}: what to leave out) added. Never a
#        third time.
#        Default: 1, (below)
OllamaChat.Response.RetryOwed = 1
OllamaChat.Response.RetryNote = "Say it a different way this time, without '{phrase}'."

#    OllamaChat.Response.QuoteSourceStyles
#    OllamaChat.Response.QuoteSources
#    OllamaChat.Response.QuoteFilmWords
#        Nobody quoting a film in chat says which film: "to infinity and beyond.
#        toy story." gives the joke away. A style that quotes films is told not
#        to, and a small model does it anyway, so for the styles in
#        QuoteSourceStyles (| separated) a film, show or character from
#        QuoteSources named at the end of a line, after the line itself, is cut
#        off: ". lotr", " - Toy Story", " (The Godfather, 1972)", ", from
#        Shrek", " #avengers". "The" in front, a year after or a "lol" do not
#        stop it. It is kept when less than two words would be left, and when
#        the line, or the line it answers, has any of QuoteFilmWords in it --
#        asked "what's your favourite film?", "easy. jaws" is the answer.
#        QuoteSources leaves out names that are everyday or Warcraft words
#        (Up, Cars, Elf, Frozen, Cheers, Friends, Scrubs, Gladiator, Minions,
#        Twilight, Endgame...): "brr so cold. frozen" stays as it is. Add to it
#        rather than replace it. Empty QuoteSourceStyles turns this off.
#        Default: NAT_BINGER, (below), (below)
OllamaChat.Response.QuoteSourceStyles = "NAT_BINGER"
