#    OllamaChat.Conversation.HintTurn
#    OllamaChat.Conversation.HintJoin
#    OllamaChat.Conversation.HintWindDown
#    OllamaChat.Conversation.HintObserve
#        Added to a conversation turn's prompt: an ordinary turn; someone new
#        joining; a turn once its time is up; and, in /say, a real player
#        passing by. Placeholders: {others} ("Lahu and Kael"), {where}
#        ("General chat"), {about} (" about <premise>" or nothing),
#        {premise}, {last_speaker}, {pass_token}; HintObserve:
#        {observation}.
OllamaChat.Conversation.HintTurn = "You are chatting in {where} with {others} (see the chat above){about}. Carry it on as yourself with one short line: answer the last line, disagree, joke, ask something back, or take it somewhere related. Never make a point someone has already made, not even in other words: if you agree, add something new to it (a reason, a story, a joke) instead of saying it again. Talk the way you always do, not the way they do: never pick up someone else's pet names or catchphrases. If the last few lines are all one running joke, leave it be and say something real instead. If you really have nothing to add, reply with just {pass_token}."
OllamaChat.Conversation.HintJoin = "You have been reading the chat above in {where}{about}, and now you jump in with your own take, a joke or a question. One short line."
OllamaChat.Conversation.HintWindDown = "This chat has been going on for a while and is winding down. Give your last word on it the way players do: a final opinion, a joke, or something like anyway, gtg, back to farming or cya. Do not start anything new."
OllamaChat.Conversation.HintObserve = "Right now {observation}. You can mention that if it fits."

#    OllamaChat.Conversation.HintStartChannel
#    OllamaChat.Conversation.HintStartSay
#        The opening line of a conversation a bot starts on purpose, in a
#        channel and in /say. Placeholders: {premise}, {where},
#        {partner} (/say: the bot it turns to).
OllamaChat.Conversation.HintStartChannel = "You feel like starting a chat in {where} about {premise}. Bring it up the way a player would: an opinion, a question to everyone or a complaint."
OllamaChat.Conversation.HintStartSay = "{partner} is standing right next to you. Start a chat with them about {premise}, the way a player would: an opinion or a question. You can use their name."

###############################################################################
#
#   OLLAMA CHAT - CITIES
#
#   People come to a city to talk. In a capital city (the game's own
#   "resting in a city" state), in the zones or areas listed below, and --
#   with IncludeInns -- in an inn, bots chat more often, answer each other
#   more, start conversations, and more of them answer a real player.
#
###############################################################################

#    OllamaChat.City.Enable
#        Default: 1
OllamaChat.City.Enable = 1

#    OllamaChat.City.ExtraZoneOrAreaIds
#        Zone or area ids that count as a city besides the faction capitals,
#        separated by |. 3703 = Shattrath City, 4395 = Dalaran.
#        Default: "3703|4395"
OllamaChat.City.ExtraZoneOrAreaIds = "3703|4395"

#    OllamaChat.City.IncludeInns
#        Count an inn (the resting area) as a city.
#        Default: 1
OllamaChat.City.IncludeInns = 1

#    OllamaChat.City.ChatterMultiplier
#        RandomChatterBotCommentChance is multiplied by this in a city.
#        Default: 3
OllamaChat.City.ChatterMultiplier = 3

#    OllamaChat.City.ConversationStartChance
#        Chance (0-100) that a city bot's ambient line opens a conversation
#        about one of the Conversation.Premises instead of a remark.
#        Default: 35
OllamaChat.City.ConversationStartChance = 35

#    OllamaChat.City.BotLineReplyBonus
#        Added to Context.BotLineReplyChance.* for a bot's line in a city.
#        Default: 20
OllamaChat.City.BotLineReplyBonus = 20

#    OllamaChat.City.ConversationBoost
#        Conversation.FromPlayerChance and FromBotLineChance are multiplied by
#        this in a city.
#        Default: 2
OllamaChat.City.ConversationBoost = 2

###############################################################################
#
#   OLLAMA CHAT - CITY HANGOUTS
#
#   mod-playerbots-plus parks idle bots where players stand about in the
#   capitals -- the Trade District, the Commons, outside the bank in Dalaran
#   -- mounted, sat on a bench, or AFK (PlayerbotsPlus.Hangout.* in its
#   conf). Here, a bot hanging out knows where it is and what it is doing
#   when someone asks (StateText). An AFK one says nothing and reacts to
#   nothing until someone talks to it -- a whisper, a line that names it --
#   and then it is back, and knows it had stepped away (AwayText). Without
#   mod-playerbots-plus nobody hangs out.
#
###############################################################################

#    OllamaChat.Hangout.StateText
#    OllamaChat.Hangout.AwayText
#        Added to the reply prompt of a bot that is hanging out ({spot}: the
#        spot's name; {doing}: "sitting on a bench", "sat on your mount",
#        "sitting on the ground", "standing about"), and, when it was AFK,
#        that it has just come back.
OllamaChat.Hangout.StateText = "Right now you are hanging around {spot}, {doing}, with nowhere in particular to be."
OllamaChat.Hangout.AwayText = "You had stepped away from your keyboard there (AFK) and have only just come back to it."

###############################################################################
#
#   OLLAMA CHAT - A BOT'S OWN PETS (AND MOUNT)
#
#   A hunter's pet has a name -- mod-playerbots-plus gives random bots' pets
#   the kind players give theirs -- and a bot may have a companion pet
#   trotting along (PlayerbotsPlus.Pets.* and Companions.* in its conf).
#   "cute cat!", "whats your wolf called?", "is that a snake following
#   you?", "nice mount": the bot asked knows what its pet is and what it is
#   called, what is following it, and whether it is riding anything at all.
#   Only when it was spoken to and the line is about them -- Words,
#   MountWords, or the name or kind of one of them: a pet in every prompt is
#   what a bot would end up talking about. Bots chatting among themselves
#   (Mingle) already see each other's mounts, pets and companions.
#
#   Every prompt that tells a bot about someone names each of these as what
#   it is: "riding their mount, a Swift Brown Horse", "with their hunter pet,
#   a wolf called Howler", "with their demon, an imp called Zigzag", "with
#   their companion pet, a Mechanical Squirrel, following them". Told only
#   "with their Wolf Howler" next to talk of a mount, a bot took a hunter's
#   wolf for one.
#
###############################################################################

#    OllamaChat.Pets.StateText
#        Added to the reply prompt. {pets}: "your mount, a Swift Brown Horse,
#        which you are riding; your hunter pet, a cat called Aslan; your
#        companion pet, a Mechanical Squirrel, following you" -- and, when the
#        talk is of mounts and it is riding none, "no mount out: you are on
#        foot". Empty disables.
#        Default: (below)
OllamaChat.Pets.StateText = "What you have with you right now: {pets}. If the talk is about them, you know what each one is and what it is called, and talk about them the way players do about their own: a mount is what you ride, and a hunter's pet, a demon or a companion pet is no mount."

#    OllamaChat.Pets.Words
#        Words that make a line about pets, besides the pet's and the
#        companion's own names and kinds. Phrases separated by |, matched on
#        whole words.
#        Default: (below)
OllamaChat.Pets.Words = "pet|pets|companion|companions|critter|critters|minion|minions|demon|demons|tame|tamed|taming|following you|following u|follows you|follow you around"

#    OllamaChat.Pets.MountWords
#        Words that make a line about mounts, besides the name of the one it is
#        riding. Then it also knows when it is riding nothing: "nice mount" to
#        a bot on foot is a mix-up it can point out, not a thank-you. Phrases
#        separated by |, matched on whole words.
#        Default: (below)
OllamaChat.Pets.MountWords = "mount|mounts|mounted|ride|rides|riding|horse|horses|steed|steeds|kodo|kodos|raptor|raptors|mechanostrider|ram|rams|elekk|hawkstrider|nightsaber|frostsaber|charger|warhorse|felsteed|dreadsteed|deathcharger|mammoth|drake|proto drake|gryphon|wyvern|flying mount|epic mount"

###############################################################################
#
#   OLLAMA CHAT - WHAT A BOT HAS BEEN UP TO
#
#   "what you up to?" -- "nothing much just finished some grinds" is a bot
#   with nothing to go on making something up. Players say what they did and
#   where: grinding murlocs in Westfall, a quest in Duskwood, a ding. So each
#   bot's last while is kept: the run of kills it was on (the zone, what it
#   killed and how many), the last quest it handed in and where, and the last
#   level it reached. Bots chatting among themselves (MINGLING) are told it,
#   and a bot asked what it has been up to (Words) knows it.
#
###############################################################################

#    OllamaChat.Lately.Enable
#    OllamaChat.Lately.Minutes
#        How far back counts as lately.
#        Default: 1, 45
OllamaChat.Lately.Enable = 1
OllamaChat.Lately.Minutes = 45

#    OllamaChat.Lately.StateText
#    OllamaChat.Lately.Words
#        Added to the reply prompt when the line it answers asks what it has
#        been up to (Words: phrases separated by |, matched on whole words)
#        and there is something from the last Minutes. {lately}: "out in
#        Westfall for about 25 minutes killing Murloc Coastrunner (12) and
#        Murloc Tidehunter (5), until a few minutes ago". Empty StateText
#        leaves it out.
#        Default: (below)
OllamaChat.Lately.StateText = "What you have been doing lately: {lately}. If that is what they ask about, say it the way a player would, in a few words of your own: what and where."
OllamaChat.Lately.Words = "up to|what you doing|what u doing|what are you doing|what r u doing|wyd|whats up|sup|wassup|hows it going|how is it going|how you doing|how u doing|how are you|how r u|where you been|where have you been|been doing|you busy|u busy|any luck|hows the grind|how was it|how did it go|howd it go"

###############################################################################
#
#   OLLAMA CHAT - PRESENCE
#
#   Bots noticing the real players around them. A bot walking past a real
#   player now and then does what its personality would (see EMOTE STYLES):
#   a friendly one waves, a pet lover pets their cat, a prankster tickles
#   them and keeps walking. Sometimes it says something about them in /say
#   too -- their mount, their pet, what they are up to.
#
#   Never in instances or in combat, never the player's own party, and not
#   the bots of a group they have just left (ExGroupMinutes): leaving a group
#   used to get a rude gesture from it on the way out. Nothing in SkipEmotes
#   either, at a stranger -- with the line or without.
#   Needs EnableBotEmotes = 1.
#
###############################################################################

#    OllamaChat.Presence.Enable
#        Default: 1
OllamaChat.Presence.Enable = 1

#    OllamaChat.Presence.Range
#        How close a bot has to pass, in yards.
#        Default: 10
OllamaChat.Presence.Range = 10

#    OllamaChat.Presence.PlayerIntervalMinSeconds
#    OllamaChat.Presence.PlayerIntervalMaxSeconds
#        At most one such moment per real player in this many seconds: a
#        bot waving at you every minute is not what strangers do.
#        Default: 240, 720
OllamaChat.Presence.PlayerIntervalMinSeconds = 240
OllamaChat.Presence.PlayerIntervalMaxSeconds = 720

#    OllamaChat.Presence.BotCooldownSeconds
#    OllamaChat.Presence.PairCooldownSeconds
#        How long before the same bot does it again to anyone, and to the
#        same player.
#        Default: 900, 3600
OllamaChat.Presence.BotCooldownSeconds = 900
OllamaChat.Presence.PairCooldownSeconds = 3600

#    OllamaChat.Presence.Chance
#        When a moment comes round and a bot is passing: the chance (0-100)
#        it does anything at all.
#        Default: 60
OllamaChat.Presence.Chance = 60

#    OllamaChat.Presence.SayChance
#        ...and the chance it also says something in /say.
#        Default: 35
OllamaChat.Presence.SayChance = 35

#    OllamaChat.Presence.CityOnly
#        Only in cities and inns.
#        Default: 0
OllamaChat.Presence.CityOnly = 0

#    OllamaChat.Presence.ExGroupMinutes
#        Bots that were in a group with a real player leave them be for this
#        long after they part: they are not strangers walking past. 0 turns
#        it off.
#        Default: 15
OllamaChat.Presence.ExGroupMinutes = 15

#    OllamaChat.Presence.SkipEmotes
#        Emotes a bot never makes at a passing stranger, whatever its style
#        (another of its style's emotes instead), nor along with what it says
#        to one. Emote names as in EMOTE STYLES, separated by |.
#        Default: (below)
OllamaChat.Presence.SkipEmotes = "rude|spit|threaten|insult|mock|taunt|chicken|rasp|fart|burp|belch|scoff|shakefist|crack|gloat|bored|yawn|glare|scowl|snarl|growl|pinch|slap"

#    OllamaChat.Presence.PromptTemplate
#        Placeholders: {bot_name} {bot_level} {bot_race} {bot_class}
#        {bot_personality} {bot_personality_name} {player_name}
#        {observation} ("Kami, a level 23 Human Warrior, riding their
#        mount, a Brown Horse, their [Gnarled Staff] (white staff) catching
#        the eye": what they are doing, the mount, pet or companion they
#        have with them, and the one piece of what they wear a passer-by
#        notices first) {pass_token}. A remark that talks of a mount to
#        someone on foot, or of a pet to someone with none out
#        (Pets.MountWords, Pets.Words), is not said.
OllamaChat.Presence.PromptTemplate = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}. Your chat style: {bot_personality} You are walking past {player_name}: {observation}. Say one short thing to them about something in that, the way a passing player might in /say: a compliment, a joke, a tease or a quick question, 2 to 10 words, and never about anything it does not mention. Do not start with their name, and do not describe what you are doing."

###############################################################################
#
#   OLLAMA CHAT - EMOTE STYLES
#
#   The emotes each personality reaches for: what it does walking past a
#   real player (PRESENCE), and two of the four examples a chat prompt
#   offers when GestureChance invites a gesture. A name repeated is picked
#   more often. A personality without a line here uses Default.
#
#   OllamaChat.Emote.Style.<KEY> for any personality key in the
#   mod_ollama_chat_personality_templates table.
#
###############################################################################

OllamaChat.Emote.Style.Default = "wave|wave|nod|smile|cheer|bow|thank|laugh|hello"
OllamaChat.Emote.Style.NAT_TERSE_VET = "nod|shrug|sigh|salute"
OllamaChat.Emote.Style.NAT_LOWERCASE = "wave|nod|shrug|laugh|dance"
OllamaChat.Emote.Style.NAT_FRIENDLY = "wave|wave|smile|hello|hug|cheer|thank|bow"
OllamaChat.Emote.Style.NAT_PROPER = "bow|bow|salute|greet|curtsey|nod|thank"
OllamaChat.Emote.Style.NAT_DEADPAN = "stare|shrug|blink|eyebrow|golfclap|sigh"
OllamaChat.Emote.Style.NAT_NEWBIE = "wave|confused|curious|thank|bow|cheer"
OllamaChat.Emote.Style.NAT_MINMAXER = "point|nod|facepalm|ponder|ready|flex"
OllamaChat.Emote.Style.NAT_GRUMBLER = "sigh|sigh|groan|scowl|eyeroll|shakefist|mutter"
OllamaChat.Emote.Style.NAT_SOCIAL = "wave|wave|hug|smile|cheer|dance|highfive|toast"
OllamaChat.Emote.Style.NAT_ABBREVIATOR = "wave|nod|laugh|shrug|ready"
OllamaChat.Emote.Style.NAT_QUIET = "nod|nod|wave|smile|shy"
OllamaChat.Emote.Style.NAT_NONNATIVE = "wave|smile|bow|nod|thank|confused"
OllamaChat.Emote.Style.NAT_HELPFUL_VET = "nod|point|wave|salute|ready"
OllamaChat.Emote.Style.NAT_EXCITABLE = "cheer|cheer|bounce|dance|wave|clap|giggle|hug"
OllamaChat.Emote.Style.NAT_BANTER = "wink|grin|smirk|tease|poke|laugh|chuckle"
OllamaChat.Emote.Style.NAT_JOKER = "giggle|cackle|laugh|chicken|joke|tickle|moo|wink"
OllamaChat.Emote.Style.NAT_TROLL = "rasp|rasp|chicken|rude|mock|smirk|fart|pinch"
