#    OllamaChat.Emote.PetEmotes
#        Emotes aimed at a player's pet or companion when they have one
#        nearby; without a pet these are never picked for a passer-by.
OllamaChat.Emote.PetEmotes = "pet|pat|cuddle|love|purr|hug"

###############################################################################
#
#   OLLAMA CHAT - PER STYLE NUDGES AND LONGER REPLIES
#
#   Two more settings any personality key can have, the same way as its
#   emote style above:
#
#   OllamaChat.Personality.Nudge.<KEY>
#       An extra instruction on a share of that style's lines, so a style
#       that should do something some of the time -- not every time -- does.
#       A personality prompt alone ("now and then quote a film") tends to
#       get all or nothing from a small model; this rolls for each line.
#       "<percent>|<instruction>", or "<percent>|<instruction>|<otherwise>"
#       for something different on the rest. "{~this|that}" in either is
#       one or the other, picked each time (its bars do not split the
#       setting), so the nudge itself does not say the same thing every
#       time. Its replies to someone and its own chatter both roll for it.
#       On the share that gets the instruction, the bot is also shown what
#       it said lately (SaidLatelyNote below), so it does not bring the
#       same thing round again.
#
#   OllamaChat.Personality.MaxReplyLength.<KEY>
#       A longer reply limit for that style, in characters, instead of
#       MaxReplyLength, for its replies to someone, and the style is told it
#       may write more (LongReplyNote below). It only ever lengthens: at or
#       below MaxReplyLength it does nothing. 250 is about the most one chat
#       line holds, and the most allowed.
#
###############################################################################

#    OllamaChat.Personality.LongReplyNote
#        What a style with its own MaxReplyLength is told on each reply.
#        {words}: about how many words that length holds.
OllamaChat.Personality.LongReplyNote = "You can write more than most players do: when you explain how to do something, use two or three short sentences, up to about {words} words, clear and to the point. Still one chat line, no lists or headings."

#    OllamaChat.Personality.SaidLatelyNote
#        Added to a nudge's instruction, on the lines that get it, when the
#        bot has said anything lately: {lines} is its last few lines of more
#        than three words (from Repetition.WindowSeconds), newest first, each
#        in quotes. A binger told to quote a film, and not told what it had
#        quoted ten minutes before, quoted it again. Empty: never shown.
#        Default: "Lately you have said: {lines}. Nothing like any of those again."
OllamaChat.Personality.SaidLatelyNote = "Lately you have said: {lines}. Nothing like any of those again."

#    OllamaChat.Personality.SaidLatelyLines
#        At most how many of its lines SaidLatelyNote shows (0 to 10).
#        Default: 5
OllamaChat.Personality.SaidLatelyLines = 5

#    OllamaChat.Personality.CannedStyles
#        Typed lines -- a "gz", a "ty all", a "hey", a wipe's "my bad", the
#        tank's "ok lets go" -- are written once for everyone, so a bot that
#        types in proper sentences and one that never uses a capital said them
#        the same way. Each personality listed here types them its own way,
#        as KEY:style separated by |:
#          proper   whole words, a capital and a full stop: "gz" ->
#                   "Congratulations.", "ty all" -> "Thank you all.",
#                   "ok lets go" -> "Okay let's go."
#          lower    lowercase, no full stop or exclamation mark at the end
#          flat     no exclamation marks and no full stop: "gz!" -> "gz"
#          short    shorthand, lowercase: "thanks all" -> "ty all",
#                   "congrats" -> "gz", "ok lets go" -> "k lets go"
#          excited  an exclamation mark at the end: "gz" -> "gz!"
#          caps     all capitals: "gz" -> "GZ"
#        A personality not listed says them as written. A name is never taken
#        for a word ("gz Ty" keeps Ty). Lines the model writes already follow
#        each personality's own prompt; these are only the typed ones. Empty:
#        every bot says them as written.
#        Default: "NAT_PROPER:proper|NAT_ROLEPLAYER:proper|NAT_HELPFUL_VET:proper|NAT_LOWERCASE:lower|NAT_CHILL:lower|NAT_TERSE_VET:flat|NAT_QUIET:flat|NAT_DEADPAN:flat|NAT_LONER:flat|NAT_GRUMBLER:flat|NAT_KEYBOARD:flat|NAT_ABBREVIATOR:short|NAT_MINMAXER:short|NAT_EXCITABLE:excited|NAT_HYPE:excited|NAT_BUTTERFLY:excited|NAT_NEWBIE:excited"
OllamaChat.Personality.CannedStyles = "NAT_PROPER:proper|NAT_ROLEPLAYER:proper|NAT_HELPFUL_VET:proper|NAT_LOWERCASE:lower|NAT_CHILL:lower|NAT_TERSE_VET:flat|NAT_QUIET:flat|NAT_DEADPAN:flat|NAT_LONER:flat|NAT_GRUMBLER:flat|NAT_KEYBOARD:flat|NAT_ABBREVIATOR:short|NAT_MINMAXER:short|NAT_EXCITABLE:excited|NAT_HYPE:excited|NAT_BUTTERFLY:excited|NAT_NEWBIE:excited"

# The film and TV binger works a famous line into about half of what it says --
# answers and its own chatter alike -- and only when one fits the moment; the
# rest of the time it talks like anyone else. Every line a quote got old fast
# and brought the same few round again. Where the line comes from is picked
# each time, so it is not the same few films, and it never says where a line is
# from: "to infinity and beyond. toy story." is not how anyone quotes a film --
# the ones who know it get it.
OllamaChat.Personality.Nudge.NAT_BINGER = "50|This time, if a famous funny line from {~a sci-fi film|a fantasy film|a comedy|an action film|a horror film|a cartoon|a sitcom|a British comedy|a crime drama|a superhero film|a war film|a kids' film|a musical|a cult classic|a quiz show|a soap} fits the moment, work it in -- bent to fit if need be, never more than a line of it, and not one of the lines everyone quotes. Never say what it is from or that it is a quote. If none fits, no quote: just say it like anyone would.|This time, no film or TV line: just say it like anyone would."

# The veteran who has played since launch explains things properly.
OllamaChat.Personality.MaxReplyLength.NAT_EXPERT = 250

###############################################################################
#
#   OLLAMA CHAT - PARTY INSTRUCTIONS (mod-dungeon-clear)
#
#   Inside a dungeon or raid, with a dungeon-clear tank bot in the group, a
#   real player's short party line steers the run the way it would steer a
#   group of people:
#
#       "ready", "r?", "lets go", "ok carry on"    start the clear, or resume
#       "mb", "need mana", "drink", "lets eat"     a rest: the tank carries on
#                                                  by itself once everyone has
#                                                  rested (Party.BreakEnd*)
#       "wait", "stop", "brb", "hold on"           pause it where it stands
#       "stay here", "hold position"               pause it too
#       "ok im done", "full", "done drinking"      resume -- only while paused
#
#   The tank answers in party ("np", "drink up"), and nobody else replies to
#   that line. A start waits until every real player in the group is inside
#   and within MaxDistance of the tank.
#
#   A ready check counts as a start ("r?", "everyone ready?", "are we
#   ready"); any other question does not ("you oom?", "wait what",
#   "anyone need mana"), and neither does a negation ("not ready", "i dont
#   need mana", "cant wait for this boss") or a not-yet ("almost ready",
#   "ready in 5"). A "no" up front is emphasis: "no wait" still pauses.
#   Lines starting "dc" are mod-dungeon-clear's own commands; bots leave
#   those alone.
#
#   These lines are looked at before BlacklistCommands and DisableForParty:
#   "ready" and "wait" stay on the blacklist for ordinary chat.
#
#   Dungeon clear needs a bot tank to lead. With a real player tanking there
#   is no run to steer: these lines are ordinary chat, the bots simply follow
#   whoever leads and fight what they pull (playerbots' own "drink",
#   "attack" and "summon" still work).
#
#   Party chat also reaches playerbots, which reads its own commands from it
#   unless Playerbots.CommandPrefix is set. A bare "go" is one of them --
#   every bot walks to the nearest creature -- so it is only a start phrase
#   (GoPhrases) with a CommandPrefix set; "ready" makes each bot whisper its
#   food and potions, and with Playerbots.EnableAutoTradeOnItemMention = 1 a
#   line with "back" or "food" in it opens trade windows (set it to 0 in
#   playerbots.conf).
#
#   "dungeon" and "instance" are read right however they are typed, one
#   slip off: "just start the dingeon" starts the run.
#
#   A question about the run -- "whats next?", "why are we waiting",
#   "how many bosses left" (RunQuestionPhrases) -- is answered by the bot
#   tank leading it, and by nobody else, unless the line names another bot.
#   With no bot tank (you tank), anyone may answer as usual.
#
#   Only works when mod-dungeon-clear is part of the same build;
#   .ollama status party says whether it was found.
#
#   Phrase lists are separated by |; words are matched lowercase with
#   punctuation and apostrophes dropped ("let's go!" = "lets go"); a
#   trailing * matches any word starting with it; a leading = means the
#   whole line must be exactly that ("=r" matches "r?", not "r u ok"). A
#   word typed long for effect counts as itself: a line that matches nothing
#   is tried again with every run of one letter cut to one, in the line and
#   in the phrases, so "letsgoooo" is "letsgo", "leeggoooo" is "lego" and
#   "readyyy" is "ready".
#
###############################################################################

#    OllamaChat.PartyCommands.Enable
#        Default: 1
OllamaChat.PartyCommands.Enable = 1

#    OllamaChat.PartyCommands.StartPhrases
#    OllamaChat.PartyCommands.PausePhrases
#    OllamaChat.PartyCommands.CancelPhrases
#        Start or resume; pause; and lines that only look like a pause
#        ("dont stop"). Do not add a bare "go" here: without a
#        Playerbots.CommandPrefix it is a playerbots command ("go" sends every
#        bot to your target), so typing it in a dungeon drags the whole group
#        onto whatever you have selected. GoPhrases are added for you when a
#        CommandPrefix is set.
OllamaChat.PartyCommands.StartPhrases = "=r|=begin|=start|=continue|=resume|=back|ready|rdy|gogo*|lets go|lets start|lets begin|lets do this|lets do it|lets roll|lets move|lets continue|lets carry on|carry on|im back|i am back|back now|good to go|start the run|start the dungeon|start dungeon|start the instance|start the clear|just start|=start it|lets get started|=get started|=start now|start already|=start pls|=start please|begin the run|letsgo|lesgo|lezgo|letzgo|lego|leggo|lessgo|lets get it|letsgetit|lets get this|lets go again|go again"

#    OllamaChat.PartyCommands.GoPhrases
#        Start phrases with "go" in them, added to StartPhrases only when
#        Playerbots.CommandPrefix is set (then playerbots no longer reads a
#        bare "go" as its own command).
OllamaChat.PartyCommands.GoPhrases = "=go|=go go|=go go go|=ok go|=k go|=kk go|=go now|=go pls|=go please|=go ahead|=just go|=go for it|=you can go|=go then|=ok go then"

#    OllamaChat.PartyCommands.RunQuestionPhrases
#    OllamaChat.PartyCommands.RunQuestionMaxWords
#        A party line of no more than RunQuestionMaxWords words with one of
#        these in it, in a dungeon with a dungeon-clear bot tank, is a
#        question about the run: the tank answers it, nobody else.
#        Default: 14 words
OllamaChat.PartyCommands.RunQuestionPhrases = "whats next|what next|what now|whats now|whos next|who is next|which boss|what boss|next boss|wheres the boss|where is the boss|whats the plan|what is the plan|whats our plan|what are we doing|what we doing|what r we doing|what are we waiting|what we waiting|why are we waiting|why we waiting|why are we stopped|why did we stop|why we stopped|why stop|why stopping|why are we not moving|why arent we|whats going on|what is going on|whats happening|what happened|where are we going|where we going|where to|where now|where next|which way|how many bosses|how many left|bosses left|whats left|what is left|anything left|are we done|we done|done yet|is that it|is that all|last boss|how far|status|progress|are you stuck|you stuck|why are you stuck|why stuck|whats wrong|what is wrong|whos leading|who is leading|whos tanking|who is tanking|are we pulling|next pull|next pack"
OllamaChat.PartyCommands.RunQuestionMaxWords = 14
OllamaChat.PartyCommands.PausePhrases = "mb|mana break|manabreak|need mana|need some mana|need more mana|need some more mana|need a bit of mana|need a bit more mana|need a little mana|need a little more mana|need to get mana|get some mana|get my mana|get mana back|let me get mana|lemme get mana|mana low|mana is low|manas low|mana getting low|mana is getting low|manas getting low|need to regen|need regen|let me regen|lemme regen|gotta regen|regen break|need to drink|need a drink|need drink|need some drink|need a quick drink|quick drink|drink break|drink first|let me drink|lemme drink|gotta drink|got to drink|have to drink|gonna drink|going to drink|drinking|=drink|oom|no mana|low mana|low on mana|out of mana|outta mana|need to eat|let me eat|lemme eat|wait|w8|=w|hold on|hold up|holdup|hang on|stop|pause|=sec|one sec|1 sec|a sec|one min|1 min|a min|brb|=afk|need a break|need a sec|gimme a sec|give me a sec|bio break|=bio|lets rest|need to rest|=rest|dont pull|stop pulling|stay here|stay there|stay back|stay put|hold position|hold here|dont move"
OllamaChat.PartyCommands.CancelPhrases = "dont stop|do not stop|dont wait|do not wait|no need to wait|no need to stop|dont need to wait|keep going|no break|dont need a break|no need"

#    OllamaChat.PartyCommands.ResumePhrases
#        What someone says once their break is over ("ok im done", "full
#        mana", "done drinking"). Only while the run is paused, and only in a
#        short line: they mean nothing otherwise. A pause word inside one
#        ("drinking") is part of it. One that is a start phrase too ("im
#        ready now", "good to go") starts a run as well. No bare "go": it is a
#        playerbots command.
OllamaChat.PartyCommands.ResumePhrases = "done|im done|all done|done now|finished|im finished|done drinking|finished drinking|done eating|finished eating|full|im full|full mana|mana full|full now|topped up|topped off|good to go|ready now|lets get going|ok lets go"

#    OllamaChat.PartyCommands.ResumeFillers
#    OllamaChat.PartyCommands.ResumeMaxWords
#    OllamaChat.PartyCommands.ResumeMaxStray
#        Words that go with a resume ("ok all done thanks"), the longest line
#        that can be one, and how many other words it may have: "i have done
#        this before" is not the end of a break.
#        Default: (below), 6, 1
OllamaChat.PartyCommands.ResumeFillers = "ok|okay|k|kk|alright|aight|right|so|im|i am|all|now|then|lol|ty|thanks|thx|cheers|thank you|guys|lads|mate|yep|yeah|yes|ye|sorry|sry|and|too|finally|phew|np|good|great|cool|nice"
OllamaChat.PartyCommands.ResumeMaxWords = 6
OllamaChat.PartyCommands.ResumeMaxStray = 1

#    OllamaChat.PartyCommands.NegationWords
#        Stop either kind: "not ready", "i dont need mana". Not when the
#        negation is part of the phrase itself ("dont pull"), and not a
#        "no", "nah" or "nope" up front ("no wait").
OllamaChat.PartyCommands.NegationWords = "not|dont|cant|wont|no|nope|nah|never|aint|isnt|arent|havent"

#    OllamaChat.PartyCommands.QuestionWords
#    OllamaChat.PartyCommands.QuestionOpeners
#        A question word anywhere in the line ("wait what", "where do we
#        go"), or an opener as its first word ("you oom", "anyone need
#        mana", "are you ready"), makes it talk rather than an instruction.
#        So does a ?, except in a ready check.
OllamaChat.PartyCommands.QuestionWords = "what|where|why|how|who|which|whats|wheres|whos|hows"
OllamaChat.PartyCommands.QuestionOpeners = "are|is|am|do|does|did|you|u|ya|anyone|anybody|someone|somebody|any1|ne1|has|have|when|r u"

#    OllamaChat.PartyCommands.NotYetWords
#        Stop a start: "almost ready", "ready in 5", "lets go after this".
OllamaChat.PartyCommands.NotYetWords = "almost|nearly|soon|later|after|until|till|til|in a|in one|in two|in few|in 1*|in 2*|in 3*|in 4*|in 5*|in 6*|in 7*|in 8*|in 9*"

#    OllamaChat.PartyCommands.MaxWords
#        Longer lines are conversation, not instructions.
#        Default: 10
OllamaChat.PartyCommands.MaxWords = 10

#    OllamaChat.PartyCommands.MaxDistance
#        A real player further than this from the tank (yards), or not inside
#        yet, holds the start: the tank says it is waiting for them.
#        Default: 100
OllamaChat.PartyCommands.MaxDistance = 100

#    OllamaChat.PartyCommands.HintStart
#    OllamaChat.PartyCommands.HintPause
#    OllamaChat.PartyCommands.HintBreak
#    OllamaChat.PartyCommands.HintResume
#    OllamaChat.PartyCommands.HintWaiting
#        What the tank is told when it answers. It answers in its own chat
#        style -- "ok moving" from a serious one, something daft from a
#        joker -- and is shown its last few answers in this group so it does
#        not say the same thing every time. HintBreak is its answer to a
#        rest that ends by itself (Party.BreakEnd*): just an ok, "np" or
#        "drink up", as it will see for itself when everyone is ready; empty
#        uses HintPause. Placeholders: {player_name}, {player_message},
#        {reason} (HintPause, HintBreak: "a mana break (mb means mana break:
#        they need to drink)", "a rest to eat and drink", "a short break",
#        "a moment"), {missing} (HintWaiting: who is not there yet),
#        {recent_acks} (RecentAcksText, or nothing; added at the end if left
#        out).
OllamaChat.PartyCommands.HintStart = "{player_name} is ready, so you lead the group on through the dungeon. Tell them in two to six words, in your own chat style: someone serious just says they are moving, a joker shouts something silly, and anything in between is fine. Only talk about a fight if one is actually in front of you.{recent_acks}"
OllamaChat.PartyCommands.HintPause = "{player_name} asked the group to stop for {reason}, and you have stopped the run. Tell them in a few words, in your own chat style, that you will wait and they should say when they are ready.{recent_acks}"
OllamaChat.PartyCommands.HintBreak = "{player_name} asked for {reason}, so you have stopped the run for it. Just say ok, in one to four words and your own chat style, the easy way a tank does when someone needs to drink. You will see for yourself when everyone is ready, so do not ask them to tell you.{recent_acks}"
OllamaChat.PartyCommands.HintResume = "{player_name} is ready again, so the run carries on and you lead the way. Say so in a few words, in your own chat style.{recent_acks}"
OllamaChat.PartyCommands.HintWaiting = "{player_name} wants to start, but not everyone is here yet: still waiting for {missing}. Tell them in a few words that you will start as soon as everyone is here.{recent_acks}"

#    OllamaChat.PartyCommands.RecentAcks
#    OllamaChat.PartyCommands.RecentAcksText
#        How many of the tank's answers each group remembers, and how they
#        are shown to it ({lines}: "pulling now", "lets go"). 0 disables.
#        Default: 4, (below)
OllamaChat.PartyCommands.RecentAcks = 4
OllamaChat.PartyCommands.RecentAcksText = " You already said {lines} in this group, so use different words this time."

#    OllamaChat.PartyCommands.SkipEnable
#        Skipping a boss, asked in party during a dungeon-clear run led by a
#        bot tank -- "skip the next boss", "can we skip oggleflint", "skipp
#        him", "skip oggleflint and jergosh" -- skips it: the run leaves it
#        out and the tank says so, and where it is heading now, in its own
#        chat style. "skip to taragaman" or "straight to the last boss"
#        skips every boss before it. "dont skip jergosh", "unskip him" or
#        "actually lets do jergosh" takes a skip back: a boss already behind
#        the run is gone back for now ("...later" leaves it to the end), one
#        ahead is done in its turn. Said before the run starts ("skip the
#        first boss", "ready, skip oggleflint"), the skip waits for the run.
#        A boss already dead, one being fought, or one skipped already gets
#        a no and why. Nobody else answers the line.
#        Names are read the way people type them: any word of one but its
#        titles (SkipTitleWords: "cobrahn" is Lord Cobrahn), typed long or
#        short ("oglefint"), a slip off (two in a long name), the start of
#        it ("taraga"), or split ("van cleef").
#        Not an ask: a question about it ("why did we skip him", "are we
#        skipping it?", SkipQuestionWords), a negation ("we cant skip him"),
#        a line about trash or loot ("skip this pull", SkipNotBossWords),
#        bosses by number ("skip the next 2"), or other words after the skip
#        with no boss or "it" among them ("skip everything").
#        Skipping a boss another needs (one of Wailing Caverns' four
#        Fanglords, which Mutanus needs) leaves the run stuck later on: take
#        the skip back to carry on.
#        Needs a mod-dungeon-clear with named skips (DcCommandApi.h); .ollama
#        status says whether the build has it.
#        Default: 1
OllamaChat.PartyCommands.SkipEnable = 1

#    OllamaChat.PartyCommands.SkipPhrases
#    OllamaChat.PartyCommands.SkipNamedPhrases
#    OllamaChat.PartyCommands.SkipToPhrases
#    OllamaChat.PartyCommands.UnskipPhrases
#    OllamaChat.PartyCommands.SkipDoPhrases
#        The asks. SkipPhrases work with a boss's name, "the next boss",
#        "him", "it" or nothing at all ("skip": what the run is heading for).
#        SkipNamedPhrases ("leave", "dont kill") only with a boss's name.
#        SkipToPhrases skip every boss before the one named (or the last
#        one). UnskipPhrases take a skip back, of a boss named or the one
#        just skipped ("no dont skip"); SkipDoPhrases ("lets do", "go back
#        for") only of one named, and only when it was skipped.
OllamaChat.PartyCommands.SkipPhrases = "skip|skipp|skp|sikp|skipping|skiping|skippin"
OllamaChat.PartyCommands.SkipNamedPhrases = "pass on|leave|leave out|ignore|forget|forget about|bypass|go past|go round|go around|run past|walk past|skip over|dont do|dont kill|dont fight|dont bother with|dont bother killing|no need to do|no need to kill|no need for|dont need|we dont need|not doing|not killing"
OllamaChat.PartyCommands.SkipToPhrases = "skip to|skipp to|skip straight to|skip ahead to|skip right to|skip on to|skip up to|skip until|skip till|skip til|straight to|go straight to|head straight to|jump to|just do|only do|lets just do|just go for|go straight for"
OllamaChat.PartyCommands.UnskipPhrases = "unskip|un skip|dont skip|do not skip|dont wanna skip|dont want to skip|lets not skip|not skip|no skipping|stop skipping|cancel the skip|undo the skip|undo skip"
OllamaChat.PartyCommands.SkipDoPhrases = "lets do|do|kill|lets kill|go back for|back for|go for|lets get|get|fight|lets fight|take on|actually do|actually kill|we can do|we should do|go kill|go do"

#    OllamaChat.PartyCommands.SkipNextBossWords
#    OllamaChat.PartyCommands.SkipNextWords
#    OllamaChat.PartyCommands.SkipLastWords
#        Which boss, without a name. SkipNextBossWords ("him", "the next
#        boss") are the boss the run is heading for, or the first one after
#        a stop or an event it is on its way to. SkipNextWords ("it", "this
#        one") are what it is heading for: on its way to an event rather
#        than a boss, they are left to ordinary chat. SkipLastWords are the
#        dungeon's last boss.
OllamaChat.PartyCommands.SkipNextBossWords = "next boss|the next boss|this boss|the boss|boss|that boss|current boss|first boss|the first boss|him|her|he|she|this guy|that guy|next guy|the next guy"
OllamaChat.PartyCommands.SkipNextWords = "next|next one|the next one|the next|this|this one|that|that one|it|first one|the first one|the first"
OllamaChat.PartyCommands.SkipLastWords = "last boss|the last boss|last one|the last one|end boss|the end boss|final boss|the final boss|the end|end|the last|last|final|final one|the final one"

#    OllamaChat.PartyCommands.SkipNotBossWords
#    OllamaChat.PartyCommands.SkipFillers
#    OllamaChat.PartyCommands.SkipStopWords
#    OllamaChat.PartyCommands.SkipQuestionWords
#    OllamaChat.PartyCommands.SkipNegationWords
#    OllamaChat.PartyCommands.SkipTitleWords
#    OllamaChat.PartyCommands.SkipMaxWords
#        After the ask: a word of SkipNotBossWords makes it no boss skip at
#        all; SkipFillers can be there without saying anything; a stop word
#        ends what the ask is about ("skip him because..."). Anywhere in the
#        sentence, a question word makes it talk; before the ask or in it, a
#        negation does ("we cant skip him"), but not a "no" up front ("no,
#        skip him"). SkipTitleWords never name a boss alone. Lines longer
#        than SkipMaxWords words are conversation.
#        Default: (below), 14
OllamaChat.PartyCommands.SkipNotBossWords = "trash|pack|packs|mob|mobs|adds|add|pat|pats|patrol|patrols|pull|pulls|loot|looting|chest|chests|cutscene|rp|dialogue|talk|talking|quest|quests|event|events|escort|room|part|jump|drop|corridor|hallway|corner|door|gate|whelps|these|those|everything|all"
OllamaChat.PartyCommands.SkipFillers = "the|a|an|pls|please|plz|plx|now|for now|this time|today|tonight|and|too|also|as well|just|lol|lmao|haha*|lets|can|could|we|you|u|ya|yall|guys|mate|lads|ok|okay|k|kk|yeah|yes|yep|ye|of|maybe|probably|i|id|ill|im|think|should|shall|would|wanna|want|to|quick|quickly|instead|anyway|anyways|tbh|imo|honestly|ahead|ty|thanks|cheers|already|again|actually|tho|though|right|alright|aight|after all|sorry|sry|hmm|hm|uh|um|guess|i guess|over|out|past|by|on"
OllamaChat.PartyCommands.SkipStopWords = "then|but|because|cuz|cause|coz|cos|cus|bc|since|so|until|till|unless|while|instead of"
OllamaChat.PartyCommands.SkipQuestionWords = "why|how|what|whats|wat|wut|when|where|which|did|didnt|have we|havent we|has he|was|were|are we|arent we|r we|is it|is he|is she|isnt|does|doesnt|do we need|do we have to|do we gotta|need to kill|have to kill|skipped|skippable|worth|or not|wonder"
OllamaChat.PartyCommands.SkipNegationWords = "not|cant|cannot|wont|shouldnt|wouldnt|couldnt|never|no|nope|nah|dont|aint"
OllamaChat.PartyCommands.SkipTitleWords = "the|of|lord|lady|king|queen|prince|princess|high|chief|captain|commander|general|warlord|overlord|mr|mrs|miss|sir|dame|old|big|little|great|grand|elder|ancient|master|baron|baroness|count|countess|duke|archmage|magister|warchief|priest|priestess|inquisitor|houndmaster|arcanist|bloodmage|ambassador|emperor|guardian|keeper|matriarch|patriarch|watcher|deviate|defias|scarlet|brother|sister|champion"
OllamaChat.PartyCommands.SkipMaxWords = 14

#    OllamaChat.PartyCommands.SkipLaterWords
#        A skip taken back of a boss the run has already gone past is gone
#        back for now, unless the line has one of these ("actually lets do
#        jergosh later"): then once everything ahead is done.
OllamaChat.PartyCommands.SkipLaterWords = "later|after|afterwards|at the end|on the way back|after this|after that|after the rest|when we are done|last"

#    OllamaChat.PartyCommands.HintSkip
#    OllamaChat.PartyCommands.HintSkipNo
#    OllamaChat.PartyCommands.HintUnskip
#        What the tank is told when it answers a skip, one it cannot do, and
#        one taken back. Placeholders: {player_name}, {player_message},
#        {skipped} (the bosses, "Oggleflint and Jergosh the Invoker"),
#        {next} (the boss the run heads for now), {plan} (what happens now:
#        "you turn away from it and head for Taragaman the Hungerer instead."),
#        {reason} (HintSkipNo: "Oggleflint is already dead."), {recent_acks}.
OllamaChat.PartyCommands.HintSkip = "{player_name} asked to skip {skipped}, and you agree: {plan} Tell them in a few words, in your own chat style; you can say where you are heading next.{recent_acks}"
OllamaChat.PartyCommands.HintSkipNo = "{player_name} asked to skip {skipped}, but {reason} Tell them so in a few words, in your own chat style.{recent_acks}"
OllamaChat.PartyCommands.HintUnskip = "{player_name} wants to do {skipped} after all, and you agree: {plan} Tell them in a few words, in your own chat style.{recent_acks}"

#    OllamaChat.Party.DungeonGlossary
#        Added to every party and raid chat prompt inside a dungeon or raid,
#        so "mb" reads as a mana break and not "my bad". Empty disables.
OllamaChat.Party.DungeonGlossary = "In group chat here: mb means mana break (they need to drink, so wait for them), oom means out of mana, r or rdy means ready, brb means be right back, inc means enemies incoming, cc means crowd control, and pull means start the fight."

#    OllamaChat.Party.DungeonAmbientPercent
#    OllamaChat.Party.DungeonFocusText
#        Inside a dungeon or raid people keep their mind on the run: a bot
#        there starts a line of its own only this percent as often as it
#        would outside (RandomChatterBotCommentChance), and its party prompt
#        gets DungeonFocusText -- with the run's state, during a dungeon-clear
#        run -- so what it does say is about the run, not "did you hear about
#        the druid that got kicked?". Replies to someone are not affected.
#        Default: 35, (below)
OllamaChat.Party.DungeonAmbientPercent = 35
OllamaChat.Party.DungeonFocusText = "You are in the middle of a dungeon run with your group. If you say anything, keep it to the run: the pulls, the bosses, the loot, someone low on health or mana, the place itself. No gossip, rumours or anything that has nothing to do with it."

#    OllamaChat.Party.RunStateText
#        Added to party and raid chat prompts while a dungeon-clear run is on,
#        so a bot asked "which boss is next?" or "what are we waiting for?"
#        can answer. Placeholders: {tank} (who leads the run), {progress}
#        ("2 of 5 bosses are down"), {killed}, {left}, {total}, {next}
#        (the next boss), {state} ("resting or waiting for someone (waiting
#        on Brelac, out of range)", "fighting trash", "paused"...), {skipped}
#        (RunStateSkippedText, or nothing). Empty disables.
OllamaChat.Party.RunStateText = "About this dungeon run: {tank} leads it, {progress}, the next boss is {next}, and right now the group is {state}. Only bring this up when someone asks what is going on, what the plan is or which boss is next."

#    OllamaChat.Party.RunStateSkippedText
#        Added to the run's state while it is skipping bosses someone asked it
#        to skip ({skipped}: "Oggleflint"), so nobody says they are coming up.
#        {skipped} in RunStateText puts it there; otherwise it goes at the end.
OllamaChat.Party.RunStateSkippedText = " The group is skipping {skipped} this run, because someone asked to."

#    OllamaChat.Party.GreetEnable
#    OllamaChat.Party.GreetDelaySeconds
#    OllamaChat.Party.GreetSituation
#        When a group led by a bot tank comes into a dungeon, the tank asks in
#        party, in its own chat style, whether everyone is ready to start --
#        once, GreetDelaySeconds after it and a real player are both inside,
#        and not when the run is under way already. "{~this|that}" is one or
#        the other, picked each time, so the ask is put a different way. Keep
#        it a plain are-you-ready question: "need anything before we start?"
#        gets "im good", which ReadyYesPhrases does not take as a yes. (The
#        stock "I don't know this dungeon, lead the way!" whisper is muted:
#        MUTED BOT LINES below.)
#        Default: 1, 8, (below)
OllamaChat.Party.GreetEnable = 1
OllamaChat.Party.GreetDelaySeconds = 8
OllamaChat.Party.GreetSituation = "The group has just come in and nobody has pulled anything yet. {~Ask everyone if they are ready to start|Check everyone is ready before you start|Ask if they are ready for the first pull|Ask whether they are ready for you to start pulling}, in your own way and your own words: a plain are-you-ready question, not whether anyone needs anything."

#    OllamaChat.Party.ReadyYesPhrases
#    OllamaChat.Party.ReadyWindowSeconds
#        Once the tank has asked whether they are ready (the line is out, not
#        just asked for), for ReadyWindowSeconds a line that is nothing but a
#        yes -- one of these, with names and ResumeFillers ("ok", "mate",
#        "lol") around it -- answers it and starts the run, the way "ready" or
#        "lets go" always does: "yep", "sure", "ok go for it". "yes but wait",
#        "yeah 2 min" and "not yet" do not, and neither does "ok", "good" or
#        "im good" on its own: those answer too many other things ("need
#        water?" "im good"). Phrases separated by |, matched on whole words.
#        Later on, "ready" and the rest of StartPhrases still start it.
#        Default: (below), 180
OllamaChat.Party.ReadyYesPhrases = "yes|yep|yup|yeah|ye|ya|yea|y|sure|aye|go|gogo|go go|of course|ofc|sure thing|why not|mhm|yes please|do it|lets do it|go for it|go ahead|go on|go on then|whenever|when you are|ready when you are|yes im ready|yeah im ready|yep im ready|born ready|yes lets go|yeah lets go|yep lets go|lets"
OllamaChat.Party.ReadyWindowSeconds = 180

#    OllamaChat.Party.ReadyTimeoutSeconds
#        When nobody says anything in party for this many seconds after the
#        tank's are-you-ready (GreetSituation), the tank takes it they are:
#        once the whole group is here and ready to go -- every member online
#        and in this copy of the dungeon, and the rest as at the end of a rest
#        (BreakEnd*: alive, out of combat, real players within
#        PartyCommands.MaxDistance of the tank and not AFK, health and mana
#        back) -- it says so in party, in its own chat style ("ok, taking
#        that as a yes, pulling"), and starts the run. Anything a
#        real player says in party after the ask, whatever it is, leaves the
#        start to them: "ready", or a yes, starts it as always. Only while
#        ReadyWindowSeconds lasts, and only with a bot leading the run.
#        0 disables: the run waits for someone to say ready, as before.
#        Default: 60
OllamaChat.Party.ReadyTimeoutSeconds = 60

#    OllamaChat.Party.ReadyTimeoutSituation
#    OllamaChat.Party.ReadyTimeoutWords
#    OllamaChat.Party.ReadyTimeoutLines
#        The tank's line as it takes the lead, the way BreakEnd* has its: it
#        goes into AnnouncePrompt as {situation}, and {~a|b} picks one at
#        random. The line has to make it plain the run is starting, so it
#        must have one of ReadyTimeoutWords in it; when it does not -- or the
#        model passes, fails or cannot be reached -- one of ReadyTimeoutLines
#        goes out instead, in the tank's chat style. The run starts once the
#        line is out (20 seconds later anyway if it never gets out), and a
#        line still being written when somebody says something is dropped.
#        "Lead" is not one of the words: "right then leading off now" is not
#        how a tank says it, so a line like that gets a typed one instead.
#        Default: (below)
OllamaChat.Party.ReadyTimeoutSituation = "You asked whether everyone was ready a little while ago and nobody has answered, but the whole group is here and good to go, so you take the silence as a yes and start pulling now. {~Say you are taking the silence as a yes and pulling|Say nobody said no, so you are going|Say everyone looks set, so lets go|Say you are pulling now, so keep up}, in a few words of your own, whatever suits your chat style."
OllamaChat.Party.ReadyTimeoutWords = "start|starting|go|gogo|going|lets go|pull|pulling|move|moving|off we|here we go|follow|keep up|get going|getting going|on we|lets do this|lets do it|kick off|kicking off|heading in"
OllamaChat.Party.ReadyTimeoutLines = "ok, taking that as a yes, pulling|looks like everyones set, lets go|nobody said no, so im pulling|alright, pulling now, keep up|ok lets get going then"

#    OllamaChat.Party.TogetherText
#        Added to every party and raid prompt inside a dungeon or raid: the
#        bot and its group are doing this place together, so nobody says
#        "good luck with the run" to the run they are in, or asks the party
#        to group up for a quest out in the world. Placeholders: {dungeon},
#        {tank} (", with Gruk tanking" when a dungeon-clear tank leads, else
#        nothing). Empty disables.
OllamaChat.Party.TogetherText = "You and everyone in this group are inside {dungeon} together, doing it as one group{tank}. You are part of this run: never talk about it as if they were going without you, and anything you ask about or bring up is about this place, not quests or groups somewhere else."

#    OllamaChat.Party.DoneEnable
#    OllamaChat.Party.DoneSituation
#        When every boss the run means to kill is dead, the tank says in party
#        that the dungeon is cleared. DoneSituation: {dungeon} ("Razorfen
#        Kraul"), {bosses} ("all 6 bosses are down", "the boss is down").
#        Default: 1, (below)
OllamaChat.Party.DoneEnable = 1
OllamaChat.Party.DoneSituation = "Every boss in {dungeon} is dead: the group has cleared the whole dungeon and the run is over. Say that plainly first - {dungeon} is cleared, {bosses} - so nobody can miss that it is done, then celebrate it your own way: gg, thanks, nice work, whatever suits you."

#    OllamaChat.Party.DoneSkippedSituation
#    OllamaChat.Party.DoneSkippedWords
#    OllamaChat.Party.DoneSkippedLines
#    OllamaChat.Party.DoneSkippedText
#        The same for a run that skipped bosses someone asked it to: it is
#        over, but no full clear. DoneSkippedSituation is what the tank is
#        told ({dungeon}, {bosses}: "3 bosses are down", {skipped}:
#        "Oggleflint", {was_were}), its line must have one of DoneSkippedWords
#        in it or one of DoneSkippedLines goes out instead, and the rest of
#        the group's gg prompt (CheerPrompt) gets DoneSkippedText.
OllamaChat.Party.DoneSkippedSituation = "The group has done every boss it meant to in {dungeon} and the run is over: {bosses}, and {skipped} {was_were} skipped on purpose. Say that plainly first - you are done with {dungeon} - so nobody can miss it, then celebrate it your own way: gg, thanks, nice work, whatever suits you. It was not a full clear, so never call it one."
OllamaChat.Party.DoneSkippedWords = "done|all done|run done|dungeon done|were done|we are done|thats it|that is it|finished|thats us|thats everything|complete|completed"
OllamaChat.Party.DoneSkippedLines = "thats us done here, gg all|right, thats {dungeon} done. gg everyone|and thats the run done, gg all|thats it for {dungeon}, ty all|done here, gg|thats everything we were doing, gg all"
OllamaChat.Party.DoneSkippedText = " They skipped {skipped} on purpose, so it was not a full clear: never call it one."

#    OllamaChat.Party.DoneWords
#    OllamaChat.Party.DoneLines
#        The tank's call has to make it plain the dungeon is done: its line
#        must have one of DoneWords in it (or the dungeon's name). When it
#        does not -- "finally, my arms are tired" -- or the model passes,
#        fails or cannot be reached, one of DoneLines goes out instead
#        ({dungeon}, {bosses} as above), so the call is never lost.
#        Default: (below)
OllamaChat.Party.DoneWords = "clear|cleared|full clear|complete|completed|finished|all bosses|all the bosses|every boss|all done|run done|dungeon done|were done|we are done|thats it|that is it"
OllamaChat.Party.DoneLines = "{dungeon} cleared, gg all|That's {dungeon} done, full clear. gg everyone|Full clear of {dungeon}! nice work all|And that's {dungeon} cleared, every boss down. gg|{dungeon} complete, gg and ty all|Every boss in {dungeon} is down, that's the clear done. gg"

#    OllamaChat.Party.CheerEnable
#    OllamaChat.Party.CheerChance
#    OllamaChat.Party.CheerCannedChance
#    OllamaChat.Party.CheerLines
#    OllamaChat.Party.CheerPrompt
#        Once the tank has called it, every other bot in the group says
#        something to end the run on -- "gg", "ty all", "good run" -- each
#        with CheerChance, once, a second or few apart. CheerCannedChance of
#        them type one of CheerLines (never the same one twice in a group);
#        the rest have the model write one in their own style (CheerPrompt:
#        {bot_name} {bot_level} {bot_race} {bot_class} {bot_personality}
#        {dungeon} {tank}). Nobody answers anybody's gg. In roleplay mode
#        every line is the model's.
#        Default: 1, 85, 60, (below)
OllamaChat.Party.CheerEnable = 1
OllamaChat.Party.CheerChance = 85
OllamaChat.Party.CheerCannedChance = 60
OllamaChat.Party.CheerLines = "gg|gg all|gg ty|gg everyone|gj all|ty all|thanks all|thx all|good run|nice run|gg wp|ty for the group|great run|gg thanks all|ty gg"
OllamaChat.Party.CheerPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a dungeon group. Your chat style: {bot_personality} Your group has just cleared {dungeon} - every boss is dead and the run is over - and {tank} has just said so. Say a quick end-of-run line in party chat, 1 to 6 words, the way players do before they leave: gg, gj, ty all, good run, thanks for the group, or something like it in your own words. No quotes, no name in front."

#    OllamaChat.Party.DoneLeave
#    OllamaChat.Party.DoneLeaveSeconds
#    OllamaChat.Party.DoneStayWords
#    OllamaChat.Party.DoneGoWords
#        In a dungeon-finder group, the random bots the finder matched leave
#        once it is done, the way people do: the first DoneLeaveSeconds after
#        the tank's call, the rest a few seconds apart (and the dungeon finder
#        takes each one back out to where it came from). Bots you (or anyone
#        still in the group) invited in the last six hours -- even if you then
#        queued together -- a group you made without the finder, your own
#        bots, and the ones mod-dungeon-clear's queue fill logs in for you (it
#        sees those out itself) all stay.
#        A party line from you with one of DoneStayWords in it -- "wait",
#        "hang on", "can you help me with...", "one more?" -- keeps them all;
#        after that, one with DoneGoWords -- "ok bye", "you can go" -- lets
#        them go after all. DoneStayWords holds only asks, so an ask keeps
#        them even with a goodbye in the same line ("ty - can you help me with
#        one more thing?"), while "gg, thanks for the help" keeps nobody.
#        Words are matched whole, case and apostrophes aside.
#        DoneLeaveSeconds: 10 to 600.
#        Default: 1, 30, (below)
OllamaChat.Party.DoneLeave = 1
OllamaChat.Party.DoneLeaveSeconds = 30
OllamaChat.Party.DoneStayWords = "wait|hang on|hold on|one sec|1 sec|sec|brb|dont leave|dont go|not yet|pls stay|please stay|stay a bit|stay for|can you stay|stay pls|stay please|help me|need help|help with|help us|can you|could you|can someone|can anyone|anyone up|anyone want|anyone fancy|quest|one more|another run|another dungeon|go again|run it again|do it again|run it back|next one|next run|next dungeon"
OllamaChat.Party.DoneGoWords = "bye|cya|see ya|see you|you can go|u can go|you can leave|u can leave|ok go|thats all|thats it|im done|we are done|were done|done now|all good|thanks for the help|ty for the help|thx for the help|stay safe|take care"

#    OllamaChat.Party.DoneStateText
#    OllamaChat.Party.DoneLeavingText
#    OllamaChat.Party.DoneStayingText
#        For a bot answering in party once the run is over, so "can you help
#        me with one more thing?" is answered knowing that: DoneStateText
#        ({dungeon}, {plan}), where {plan} is DoneLeavingText while the
#        finder's bots are about to go, DoneStayingText once someone asked
#        them to stay, and nothing in a group nobody leaves. Empty leaves it
#        out.
#        Default: (below)
OllamaChat.Party.DoneStateText = "The run is over: every boss in {dungeon} is dead and the group has cleared the dungeon.{plan}"
OllamaChat.Party.DoneLeavingText = " Everyone who came in through the dungeon finder is about to leave the group, the way people do after a run, unless someone asks them to stay."
OllamaChat.Party.DoneStayingText = " Someone asked everyone to stick around, so you are all staying in the group for now."

#    OllamaChat.Party.BreakEndEnable
#    OllamaChat.Party.BreakEndHealthPct
#    OllamaChat.Party.BreakEndManaPct
#    OllamaChat.Party.BreakEndOthersManaPct
#    OllamaChat.Party.BreakEndLowManaClasses
#    OllamaChat.Party.BreakEndLowManaPct
#    OllamaChat.Party.BreakEndMinSeconds
#    OllamaChat.Party.BreakEndMaxMinutes
#        A rest someone calls in party -- "mb", "need mana", "drink", "lets
#        eat" -- ends by itself, the way a tank ends one: it watches the bars,
#        and when everyone is ready it says so in party and carries on. When
#        the rest is called it only says ok (PartyCommands.HintBreak). It
#        carries on once the rest has gone on BreakEndMinSeconds and:
#          - everyone in the group who is inside is alive, out of combat and
#            back to BreakEndHealthPct health,
#          - every real player and every healer has BreakEndManaPct mana,
#            every other bot BreakEndOthersManaPct (it tops up on the way,
#            as on the rest of a run), and a bot of one of
#            BreakEndLowManaClasses that does not heal only BreakEndLowManaPct:
#            hunters and shamans do their damage without much mana,
#          - every real player is inside, within PartyCommands.MaxDistance of
#            the tank, not AFK, and not still sat drinking: someone sat down
#            is done only when both bars are full.
#        "ready" or "ok im done" still ends it at once. "brb", "wait" or
#        "stop" in the middle of it leaves it to someone to say ready, as
#        does a rest that has gone on BreakEndMaxMinutes (1 to 60); another
#        "mb" starts it over. On their own, "brb", "wait" and "stop" always
#        wait for someone to say ready.
#        Only with a bot leading the run. 0 disables: every pause waits for
#        someone to say ready, as before.
#        BreakEndLowManaClasses are class names separated by | (warrior,
#        paladin, hunter, rogue, priest, death knight, shaman, mage, warlock,
#        druid); empty for none. mod-dungeon-clear's own rests have the same
#        thing as DungeonClear.SmartRestLowManaClasses.
#        Default: 1, 90, 95, 80, hunter|shaman, 25, 10, 5
OllamaChat.Party.BreakEndEnable = 1
OllamaChat.Party.BreakEndHealthPct = 90
OllamaChat.Party.BreakEndManaPct = 95
OllamaChat.Party.BreakEndOthersManaPct = 80
OllamaChat.Party.BreakEndLowManaClasses = "hunter|shaman"
OllamaChat.Party.BreakEndLowManaPct = 25
OllamaChat.Party.BreakEndMinSeconds = 10
OllamaChat.Party.BreakEndMaxMinutes = 5

#    OllamaChat.Party.BreakEndSituation
#    OllamaChat.Party.BreakEndWords
#    OllamaChat.Party.BreakEndLines
#        The tank's line as it carries on, in its own chat style: "right lets
#        go guys" from one, "too slow, lets go" or "KEEP UP" from another. It
#        goes into AnnouncePrompt as {situation}; {~a|b} picks one at random.
#        The line has to make it plain they are moving, so it must have one
#        of BreakEndWords in it. When it does not -- or the model passes,
#        fails or cannot be reached -- one of BreakEndLines goes out instead.
#        The run carries on once the line is out (20 seconds later anyway if
#        it never gets out), and a line still being written when somebody
#        says ready is dropped.
#        Default: (below)
OllamaChat.Party.BreakEndSituation = "Everyone has had their break and has their health and mana back, so you are getting the run going again, right now. {~Tell them you are off|Get them moving|Tell them you are carrying on|Call them back to it}, in a few words of your own: hurry them along, tease them for being slow, keep it short and bossy, or just say you are going, whatever suits your chat style."
OllamaChat.Party.BreakEndWords = "go|gogo|move|moving|carry on|carrying on|keep up|keep going|onward|onwards|continue|continuing|pull|pulling|next|back to it|lets roll|rolling|push on|pushing on|follow|resume|resuming|off we|on we"
OllamaChat.Party.BreakEndLines = "ok lets go|right, moving on|alright, lets go|ok, pulling|right, back to it|ok everyone good, lets carry on|lets keep going"

#    OllamaChat.Party.AnnouncePrompt
#        The prompt for the tank's lines nobody asked for. Placeholders:
#        {bot_name}, {bot_level}, {bot_race}, {bot_class}, {bot_personality},
#        {dungeon}, {situation} (GreetSituation, DoneSituation or
#        BreakEndSituation), {recent_acks} (the tank's last few lines in this
#        group, RecentAcksText; added at the end if left out).
OllamaChat.Party.AnnouncePrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, the tank of your group in {dungeon}. Your chat style: {bot_personality} {situation} Write it as one party chat line, 3 to 12 words, the way a player types it: no quotes, no name in front.{recent_acks}"

###############################################################################
#
#   OLLAMA CHAT - CONJURED FOOD AND WATER
#
#   A real player in a group with a mage bot asks for water the way people
#   do, and the mage conjures it and trades it to them, free:
#
#       "water pls", "water?", "mage can i get food", "anyone got water?",
#       "need water", "Frostiq please can you give me mana pots",
#       "food and water pls", "2 stacks of water pls"
#
#   The mage opens a trade with them, puts the food or water in and accepts
#   its side, so their accept finishes it. It never asks for gold:
#   playerbots' own pricing ("I want 20c for this") does not get a say. It
#   answers in its own chat style, told what is happening by the hints below.
#
#   It conjures the best food or water the asker can use at their level,
#   a stack unless they say how many, and uses something it already carries
#   when it has enough. Conjure Refreshment is food and water at once.
#
#   When it can't, it says why: it is not a mage (and who is), it has not
#   learned to conjure that yet, somebody's bags are full, it is dead. When
#   it only can't yet -- a fight is on, it is out of mana, they are too far
#   apart to trade, one of them is trading already -- it says it will, and
#   does as soon as it can, for up to WaitSeconds.
#
#   Who answers: the bot the line names, or whispers; otherwise the group's
#   nearest mage. In /say only a mage close enough to hear it -- and with
#   nobody in their group to ask, a mage outside it that hears it might.
#   Someone outside the mage's group gets it as a favour (Favor.Strangers):
#   the mage takes it its own way, by its chat style (Buff.Style.<KEY>), and
#   may say no (HintNo) or let it go by; while the trade is on, its
#   playerbots AI is held so the trade is not turned down. With
#   Favor.Strangers = 0, a mage named or whispered by someone outside its
#   group says to invite it instead (HintNotGrouped).
#
#   What counts as asking:
#     * a real item ("water", "food", "mana pots") with an ask or a please
#       ("give", "can i have", "pls"), a need right before it ("need water",
#       "out of food"), "mage" up front or at the end, a line of nothing but
#       the item ("water?", "more water"), or a question to a named bot;
#     * "pots" on its own is a raid call as often as an ask ("pot now", "pot
#       pls"), so it needs a real ask ("pls send me pots") or "mage" or a
#       name with a please or a question;
#     * a loose word ("mana", "drink") only when a bot or "mage" is spoken
#       to and asked: "mage mana pls". Never "need mana", "need a drink",
#       "oom" or "mb": those are mana breaks, for the run's tank;
#     * not a negation before the item ("dont need water"), something had
#       ("i have water", "im good"), a thank-you, a question about it ("where
#       do i buy water"), or something that is not a mage's ("health pots",
#       "healthstone", "food buff", "water walking").
#   Lines that start with a command are left alone: playerbots' own ("t
#   water", "use water", "b water") and vendor talk ("buy water"); so are
#   lines with an item link while Playerbots.EnableAutoTradeOnItemMention
#   is on.
#
#   With EnableAutoTradeOnItemMention = 1, playerbots also reads "food" and
#   "potion" anywhere in a line as an item request, and every bot that hears
#   it tries to open a trade with its master. The mage's trade comes first,
#   but when nobody is offering one (no mage, or it has to wait) some other
#   bot opens an empty trade window. Set it to 0 in playerbots.conf.
#
#   Word lists are separated by |, matched lowercase with punctuation and
#   apostrophes dropped; a trailing * matches any word starting with it.
#
###############################################################################

#    OllamaChat.Conjure.Enable
#        Default: 1
OllamaChat.Conjure.Enable = 1

#    OllamaChat.Conjure.DrinkWords
#    OllamaChat.Conjure.FoodWords
#    OllamaChat.Conjure.PotWords
#    OllamaChat.Conjure.LooseWords
#        What they might ask for. Drink and food words are enough with any
#        ask; pot words need a real ask (AskWords, not just a please), or a
#        bot or "mage" spoken to; loose words only when a bot or "mage" is
#        spoken to and asked. Mana gems cannot be traded, so "mana gem" gets
#        water too, as do pots.
OllamaChat.Conjure.DrinkWords = "water|waters|watter|wata|watah|watr|wotah|h2o|drinks|refreshment*|strudel*|biscuit*|mana pie*|mana bun*|mana cake*|mana pot*|mana potion*|mana gem*"
OllamaChat.Conjure.FoodWords = "food|foods|fud|bread|breads|muffin*|croissant*|cinnamon roll*|sweet roll*|grub|snacks"
OllamaChat.Conjure.PotWords = "pot|pots|potion*"
OllamaChat.Conjure.LooseWords = "mana|drink"

#    OllamaChat.Conjure.NotMageWords
#        Not a mage's to give, so not the words above: "health pots" is not
#        "pots", "food buff" is not food and "water walking" is not water.
OllamaChat.Conjure.NotMageWords = "health pot*|healing pot*|hp pot*|health potion*|healing potion*|healthstone*|health stone*|potion of*|speed pot*|haste pot*|rage pot*|indestructible pot*|wild magic pot*|food buff*|buff food|feast*|water walk*|waterwalk*|water breath*|water elemental*|water shield*"

#    OllamaChat.Conjure.AskWords
#    OllamaChat.Conjure.PoliteWords
#    OllamaChat.Conjure.NeedWords
#    OllamaChat.Conjure.MageWords
#        Asking for something; asking nicely; needing, which counts only right
#        before a drink or food word ("need water", "out of some food"); and
#        the mage, which counts first or last in the line ("mage water pls",
#        "water pls mage").
OllamaChat.Conjure.AskWords = "give|giv|gib|gief|gimme|gimmie|gimmi|send|trade|hand|spare|share|conjure|conj|toss|throw|drop me|pass me|hook me up|hook us up|make me|make us|make some|make more|can i have|can i get|can i grab|could i have|could i get|could i grab|may i have|may i get|do you have|do u have|you have|u have|ya have|you got|u got|ya got|got any|got some|have any|any spare|anyone have|anyone got|anybody have|anybody got|any1 have|any1 got"
OllamaChat.Conjure.PoliteWords = "pls|plz|please|pleas|plox|plis|pl0x|ples|plx|can you|can u|could you|could u|would you|would u|will you|will u|how about"
OllamaChat.Conjure.NeedWords = "need|needs|neeed|nid|want|wanna|could use|out of|outta|low on|ran out of|run out of|running low on|all out of"
OllamaChat.Conjure.MageWords = "mage|mages|magey|wizard"

#    OllamaChat.Conjure.NegationWords
#    OllamaChat.Conjure.HaveWords
#    OllamaChat.Conjure.ThanksWords
#    OllamaChat.Conjure.QuestionWords
#        Not asking: a negation before the item ("dont need water"; a "no" up
#        front is fine unless the item follows it at once), having it ("i have
#        water", but not the "i have" in "can i have"), a thank-you, or a
#        question about it -- the last two only without an ask word.
OllamaChat.Conjure.NegationWords = "not|dont|didnt|doesnt|no|nope|nah|never|without|aint|isnt|arent|havent|wont"
OllamaChat.Conjure.HaveWords = "i have|i got|ive got|i still have|still have|already have|already got|got plenty|have plenty|plenty of|im good|im fine|im set|all good|enough"
OllamaChat.Conjure.ThanksWords = "ty|thx|thnx|thanks|thank you|thank u|tyvm|tysm|tyty|cheers|appreciate*"
OllamaChat.Conjure.QuestionWords = "what|where|why|when|which|how|whats|wheres|whys|hows"

#    OllamaChat.Conjure.CommandWords
#        A line starting with one of these is never an ask: playerbots acts on
#        its own commands itself ("t water" trades, "use water" drinks, "b
#        water" buys), and "buy water" is vendor talk. "u" followed by got,
#        have, need and the like is "you", and still counts.
OllamaChat.Conjure.CommandWords = "t|nt|u|use|s|b|e|c|ue|de|q|r|ll|ss|co|nc|destroy|drop|equip|share|sell|buy|vendor|items|inv|inventory|loot|cast|castnc|drink|roll|mail|sendmail|craft|bank|gb|gbank"

#    OllamaChat.Conjure.MaxWords
#        Longer lines are conversation, not asks.
#        Default: 16
OllamaChat.Conjure.MaxWords = 16

#    OllamaChat.Conjure.Stacks
#    OllamaChat.Conjure.MaxStacks
#        Stacks given when they don't say ("water pls"), and the most one ask
#        gets ("5 stacks of water"). A trade holds six.
#        Default: 1, 3
OllamaChat.Conjure.Stacks = 1
OllamaChat.Conjure.MaxStacks = 3

#    OllamaChat.Conjure.UseMana
#        1: conjuring costs the mage the spell's mana, and an out-of-mana mage
#        waits until it has it. 0: it conjures for nothing.
#        Default: 1
OllamaChat.Conjure.UseMana = 1

#    OllamaChat.Conjure.WaitSeconds
#    OllamaChat.Conjure.TradeSeconds
#        How long an ask waits for a fight to end, for mana or for them to come
#        closer (at least 10); and how long a trade the mage offered stays
#        open before it cancels it (at least 10).
#        Default: 90, 60
OllamaChat.Conjure.WaitSeconds = 90
OllamaChat.Conjure.TradeSeconds = 60

#    OllamaChat.Conjure.HintGive
#    OllamaChat.Conjure.HintWait
#    OllamaChat.Conjure.HintCant
#    OllamaChat.Conjure.HintNotMage
#    OllamaChat.Conjure.HintAlready
#    OllamaChat.Conjure.HintNotGrouped
#    OllamaChat.Conjure.HintNo
#        What the bot is told when it answers: it is giving it; it will once it
#        can; it can't; it is not a mage; it already offered a trade (asked
#        again); they are not in its group (Favor.Strangers = 0); it won't
#        (someone outside its group, its own call). Placeholders: {player_name},
#        {request} ("conjured water", "conjured food and water"), {gift}
#        ("a stack of Conjured Mana Strudel"), {when} ("as soon as this fight
#        is over", "once you have the mana for it, ..."), {reason} ("your bags
#        are full", "you have not learned to conjure food yet"), {class} and
#        {mage} (HintNotMage: " Frostiq is the mage in your group." or " There
#        is no mage in your group.").
OllamaChat.Conjure.HintGive = "{player_name} asked you for {request}. You are a mage, so you have conjured {gift} and are opening a trade to give it to them, free. Tell them in a few words, in your own chat style. Never ask for gold or anything in return."
OllamaChat.Conjure.HintWait = "{player_name} asked you for {request}. You will conjure {gift} and trade it to them, free, {when}. Tell them so in a few words, in your own chat style. Never ask for gold or anything in return."
OllamaChat.Conjure.HintCant = "{player_name} asked you for {request}, but you can't give them any: {reason}. Tell them why in a few words, in your own chat style."
OllamaChat.Conjure.HintNotMage = "{player_name} asked you for {request}, but you are a {class}, not a mage, so you can't conjure it.{mage} Tell them in a few words, in your own chat style."
OllamaChat.Conjure.HintAlready = "{player_name} asked you for {request} again, but you have already offered them a trade with it. Tell them in a few words to accept the trade."
OllamaChat.Conjure.HintNotGrouped = "{player_name} asked you for {request}, but you only hand out conjured food and water to your own group, and they are not in it. Tell them in a few words, in your own chat style, to invite you if they want some."
OllamaChat.Conjure.HintNo = "{player_name} asked you for {request}. You could conjure it for them, but you are not going to: say no in a few words, in your own chat style, with or without a reason."

###############################################################################
#
#   OLLAMA CHAT - BUFFS ON REQUEST
#
#   Someone asks for a buff the way people do, in /say or in a whisper to a
#   bot, and a bot near them that can put one on anybody might:
#
#       "can i get a buff", "buff pls", "buffs?", "anyone got fort?",
#       "kings please", "Verona int pls", "your a priest, can you buff me?"
#
#   What it puts on them, really cast, a moment later (off its mount or out
#   of its form first, with its own mana):
#     * a priest: Power Word: Fortitude; Divine Spirit or Shadow Protection
#       when asked for by name;
#     * a mage: Arcane Intellect, to anyone with mana -- or to anyone who
#       asks for it by name;
#     * a druid: Mark of the Wild; Thorns when asked for by name;
#     * a paladin: Blessing of Kings, or Might (for those who hit things) or
#       Wisdom before it has Kings or when they have it already; Sanctuary
#       when asked for by name.
#   The core puts the rank they can have on someone low, and nothing goes
#   on anyone who has it already, or something it does not stack with.
#
#   Whether a bot does, and whether it says anything, is up to its chat
#   style (Style below): buff them and say so, buff them without a word,
#   say no, or let it go by. An ask said to everyone gets at most MaxGivers
#   bots buffing, each with something different, and MaxVoices saying
#   anything. An ask said to one bot -- named, whispered, the one they have
#   targeted, or the one they were just talking to -- is that bot's, and
#   one that can't may say why: it is a warrior, it is out of mana, they
#   have it already, it has not learned it yet. Asked for another class's
#   buff ("fort pls" to a mage), it puts its own on them instead.
#
#   A thank-you soon after ("ty", "thanks Verona", "cheers for the buff")
#   is answered by the one who gave it, or not at all, and nobody else: that
#   is the end of it.
#
#   Not answered here: bots in their group and bots they are master of
#   (playerbots keeps its own group buffed; "buff us" in party chat is an
#   order), the other faction, a battleground or arena, and anyone AFK,
#   fighting or flying.
#
#   Word lists are separated by |, matched lowercase with punctuation and
#   apostrophes dropped; a trailing * matches any word starting with it.
#
###############################################################################

#    OllamaChat.Buff.Enable
#        Default: 1
OllamaChat.Buff.Enable = 1

#    OllamaChat.Buff.Words.Fort
#    OllamaChat.Buff.Words.Spirit
#    OllamaChat.Buff.Words.Shadow
#    OllamaChat.Buff.Words.Int
#    OllamaChat.Buff.Words.Mark
#    OllamaChat.Buff.Words.Thorns
#    OllamaChat.Buff.Words.Kings
#    OllamaChat.Buff.Words.Might
#    OllamaChat.Buff.Words.Wisdom
#    OllamaChat.Buff.Words.Sanctuary
#        The words for each buff. Those marked ~ are ordinary words too
#        ("might", "mark", "int"), so they only count in a short line, six
#        words at most, that asks for it, is nothing but it ("fort?"), or is
#        said to a bot by name.
OllamaChat.Buff.Words.Fort = "fortitude|power word fortitude|pw fort|pwf|pw f|fort buff|stam buff|stamina buff|~fort|~stam|~stamina"
OllamaChat.Buff.Words.Spirit = "divine spirit|spirit buff|~spirit"
OllamaChat.Buff.Words.Shadow = "shadow protection|shadow prot|sprot|shadow resist buff|shadow res buff"
OllamaChat.Buff.Words.Int = "intellect|arcane intellect|arcane int|int buff|ai buff|~int|~ai"
OllamaChat.Buff.Words.Mark = "mark of the wild|mark of wild|motw|mark buff|~mark"
OllamaChat.Buff.Words.Thorns = "thorns buff|~thorns"
OllamaChat.Buff.Words.Kings = "blessing of kings|bok|kings buff|~kings|~king"
OllamaChat.Buff.Words.Might = "blessing of might|bom|might buff|~might"
OllamaChat.Buff.Words.Wisdom = "blessing of wisdom|wisdom buff|~wisdom|~wis"
OllamaChat.Buff.Words.Sanctuary = "blessing of sanctuary|sanctuary|sanc buff|~sanc|~sanct"

#    OllamaChat.Buff.Class.Priest
#    OllamaChat.Buff.Class.Mage
#    OllamaChat.Buff.Class.Druid
#    OllamaChat.Buff.Class.Paladin
#        A class named in the ask ("priest can i get a buff", "pally buff
#        pls"): what is asked for when no buff is named, and who the bot was
#        taken for -- a mage asked "your a priest, can you buff me?" hears it.
OllamaChat.Buff.Class.Priest = "priest|priests|preist|preists|priestess"
OllamaChat.Buff.Class.Mage = "mage|mages|magey|wizard"
OllamaChat.Buff.Class.Druid = "druid|druids|dudu|drood|droods"
OllamaChat.Buff.Class.Paladin = "paladin|paladins|pally|pallys|pallies|pala|pali|paly"

#    OllamaChat.Buff.BuffWords
#        "A buff", whichever.
OllamaChat.Buff.BuffWords = "buff|buffs|buffz|bufs|buf|buffage|rebuff|rebuffs|buffing"

#    OllamaChat.Buff.NotBuffWords
#        A line with one of these is not asking anyone to cast a buff: food,
#        flasks and world buffs are no spell anyone casts on you, "nerf" is
#        balance talk, and "mark skull" is a raid mark.
OllamaChat.Buff.NotBuffWords = "food buff*|buff food|well fed|world buff*|wbuff*|ony buff|rend buff|zg buff|dmf buff*|darkmoon*|songflower*|buff pot*|potion*|pots|elixir*|flask*|scroll*|runescroll*|drum|drums|debuff*|nerf*|skull|cross|moon|square|triangle|diamond|circle|star|raid mark*"

#    OllamaChat.Buff.AskWords
#    OllamaChat.Buff.PoliteWords
#    OllamaChat.Buff.NeedWords
#        Asking for one; asking nicely; and needing one, which counts only as
#        their own need, right before the buff ("need a buff", "i could use
#        fort") -- never "warriors need a buff", which is about the game.
OllamaChat.Buff.AskWords = "lf|looking for|can i get|can i have|can i grab|could i get|could i have|could i grab|may i have|may i get|give me|giv me|gimme|gimmie|gib|gief|hook me up|hook us up|buff me|buff us|chuck me|toss me|throw me|spare a|spare me|got any|have any|any spare|anyone got|anyone have|anybody got|anybody have|any1 got|any1 have|you got|u got|ya got|do you have|do u have|can someone|can anyone|could someone|could anyone|would someone|would anyone|someone buff|somebody buff|anyone buff|anybody buff|anyone buffing|any buffers"
OllamaChat.Buff.PoliteWords = "pls|plz|please|pleas|plox|plis|pl0x|ples|plx|can you|can u|could you|could u|would you|would u|will you|will u|how about|mind"
OllamaChat.Buff.NeedWords = "need|needs|neeed|nid|want|wanna|could use|could do with|really use|rly use|really do with|would love|would like|id love|id like"

#    OllamaChat.Buff.OfferWords
#        Offering, not asking: "anyone need fort?", "who wants buffs", "im
#        buffing". So is a line ending in "anyone" ("buffs anyone?"), and one
#        asking for a buff of the speaker's own class (a priest's "fort?").
OllamaChat.Buff.OfferWords = "anyone need|anybody need|any1 need|anyone want|anybody want|any1 want|who needs|who wants|whos need|whos want|free buff*|buffs here|buffing here|giving buffs|giving out|handing out|im buffing|i can buff|ill buff|i will buff|let me buff|lemme buff|buffs for|buff for anyone"

#    OllamaChat.Buff.NegationWords
#    OllamaChat.Buff.HaveWords
#    OllamaChat.Buff.QuestionWords
#        Not asking: a negation before the buff ("dont need buffs"; a "no" up
#        front is fine unless the buff follows it at once), having it ("i
#        have fort", "im buffed", but not the "i have" in "can i have"), or a
#        question about it ("what does kings do") -- the last only without an
#        ask word.
OllamaChat.Buff.NegationWords = "not|dont|didnt|doesnt|no|nope|nah|never|without|aint|isnt|arent|havent|wont"
OllamaChat.Buff.HaveWords = "i have|i got|ive got|i still have|still have|already have|already got|already buffed|im buffed|im all buffed|all buffed|got all|have all|got plenty|im good|im fine|im set|all good|enough"
OllamaChat.Buff.QuestionWords = "what|where|why|when|which|how|whats|wheres|whys|hows"

#    OllamaChat.Buff.ThanksWords
#    OllamaChat.Buff.ThanksMaxWords
#    OllamaChat.Buff.ThanksSeconds
#        A thank-you: a line of at most ThanksMaxWords words with one of
#        these in it, not "no thanks" and not a question. Within
#        ThanksSeconds of a buff it is for the buff: the one who gave it may
#        answer, nobody else does. Never an ask either ("ty for the buff").
#        Default: 8, 120
OllamaChat.Buff.ThanksWords = "ty|thx|thnx|thanks|thank you|thank u|tyvm|tysm|tyty|cheers|ta|appreciate*|much appreciated|lifesaver"
OllamaChat.Buff.ThanksMaxWords = 8
OllamaChat.Buff.ThanksSeconds = 120

#    OllamaChat.Buff.CommandWords
#        A line starting with one of these is never an ask: playerbots acts
#        on its own commands itself ("cast fort", "c Arcane Intellect").
OllamaChat.Buff.CommandWords = "cast|castnc|c|nc|co|use|t|nt|b|s|e|ue|de|q|ll|ss|rti|rtsc"

#    OllamaChat.Buff.MaxWords
#        Longer lines are conversation, not asks.
#        Default: 14
OllamaChat.Buff.MaxWords = 14

#    OllamaChat.Buff.MaxGivers
#    OllamaChat.Buff.MaxVoices
#        An ask said to everyone: how many bots may buff them (1 to 5, each
#        with something different), and how many may say anything (0 to 5),
#        a no included. One says no at most.
#        Default: 2, 2
OllamaChat.Buff.MaxGivers = 2
OllamaChat.Buff.MaxVoices = 2

#    OllamaChat.Buff.DelayMinMs
#    OllamaChat.Buff.DelayMaxMs
#        How long a bot takes to cast it, picked between these; a second buff
#        from the same bot follows a global cooldown later.
#        Default: 1500, 4500
OllamaChat.Buff.DelayMinMs = 1500
OllamaChat.Buff.DelayMaxMs = 4500

#    OllamaChat.Buff.RememberSeconds
#        A bot that said no to someone, or let their ask go by, does the same
#        with the next one said to everyone for this long, rather than being
#        asked until it gives in. Asked by name, it decides afresh.
#        Default: 90
OllamaChat.Buff.RememberSeconds = 90

#    OllamaChat.Buff.SkipPvp
#        1: nobody flagged for PvP is buffed by a bot that is not (buffing
#        them would flag it); asked by name, it says so.
#        Default: 1
OllamaChat.Buff.SkipPvp = 1

#    OllamaChat.Favor.Strangers
#        1: bots trade with people outside their group too -- conjured food
#        and water (Conjure.*), a spare thing from their bags (Bags.*), what
#        they agreed to buy or said yes to (Gifts.*) -- asked by name, by
#        whisper, or (water) of everyone near in /say. Each takes it its own
#        way, by the Style below. Playerbots turns down any trade with someone
#        outside a bot's group, so while one is on, or about to be (they are
#        close, with water waiting or a deal agreed), the bot's playerbots AI
#        is held and its side of the trade is accepted for it; a fight calls
#        it off. 0: someone outside the group is told to invite the bot first.
#        Default: 1
OllamaChat.Favor.Strangers = 1

#    OllamaChat.Buff.Style.Default
#    OllamaChat.Buff.Style.<KEY>
#        How each chat style takes a favour asked of it -- a buff, and from
#        someone outside its group conjured food or water or something spare
#        from its bags (Favor.Strangers). give, quiet, no and ignore
#        are weights: do it and say so, do it without a word, say no, or
#        let it go by (asked in particular, letting it go by is half
#        as likely). explain is the percent chance one asked in particular
#        that can't says why; welcome the percent chance the one who gave it
#        answers the thank-you. A style without a line of its own uses
#        Default, and a line only needs what differs from it.
#        Default: "give:35|quiet:40|no:5|ignore:20|explain:60|welcome:70"
OllamaChat.Buff.Style.Default = "give:35|quiet:40|no:5|ignore:20|explain:60|welcome:70"
OllamaChat.Buff.Style.NAT_FRIENDLY = "give:50|quiet:40|no:0|ignore:10|explain:80|welcome:90"
OllamaChat.Buff.Style.NAT_SOCIAL = "give:60|quiet:25|no:0|ignore:15|explain:80|welcome:95"
OllamaChat.Buff.Style.NAT_BUTTERFLY = "give:70|quiet:15|no:0|ignore:15|explain:80|welcome:100"
OllamaChat.Buff.Style.NAT_HELPFUL_VET = "give:30|quiet:60|no:0|ignore:10|explain:70|welcome:70"
OllamaChat.Buff.Style.NAT_EXPERT = "give:45|quiet:40|no:0|ignore:15|explain:90|welcome:70"
OllamaChat.Buff.Style.NAT_PROPER = "give:50|quiet:35|no:0|ignore:15|explain:80|welcome:90"
OllamaChat.Buff.Style.NAT_ROLEPLAYER = "give:60|quiet:20|no:0|ignore:20|explain:70|welcome:90"
OllamaChat.Buff.Style.NAT_NEWBIE = "give:50|quiet:20|no:0|ignore:30|explain:70|welcome:90"
OllamaChat.Buff.Style.NAT_EXCITABLE = "give:65|quiet:15|no:0|ignore:20|explain:70|welcome:90"
OllamaChat.Buff.Style.NAT_HYPE = "give:65|quiet:15|no:0|ignore:20|explain:70|welcome:90"
OllamaChat.Buff.Style.NAT_GOSSIP = "give:55|quiet:20|no:5|ignore:20|explain:70|welcome:80"
OllamaChat.Buff.Style.NAT_PETLOVER = "give:40|quiet:45|no:0|ignore:15|explain:60|welcome:80"
OllamaChat.Buff.Style.NAT_CHILL = "give:40|quiet:45|no:0|ignore:15|explain:60|welcome:80"
OllamaChat.Buff.Style.NAT_JOKER = "give:50|quiet:20|no:10|ignore:20|explain:60|welcome:70"
OllamaChat.Buff.Style.NAT_BANTER = "give:50|quiet:20|no:10|ignore:20|explain:60|welcome:70"
OllamaChat.Buff.Style.NAT_PRANKSTER = "give:50|quiet:20|no:10|ignore:20|explain:60|welcome:70"
OllamaChat.Buff.Style.NAT_TERSE_VET = "give:15|quiet:60|no:5|ignore:20|explain:40|welcome:50"
OllamaChat.Buff.Style.NAT_QUIET = "give:10|quiet:60|no:0|ignore:30|explain:40|welcome:50"
OllamaChat.Buff.Style.NAT_LONER = "give:10|quiet:45|no:5|ignore:40|explain:30|welcome:40"
OllamaChat.Buff.Style.NAT_GRUMBLER = "give:35|quiet:30|no:15|ignore:20|explain:70|welcome:50"
OllamaChat.Buff.Style.NAT_CONTRARIAN = "give:30|quiet:20|no:30|ignore:20|explain:60|welcome:50"
OllamaChat.Buff.Style.NAT_GOLDMAKER = "give:20|quiet:20|no:30|ignore:30|explain:50|welcome:50"
OllamaChat.Buff.Style.NAT_PVPER = "give:30|quiet:30|no:15|ignore:25|explain:50|welcome:50"
OllamaChat.Buff.Style.NAT_TROLL = "give:30|quiet:15|no:25|ignore:30|explain:50|welcome:50"
OllamaChat.Buff.Style.NAT_RUDE = "give:10|quiet:20|no:40|ignore:30|explain:40|welcome:20"

#    OllamaChat.Buff.ClassNotes
#        Why a class that has no buff for anyone outside its group has none,
#        for the bot to say when it is asked: "class:why" pairs.
OllamaChat.Buff.ClassNotes = "warrior:your shouts only reach your own group|rogue:a rogue has no buffs to give anyone|hunter:your aspects and Trueshot Aura only help you and your own group|shaman:your totems only help your own group|warlock:a warlock has nothing like that to give, bar Unending Breath|death knight:Horn of Winter only reaches your own group"

#    OllamaChat.Buff.HintGive
#    OllamaChat.Buff.HintInstead
#    OllamaChat.Buff.HintNo
#    OllamaChat.Buff.HintCant
#    OllamaChat.Buff.HintThanks
#        What the bot is told when it answers: it is buffing them; it is
#        putting its own buff on them, asked for another class's; it won't;
#        it can't; it is answering their thank-you. Placeholders:
#        {player_name}; {request} (what they asked for: "a buff", "Power
#        Word: Fortitude", "a blessing"); {buff} (what it is casting, or
#        could: "Blessing of Kings"); {reason} ("you are out of mana", "they
#        have Mark of the Wild already"); {class} and {asked_class} ("a
#        mage", "a priest"); {took_for} (" They took you for a priest, but
#        you are a mage." or nothing).
OllamaChat.Buff.HintGive = "{player_name} asked for {request}, and you are casting {buff} on them now, for nothing.{took_for} Say so in one to five words, in your own chat style."
OllamaChat.Buff.HintInstead = "{player_name} asked for {request}, but that is {asked_class}'s to give, and you are {class}: you are casting your own {buff} on them instead, for nothing. Say so in a few words, in your own chat style."
OllamaChat.Buff.HintNo = "{player_name} asked for {request}. You could put {buff} on them, but you are not going to.{took_for} Say no in a few words, in your own chat style, with or without a reason."
OllamaChat.Buff.HintCant = "{player_name} asked for {request}, but you can't give them one: {reason}.{took_for} Say so in a few words, in your own chat style."
OllamaChat.Buff.HintThanks = "You just put {buff} on {player_name}, and they said thanks. Answer in one to three words, in your own chat style, and leave it there."

###############################################################################
#
#   OLLAMA CHAT - ORDERS IN PLAIN WORDS
#
#   A real player tells the bots what to do the way they would tell anyone,
#   in party, raid or a whisper, and the bot it was for does it and says so
#   in its own words instead of a stock "Staying":
#
#       "stay back", "wait here", "hold position"    stay where you are
#       "follow me", "come with me", "on me"         follow
#       "attack my target", "kill that", "focus it"  attack what you target
#       "run!", "fall back", "get out of there"      break off and come back
#       "release", "res", "respawn", "run back"      (to the dead) get back up
#       "come trade me", "open a trade"              come over and trade
#       "hearth out", "use your hearthstone"         hearth home
#       "you're stuck", "use unstuck"                the stuck tool
#       "buffs pls", "rebuff"                        buff the group
#       "pull", "pull when ready"                    (the tank) pull
#       "Joanni leave the group"                     leave
#       "go grind", "kill stuff", "farm some mobs"   fight whatever is around
#
#   Who it is for: the bots it names ("Joanni stay", "Frostiq and Zonin wait
#   here"), else the bot it was whispered to, else every bot in the group that
#   takes orders from you (your own bots, or all of them when you lead). Trade,
#   unstuck and leave are for one bot: named, whispered, or plainly the one you
#   were just talking to -- "come trade me" with four bots around and nobody
#   in particular is just chat. Hearth takes them out of wherever you are, so
#   it needs a name, a whisper or "everyone": a bare "hearth" or "brb hearth"
#   is as often your own plan. In a dungeon-clear run the run decides how its
#   dead come back, so "res" there is just chat. A real player named first
#   ("Bob, wait here") is theirs to answer.
#
#   An order is a short line that is one of the phrases below and little
#   else: names, fillers ("pls", "now", "mate"), "can you", "everyone", and at
#   most MaxStray other words. So "stay here while i grab the quest" is an
#   order and "we should stay here and fight" is not. Not orders: anything
#   asked rather than told ("should we wait here?", "why are you staying"),
#   negated ("dont stay here", "no need to wait"), conditional ("if it runs,
#   kill it"), about yourself or someone else ("ill wait here", "gonna
#   hearth", "they attack"), or a line that tells the bots two different
#   things ("follow me and stay here"). "can you wait here?" is still an
#   order, and so is asking for buffs or a trade ("i need buffs").
#
#   What each one does: stay, follow, attack, flee, release, rebuff, pull,
#   leave and grind are playerbots' own commands, sent from you a tick after
#   you spoke ("follow me" ends a grind). Not inside a dungeon, where the
#   group fights what is pulled.
#   Trade walks the bot over (it follows you) and offers the trade once it is
#   close. Hearth uses the bot's hearthstone. Unstuck does what the stuck tool
#   does for a player -- in a dungeon or raid back to its entrance, outside
#   to the nearest graveyard -- and the bot walks back from there; nothing is
#   ever summoned. After "run!" the bots keep out of fights (that is what
#   playerbots' flee is) until FleeRecoverSeconds after the fight, then fight
#   again; any other order ("attack my target") ends it at once.
#
#   When a bot can't -- it is dead, you have nothing targeted, its
#   hearthstone is on cooldown, it is not the tank -- it says so. And when a
#   line reads like telling it to do something none of these is ("spread
#   out", "go sell your junk"), it does not say "on it": with a
#   Playerbots.CommandPrefix set nothing else would have carried it out
#   either (NotDoneVerbs, HintNotDone).
#
#   Playerbots.CommandPrefix. With it empty (the default), playerbots also
#   reads every line in party and whispers as a command of its own: "stay
#   here" is its "stay", "leave it" makes a bot leave the group, "go ahead"
#   walks every bot off, "buff me" whispers you its buff potions. An order it
#   is already carrying out is only answered here, never sent twice, and one
#   it read differently ("stay close" is its "stay") is put right once it has
#   carried out its own reading, a second or so later, and checked again for
#   a few seconds after. Setting a prefix, e.g. Playerbots.CommandPrefix = "!", ends all of
#   that: plain chat is then only ever chat or an order from this list, and
#   playerbots' commands still work typed with the prefix ("!summon"). Lines
#   starting with the prefix get no chat replies. Addons that send playerbots
#   commands for you (MultiBot and the like) need the prefix too.
#
#   In a dungeon with a dungeon-clear tank, "stay here" and "wait" pause the
#   run instead (PARTY INSTRUCTIONS above). When a run starts or carries on,
#   every bot in the group that was told to stay follows again, however it
#   was told: a bot left staying put would hold back the run.
#
#   Phrase lists are separated by |; words are matched lowercase with
#   punctuation and apostrophes dropped; a trailing * matches any word
#   starting with it; a leading = means the whole order must be exactly
#   that ("=run" is "run!" but not "run it again").
#
###############################################################################

#    OllamaChat.Orders.Enable
#        Default: 1
OllamaChat.Orders.Enable = 1

#    OllamaChat.Orders.Stay
#    OllamaChat.Orders.Follow
#    OllamaChat.Orders.Attack
#    OllamaChat.Orders.Flee
#    OllamaChat.Orders.Revive
#    OllamaChat.Orders.Trade
#    OllamaChat.Orders.Hearth
#    OllamaChat.Orders.Unstuck
#    OllamaChat.Orders.Buff
#    OllamaChat.Orders.Pull
#    OllamaChat.Orders.Leave
#    OllamaChat.Orders.Grind
#    OllamaChat.Orders.Resume
#        The phrases for each order. When phrases of two orders both fit a
#        line, the one covering more of it wins ("stay close" is follow);
#        a tie is not an order.
#
#        Resume ("carry on", "do your thing", "go do your quest", "lead the
#        way", "ill follow you"): outside a dungeon, a random bot goes back to
#        what it does on its own -- playerbots' new rpg (or rpg, or moving at
#        random, as its config has it) with grinding -- and stops following
#        or staying put. It stays in the group, so the player can tag along;
#        "follow me" puts it back to following. Said to one bot (by name,
#        whispered, or the one being talked to) unless said to everyone
#        ("guys, carry on"). Its own routine sometimes takes a flight path or
#        heads for another zone, as it would on its own. In a dungeon these
#        lines are ordinary chat. "=on" is "go on": "go" is a filler.
OllamaChat.Orders.Stay = "=stay|=hold|stay here|stay there|stay back|stay put|stay behind|stay where you are|stay where u are|stay right there|stay right here|wait here|wait there|wait right here|wait right there|wait back|wait for me|wait for me here|wait for me there|hold here|hold there|hold position|hold your position|hold up here|stand here|stand there|stand still|stand back|dont move|do not move|stop following|quit following|hang back|camp here|park here|park up"
OllamaChat.Orders.Follow = "=follow|follow me|follow us|come with me|come with us|come w me|=with me|=on me|come here|come over here|=over here|get over here|come back|come back here|come to me|regroup|regroup on me|=this way|move out|lets move|keep up|catch up|follow again|start following|you can follow|come along|tag along|stick with me|stay with me|stay close|stay close to me|get back here|=get back"
OllamaChat.Orders.Attack = "attack|attack my target|attack that|attack it|attack him|attack her|attack them|attack this|kill it|kill that|kill him|kill her|kill them|kill this|kill my target|get him|get her|focus my target|focus that|focus it|focus him|focus her|assist me|dps that|dps it|nuke it|nuke that|burn it|burn that|take it down|take that down"
OllamaChat.Orders.Flee = "=run|=run run|run away|flee|retreat|fall back|get out|get out of there|get out of here|back off|abort|leg it|scatter"
OllamaChat.Orders.Revive = "release|=res|=rez|res up|rez up|respawn|=spawn|run back|run back here|corpse run|get up|get back up|come back to life|=revive|revive yourself|resurrect|back to your body|go get your body|get your corpse"
OllamaChat.Orders.Trade = "=trade|trade me|come trade me|come trade|open trade|open a trade|lets trade|trade with me|come and trade|come and trade me|come over and trade"
OllamaChat.Orders.Hearth = "hearth|hearth out|hearth home|hearth back|use your hearth|use your hearthstone|use your hs|use hearth|use hearthstone|=hs|hs out|hs home|hearthstone out"
OllamaChat.Orders.Unstuck = "unstuck|use unstuck|use the unstuck|get unstuck|unstuck yourself|youre stuck|ur stuck|you are stuck|youre stuck in|ur stuck in|you are stuck in|youre stuck on|ur stuck on"
OllamaChat.Orders.Buff = "=buff|=buffs|buff me|buff us|rebuff|need buffs|buff up|buff everyone|buff the group|can i get a buff|can i get buffs"
OllamaChat.Orders.Pull = "=pull|pull it|pull that|pull them|you can pull|pull when ready|start pulling|tank pull|pull the next|pull next"
OllamaChat.Orders.Leave = "leave the group|leave group|leave the party|leave party|you can leave|you can leave now|drop group|drop party"
OllamaChat.Orders.Grind = "=grind|grind mobs|grind some mobs|grind here|grind for a bit|grind a bit|start grinding|keep grinding|you can grind|kill stuff|kill some stuff|kill some mobs|kill things|kill everything|kill everything here|farm mobs|farm some mobs|=farm|go farm|go level|level up a bit|fight stuff|clear the area|clear this area|clear the camp|spread out and grind|spread out and kill stuff"
OllamaChat.Orders.Resume = "carry on|=resume|resume what you were doing|go back to what you were doing|back to what you were doing|get back to what you were doing|do what you were doing|go do what you were doing|do your thing|do your own thing|go do your thing|go do your own thing|you do you|do your quest|do your quests|go do your quest|go do your quests|go do that|go do it|=on|on you go|off you go|be on your way|go about your business|crack on|get on with it|get on with your quest|get on with your quests|as you were|lead the way|lead on|you lead|you lead the way|ill follow you|i will follow you|ill follow|ill tag along|ill come with you|ill go with you|dont mind me|dont let me stop you|dont let me keep you"

#    OllamaChat.Orders.Fillers
#    OllamaChat.Orders.Polite
#    OllamaChat.Orders.Everyone
#        Words that go with any order without changing it ("stay here pls",
#        "can you wait here", "everyone on me").
OllamaChat.Orders.Fillers = "pls|plz|please|pleas|plox|now|right now|here|there|then|again|quick|quickly|asap|for now|for a sec|a sec|for a second|a second|a moment|for a moment|a minute|for a minute|a bit|for a bit|ok|okay|k|kk|alright|right|yeah|yes|you|u|ya|ye|mate|m8|buddy|man|dude|bro|hun|hon|thanks|ty|cheers|too|as well|also|just|real quick|rq|lol|go|ahead|go ahead|the|a"
OllamaChat.Orders.Polite = "can you|can u|could you|could u|would you|would u|will you|will u|can ya|could ya|pls|plz|please|do you mind|would you mind|mind|wanna"
OllamaChat.Orders.Everyone = "everyone|everybody|every1|evry1|all|yall|you all|u all|guys|you guys|u guys|team|group|lads|people|ppl|folks|party|squad"

#    OllamaChat.Orders.Negations
#    OllamaChat.Orders.Questions
#    OllamaChat.Orders.Conditions
#        Not an order: "dont stay here", "should we wait here", "if it runs,
#        kill it". A negation inside a phrase is the order ("dont move"), and
#        a "no" up front is emphasis ("no, stay here"). A question is still an
#        order when asked nicely ("can you wait here?").
OllamaChat.Orders.Negations = "dont|do not|didnt|doesnt|never|no need to|no need|not|stop|quit|nah|nope"
OllamaChat.Orders.Questions = "why|where|what|when|how|who|whos|whats|wheres|hows|whys|should|shall|are|is|do|does|did|was|were|have|has|wonder"
OllamaChat.Orders.Conditions = "if|unless|whenever|once|incase|in case"

#    OllamaChat.Orders.Separators
#        Where a line splits into parts, each judged on its own: "stay here
#        while i loot" is a stay; two parts with two different orders are
#        neither.
OllamaChat.Orders.Separators = "and|while|whilst|till|until|then|but|so|cause|cuz|coz|because|bc|or"

#    OllamaChat.Orders.Subjects
#        Who does it, when it is not the bots: you ("ill wait here", "gonna
#        hearth") or someone else ("they attack"). One of these outside the
#        order's own words makes the line talk, not an order. Asking for buffs
#        or a trade is still asking ("i need buffs", "can i get a buff"), and
#        "we" takes the bots in ("we wait here").
OllamaChat.Orders.Subjects = "i|im|ill|ive|id|imma|ima|gonna|gotta|he|hes|she|shes|they|theyre|theyll|theyve"

#    OllamaChat.Orders.MaxWords
#    OllamaChat.Orders.MaxStray
#        Longer lines are conversation. MaxStray is how many words in an
#        order may be none of the above ("stay here while i grab the quest").
#        Default: 14, 1
OllamaChat.Orders.MaxWords = 14
OllamaChat.Orders.MaxStray = 1

#    OllamaChat.Orders.HintStay
#    OllamaChat.Orders.HintFollow
#    OllamaChat.Orders.HintAttack
#    OllamaChat.Orders.HintFlee
#    OllamaChat.Orders.HintRevive
#    OllamaChat.Orders.HintTrade
#    OllamaChat.Orders.HintHearth
#    OllamaChat.Orders.HintUnstuck
#    OllamaChat.Orders.HintBuff
#    OllamaChat.Orders.HintPull
#    OllamaChat.Orders.HintLeave
#    OllamaChat.Orders.HintGrind
#    OllamaChat.Orders.HintResume
#    OllamaChat.Orders.HintCant
#        What the bot answering is told. One bot answers for everyone it was
#        for -- the tank when it is one of them. Placeholders: {player_name};
#        {who} ("you", or "you and the others"); {target} (what they have
#        targeted); {doing} (HintTrade: "coming over to trade with them" or
#        "opening a trade window with them"; HintRevive: "releasing your spirit
#        to run back to your body" or "already running back"); {where}
#        (HintUnstuck: "back at the entrance of the dungeon", "at the nearest
#        graveyard"); {doing} for HintResume ("your quests, with a bit of
#        grinding on the way"); {order} and {reason} (HintCant: "use your
#        hearthstone", "your hearthstone is still on cooldown"). Empty: the
#        order is carried out without a word.
OllamaChat.Orders.HintStay = "{player_name} told {who} to stay put, and you are doing it: you will wait right here until they say to follow again. Say so in a few words, in your own chat style, the way you would tell them to give you a shout when they want you following again."
OllamaChat.Orders.HintFollow = "{player_name} told {who} to follow them, and you are on your way. Say so in two to six words, in your own chat style."
OllamaChat.Orders.HintAttack = "{player_name} told {who} to attack {target}, and you are going in. Say so in two to five words, in your own chat style."
OllamaChat.Orders.HintFlee = "{player_name} told {who} to get out of the fight, so you are breaking off and running back to them. Say so in two to five words, in your own chat style."
OllamaChat.Orders.HintRevive = "You died, and {player_name} told you to get yourself back up: you are {doing}. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintTrade = "{player_name} asked you to trade with them, and you are {doing}. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintHearth = "{player_name} told {who} to use your hearthstone, so you are hearthing home now. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintUnstuck = "You were stuck, and {player_name} told you to use the unstuck option. You have: in a moment you will be {where}, and you will make your way back from there. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintBuff = "{player_name} asked for buffs, and you are buffing the group now. Say so in two to five words, in your own chat style."
OllamaChat.Orders.HintPull = "{player_name} told you to pull, and you are pulling {target} now. Say so in two to five words, in your own chat style."
OllamaChat.Orders.HintLeave = "{player_name} said you can leave the group, so you are leaving now. Say a short goodbye, in your own chat style."
OllamaChat.Orders.HintGrind = "{player_name} told {who} to go off and grind, so you are going to fight whatever is around here for a while. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintResume = "{player_name} told {who} to get on with what you were doing before, so you are heading off to {doing} -- still in their group, and they can tag along if they like. Say so in a few words, in your own chat style."
OllamaChat.Orders.HintCant = "{player_name} asked you to {order}, but you cannot right now: {reason}. Say so in a few words, in your own chat style."

#    OllamaChat.Orders.TradeWalkSeconds
#        How long a bot told to come and trade keeps coming before it gives
#        up (you walked off, it could not get to you).
#        Default: 20
OllamaChat.Orders.TradeWalkSeconds = 20

#    OllamaChat.Orders.FleeRecoverSeconds
#        After "run!", how long the bots and you have to be out of combat
#        before they fight again.
#        Default: 8
OllamaChat.Orders.FleeRecoverSeconds = 8

#    OllamaChat.Orders.NotDoneVerbs
#    OllamaChat.Orders.HintNotDone
#        A short line from someone a bot takes orders from (in party, raid or
#        a whisper, no question mark) that starts with one of NotDoneVerbs
#        and is none of the orders above has not been carried out, so the
#        bot's reply is told not to say it is on it (HintNotDone,
#        {player_name}). Only for a plain reply: a line anything here acted
#        on (an order, a favour, the run) is answered with what was done
#        instead. Only with Playerbots.CommandPrefix set: without one,
#        playerbots may have read the line as a command of its own. A plain
#        yes ("go on then", Party.ReadyYesPhrases) is not an order. Single
#        words, separated by |. Empty disables.
#        Default: (below)
OllamaChat.Orders.NotDoneVerbs = "go|come|spread|kill|farm|grind|loot|sell|repair|mount|dismount|follow|stay|wait|attack|pull|heal|tank|run|move|use|drink|eat|craft|mine|gather|pick|open|clear|fetch|bring|jump|dance|sit|stand|hurry|fight|stop|leave|join|invite|buff|summon|accept|equip|wear|drop|destroy|learn|train|fly|ride|swim|hide|stealth|sap|mark|focus|assist|reset|hearth|unstuck|release"
OllamaChat.Orders.HintNotDone = "If {player_name} just told you to do something, you are not doing it: nothing in the game has made you. So do not say you are on it or that you are doing it; say plainly you cannot from here, or answer it some other way, in your own chat style."

#    OllamaChat.State.Staying
#    OllamaChat.State.OwnWay
#        Added to the prompt of a bot told to stay (Staying), or to carry on
#        with its own thing (OwnWay), so "why aren't you coming?" gets a real
#        answer. {player_name}: who it takes orders from. Empty disables.
OllamaChat.State.Staying = "Right now you are waiting where {player_name} told you to stay, until they tell you to follow again."
OllamaChat.State.OwnWay = "Right now you are off doing your own thing -- questing and grinding -- because {player_name} told you to, instead of following them. You are still in their group, and they may be tagging along."

###############################################################################
#
#   OLLAMA CHAT - MUTED BOT LINES
#
#   Playerbots whispers a stock line for a lot of what bots do: "Using
#   [Hearthstone]", "AI was reset to defaults", "Staying", "Following",
#   "Hello!", every kill a quest wants. mod-playerbots-plus mutes them
#   (PlayerbotsPlus.Mute.* in its conf), and the bots here say most of them
#   in their own words instead (ORDERS, JOINING A GROUP, QUEST PROGRESS IN
#   PARTY), so give it the longer list its conf has for a realm with this
#   module. What this module sends for a bot -- the model's lines, a canned
#   "gz" -- is never muted, so "Hi" on that list mutes playerbots' stock "Hi"
#   whisper on joining a group but never a bot's own "hi".
#
###############################################################################

###############################################################################
#
#   OLLAMA CHAT - NEW GEAR
#
#   Playerbots whispers its master "Equipping [Lorekeeper's Ring]" for every
#   piece a bot puts on (mod-playerbots-plus mutes that). A player with a
#   nice drop doesn't announce every ring, but with a rare or an epic they
#   might say so in party, or might not, depending on who they are. So a bot
#   in a group with a real player that puts on a rare or epic it got in the
#   last LootedMinutes -- loot, a roll it won, a quest reward; never gear
#   playerbots handed it -- may say so in party in its own words: "aww yes,
#   [Gloves of the Fang] going straight on". How likely depends on its chat
#   style (Personalities, or Chance for one not listed), at most once every
#   BotCooldownMinutes per bot and one bot every GroupCooldownSeconds per
#   group. In a fight it waits until the fight is over.
#
###############################################################################

#    OllamaChat.Equip.Enable
#        Default: 1
OllamaChat.Equip.Enable = 1

#    OllamaChat.Equip.MinQuality
#        3 rare (blue) and up, 4 epic and up.
#        Default: 3
OllamaChat.Equip.MinQuality = 3

#    OllamaChat.Equip.Chance
#    OllamaChat.Equip.Personalities
#        Percent chance a bot says so: by chat style (KEY:chance, separated by
#        |; 0 never), or Chance for a style not listed.
#        Default: 20, (below)
OllamaChat.Equip.Chance = 20
OllamaChat.Equip.Personalities = "NAT_HYPE:90|NAT_EXCITABLE:90|NAT_BUTTERFLY:70|NAT_NEWBIE:70|NAT_SOCIAL:60|NAT_FRIENDLY:50|NAT_MINMAXER:50|NAT_RAIDER:50|NAT_JOKER:45|NAT_BANTER:45|NAT_GOLDMAKER:40|NAT_PRANKSTER:40|NAT_REACTOR:40|NAT_PVPER:40|NAT_TROLL:30|NAT_KEYBOARD:30|NAT_GRUMBLER:20|NAT_CONTRARIAN:20|NAT_LOWERCASE:20|NAT_ABBREVIATOR:20|NAT_ROLEPLAYER:20|NAT_NOSTALGIC:20|NAT_CHILL:15|NAT_DEADPAN:10|NAT_PROPER:10|NAT_HELPFUL_VET:10|NAT_TERSE_VET:5|NAT_QUIET:0|NAT_LONER:0"

#    OllamaChat.Equip.BotCooldownMinutes
#    OllamaChat.Equip.GroupCooldownSeconds
#    OllamaChat.Equip.LootedMinutes
#        Default: 20, 90, 10
OllamaChat.Equip.BotCooldownMinutes = 20
OllamaChat.Equip.GroupCooldownSeconds = 90
OllamaChat.Equip.LootedMinutes = 10

#    OllamaChat.Equip.Prompt
#        Placeholders: {bot_name}, {bot_level}, {bot_race}, {bot_class},
#        {bot_personality}, {item} ("[Gloves of the Fang]"), {what} ("a rare
#        pair of gloves", "an epic two-handed weapon").
OllamaChat.Equip.Prompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a group. Your chat style: {bot_personality} You just got {item}, {what}, and you are putting it on right now. Say so in party chat in your own way, the way players do with a nice bit of new gear: chuffed, excited, a quick finally, or showing it off, whatever suits you. Name it as {item}, once. One short line, 3 to 12 words, no quotes, no name in front."

###############################################################################
#
#   OLLAMA CHAT - JOINING A GROUP
#
#   Playerbots has a bot whisper "Hello" to whoever invited it, every time
#   (muted above). What people do instead:
#
#     * Invited out of the blue, they say hi in party chat -- "hey, whats
#       up?" and the like -- and of five invited at once, one says it
#       (GroupCooldownSeconds), and not every time (GreetChance).
#     * Invited after talking to them -- in General, in a whisper, out loud
#       nearby, in the last ContinueMinutes -- they carry on from that in
#       party chat ("right, deadmines then?") instead of saying hello to
#       someone they were just talking to (ContinuePrompt, always).
#     * Put together by the dungeon finder, nobody invited anyone: a quick
#       hello at most (LfgPrompt), never "where to?", and the tank says
#       nothing here -- its "everyone ready?" inside is its hello.
#
#   Only for a group with a real player in it; never for battleground raids.
#
###############################################################################

#    OllamaChat.Joined.Enable
#        Default: 1
OllamaChat.Joined.Enable = 1

#    OllamaChat.Joined.GreetChance
#        Percent of out-of-the-blue invites that get a hello at all.
#        Default: 70
OllamaChat.Joined.GreetChance = 70

#    OllamaChat.Joined.GroupCooldownSeconds
#        After one bot in a group said hi (or carried on), another invited
#        within this long says nothing.
#        Default: 60
OllamaChat.Joined.GroupCooldownSeconds = 60

#    OllamaChat.Joined.ContinueMinutes
#        Talked with someone in the group this lately: carry on from it.
#        Default: 10
OllamaChat.Joined.ContinueMinutes = 10

#    OllamaChat.Joined.CannedChance
#    OllamaChat.Joined.GreetLines
#        Percent of out-of-the-blue hellos typed straight from GreetLines
#        (separated by |, {name} the one greeted) without the model; the rest
#        come from GreetPrompt, in the bot's own chat style.
#        Default: 50
OllamaChat.Joined.CannedChance = 50
OllamaChat.Joined.GreetLines = "hey|hey, whats up?|hey whats up|hey hey|hi|hiya|heya|yo|sup|hey all|hi all|o/|whats up|hey, whats the plan?|hey whats the plan"

#    OllamaChat.Joined.GreetPrompt
#    OllamaChat.Joined.ContinuePrompt
#    OllamaChat.Joined.LfgPrompt
#        The prompts. Placeholders: {bot_name} {bot_level} {bot_race}
#        {bot_class} {bot_personality} {player_name} {player_level}
#        {player_class}; ContinuePrompt also {where} ("in a whisper", "in
#        General chat"), {player_line} (what they said) and {bot_line} (what
#        the bot answered).
OllamaChat.Joined.GreetPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} playing World of Warcraft. Your chat style: {bot_personality} {player_name}, a level {player_level} {player_class}, has just invited you to their group out of the blue, and you joined. Type the one short line you would say in party chat on joining, the way a real player does: 'hey, whats up?' or something like it, a few words, in your own style. Do not thank them for the invite, and do not guess what they want."
OllamaChat.Joined.ContinuePrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} playing World of Warcraft. Your chat style: {bot_personality} A moment ago, {where}, {player_name} said to you: '{player_line}' and you answered: '{bot_line}'. Now they have invited you to their group, and you joined. Type the one short line you would say in party chat now, carrying on from that, the way a real player would: a few words, in your own style. You have been talking already, so no hello, and do not thank them for the invite."
OllamaChat.Joined.LfgPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} playing World of Warcraft. Your chat style: {bot_personality} The dungeon finder has just put you in a group with {player_name} and a few others for a dungeon. Type the one short line you would say in party chat as the group forms, the way people do in a dungeon finder group: a quick hello at most, a few words, in your own style. You are all off to the same dungeon and the tank will start it, so do not ask where you are going or what the plan is."

#    OllamaChat.Joined.DelayMinMs
#    OllamaChat.Joined.DelayMaxMs
#        How long after joining it speaks: the moment it takes to type.
#        Default: 2000, 5000
OllamaChat.Joined.DelayMinMs = 2000
OllamaChat.Joined.DelayMaxMs = 5000

###############################################################################
#
#   OLLAMA CHAT - QUEST PROGRESS IN PARTY
#
#   Playerbots whispers its master every kill and every item a quest wants
#   ("Kobold Vermin 3/10 [Kobold Camp Cleanup]") -- muted (MUTED BOT LINES).
#   What a bot says instead, in party chat and in its own words, is the
#   moment something is done: the last kill or item a quest wants ("that's
#   the 10 kobolds"), or the whole quest ready to hand in (to whom, too).
#
#   Only for bots in a group with a real player. DelaySeconds pass first, so
#   the kill that finishes the quest as well as the objective gets one line,
#   not two; when several bots finish the same thing together (kill credit is
#   shared), one says it -- the others wait to see it go out, and one of them
#   says it if it never does; and a group hears at most one of these in
#   GapSeconds -- the rest wait their turn for up to a minute, then lapse.
#   The quest logs of those bots are read every CheckSeconds.
#
###############################################################################

#    OllamaChat.Progress.Enable
#        Default: 1
OllamaChat.Progress.Enable = 1

#    OllamaChat.Progress.CheckSeconds
#    OllamaChat.Progress.DelaySeconds
#    OllamaChat.Progress.GapSeconds
#        Default: 2, 3, 20
OllamaChat.Progress.CheckSeconds = 2
OllamaChat.Progress.DelaySeconds = 3
OllamaChat.Progress.GapSeconds = 20

#    OllamaChat.Progress.Prompt
#    OllamaChat.Progress.KillText
#    OllamaChat.Progress.UseText
#    OllamaChat.Progress.ItemText
#    OllamaChat.Progress.QuestText
#        Prompt: {bot_name} {bot_level} {bot_race} {bot_class}
#        {bot_personality}, {done} (one of the four below; "{~a|b}" picks one
#        each time). KillText, UseText (an object to use) and ItemText:
#        {count}, {what}, {quest}; QuestText: {quest}, {ender} (who it is
#        handed in to).
OllamaChat.Progress.Prompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, questing with your group. Your chat style: {bot_personality} You have just got {done}. {~Tell the group|Let the group know|Say so} in party chat in a few words, the way players do when a bit of a quest is done: no exclamation-mark hype, and nobody needs every detail."
OllamaChat.Progress.KillText = "the last of the {count} {what} you had to kill for {quest}"
OllamaChat.Progress.UseText = "the last of the {count} {what} you had to do for {quest}"
OllamaChat.Progress.ItemText = "the last of the {count} {what} that {quest} wants"
OllamaChat.Progress.QuestText = "everything {quest} needs: it is ready to hand in to {ender}"

###############################################################################
#
#   OLLAMA CHAT - STUCK ON A MOUNT
#
#   mod-playerbots-plus notices a bot getting on and off its mount on the
#   spot -- a mining vein another bot has hold of, a herb two bots went for
#   at once -- and takes it off that thing for a while (PlayerbotsPlus.Stuck.*
#   in its conf). Here, for RememberMinutes the bot knows it was stuck, if
#   asked (StateText); grouped with a real player, or with one in earshot,
#   it may laugh it off (RemarkChance, half that in /say). Without
#   mod-playerbots-plus nothing is noticed.
#
###############################################################################

#    OllamaChat.Stuck.RememberMinutes
#        Default: 10
OllamaChat.Stuck.RememberMinutes = 10

#    OllamaChat.Stuck.RemarkChance
#    OllamaChat.Stuck.RemarkPrompt
#    OllamaChat.Stuck.StateText
#        RemarkPrompt: {bot_name} {bot_level} {bot_race} {bot_class}
#        {bot_personality} {what} ("a Copper Vein") {verb} ("mine", "pick",
#        "skin", "open", "loot") {zone} {channel} ("party chat"). StateText:
#        {what} {verb} {zone}. Empty leaves either out.
#        Default: 50, (below), (below)
OllamaChat.Stuck.RemarkChance = 50
OllamaChat.Stuck.RemarkPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}. Your chat style: {bot_personality} For the last minute you were stuck at {what}, getting on and off your mount over and over without managing to {verb} it, and you have only just noticed and given up on it. Say it in {channel} in a few words, your own way: fed up, embarrassed or laughing at yourself, whatever suits you."
OllamaChat.Stuck.StateText = "A little while ago you were stuck for a minute at {what} in {zone}, getting on and off your mount on the spot without managing to {verb} it, until you gave up on it and moved on. If someone asks whether you are stuck or what you were doing, that is what happened."

###############################################################################
#
#   OLLAMA CHAT - GETTING BACK UP
#
#   A dead bot releasing, running back and getting up when nobody left in
#   the group can resurrect it is mod-playerbots-plus's
#   (PlayerbotsPlus.Revive.* in its conf). "release" or "res" said to a dead
#   bot (ORDERS above) still does it at once.
#
###############################################################################

###############################################################################
#
#   OLLAMA CHAT - RAID MARKS
#
#   mod-playerbots-plus gives each crowd-controlling bot its own mark, sends
#   a rogue to sap the star and moves the skull on (PlayerbotsPlus.Marks.*
#   in its conf). A rogue that cannot sap the star -- no Sap before level 10,
#   a mob Sap does not work on, no stealth in time, a sap that did not take
#   -- says why in party here, in its own words. Without mod-playerbots-plus
#   there is no sapping.
#
###############################################################################

#    OllamaChat.Marks.SayEnable
#    OllamaChat.Marks.SayCooldownSeconds
#    OllamaChat.Marks.SayPrompt
#        When the rogue cannot sap the star it says why in party, in its own
#        chat style -- once per reason every SayCooldownSeconds, so marking
#        the same mob again does not get the same excuse. Placeholders in
#        SayPrompt: {bot_name}, {bot_level}, {bot_race}, {bot_class},
#        {bot_personality}, {player_name}, {situation} (one of the four
#        below).
#        Default: 1, 120, (below)
OllamaChat.Marks.SayEnable = 1
OllamaChat.Marks.SayCooldownSeconds = 120
OllamaChat.Marks.SayPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a group. Your chat style: {bot_personality} {situation} Write it as one party chat line, 3 to 12 words, the way a player types it: no quotes, no name in front."

#    OllamaChat.Marks.SapNotLearned
#    OllamaChat.Marks.SapWrongType
#    OllamaChat.Marks.SapNoStealth
#    OllamaChat.Marks.SapFailed
#        The situations. Placeholders: {player_name} (the real player in
#        the group), {target} (the starred mob), {bot_level}, {sap_level}
#        (10), {detail}: why -- "rogues learn Sap at level 10 and you are
#        level 7"; "it is undead, and Sap only works on humanoids, beasts,
#        demons and dragonkin" or "it is immune to Sap"; "your Stealth was
#        still on cooldown"; "you could not get close enough", "it shrugged
#        it off". Empty silences that one.
OllamaChat.Marks.SapNotLearned = "{player_name} just put the star on {target} for you to sap, but you can't sap yet: {detail}. Tell them, so they don't count on it."
OllamaChat.Marks.SapWrongType = "{player_name} just put the star on {target} for you to sap, but you can't: {detail}. Tell them you can't sap that one."
OllamaChat.Marks.SapNoStealth = "{player_name} put the star on {target} for you to sap, but you could not go into stealth in time ({detail}), and walking up to it without stealth would pull it. Tell them you are leaving it."
OllamaChat.Marks.SapFailed = "You tried to sap {target} for {player_name} and it did not work: {detail}. Tell them in a few words."

###############################################################################
#
#   OLLAMA CHAT - GROUP QUESTS
#
#   mod-playerbots-plus gets random bots together for the quests marked
#   Group (PlayerbotsPlus.GroupQuests.* in its conf): who asks, who comes
#   along and who leads is its. Here they say it, in the zone's General
#   channel, each in its own chat style: the ask for help ("LF2M [The Ogre
#   Threat]"), the answers of those who have it too, the one getting a party
#   together telling one who asks to come along, and the one nobody came for
#   saying it will try it alone. The quest is named in brackets, so it goes
#   out as a link. Nothing is said where no real player is in General to
#   read it. An ask, or going alone, is a line nobody asked for: none starts
#   within Context.AmbientHoldSeconds of a real player speaking there. An
#   answer follows the ask it answers by a few seconds, and only an ask that
#   went out to be written; going alone is only said after asks someone could
#   have read. Any of them is dropped if a player spoke while it was written
#   (an answer with its ask). Who answers is mod-playerbots-plus's, so other
#   bots do not take these up as something to reply to. Without
#   mod-playerbots-plus (with group quests) there are none.
#
###############################################################################

#    OllamaChat.GroupQuests.Enable
#    OllamaChat.GroupQuests.Prompt
#        Whether they say it, and the prompt it is written from.
#        Placeholders in Prompt: {bot_name}, {bot_level}, {bot_race},
#        {bot_class}, {bot_personality}, {zone}, {situation} (one of the four
#        below).
#        Default: 1, (below)
OllamaChat.GroupQuests.Enable = 1
OllamaChat.GroupQuests.Prompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, out questing in {zone}. Your chat style: {bot_personality} {situation} Write it as one line in General chat, 3 to 14 words, the way a player types it there: no quotes, no name in front."

#    OllamaChat.GroupQuests.AskText
#    OllamaChat.GroupQuests.AnswerText
#    OllamaChat.GroupQuests.InviteText
#    OllamaChat.GroupQuests.SoloText
#        The situations: an ask for help; an answer, from one who has it too;
#        the one getting a party together telling one who asked to come
#        along; and going alone, nobody having come. Placeholders: {quest}
#        (its name in brackets), {need} and {need_people} ("one more person",
#        "2 more people": Ask), {have} (how many there are now: Invite),
#        {other_name} (the one asking: Answer, Invite), {zone}. Empty
#        silences that one.
OllamaChat.GroupQuests.AskText = "You have the group quest {quest} and want help with it: you need {need_people}. Ask in General whether anyone has it and wants to do it with you, naming the quest in its square brackets exactly as it is written here."
OllamaChat.GroupQuests.AnswerText = "{other_name} just asked in General for help with the group quest {quest}. You have it too and want to do it: answer them that you are up for it."
OllamaChat.GroupQuests.InviteText = "{other_name} just asked in General whether anyone is doing the group quest {quest}. You are getting a party together for it, {have} of you now counting them: tell them to come along."
OllamaChat.GroupQuests.SoloText = "You have been asking in General for a good while for help with the group quest {quest}, and nobody has come. Say you will give it a go on your own then."

#    OllamaChat.GroupQuests.AnswerDelayMinSeconds
#    OllamaChat.GroupQuests.AnswerDelayMaxSeconds
#        An answer waits this long (picked between the two, up to 120
#        seconds) on top of the usual typing time, so it comes after the ask
#        it answers.
#        Default: 6, 15
OllamaChat.GroupQuests.AnswerDelayMinSeconds = 6
OllamaChat.GroupQuests.AnswerDelayMaxSeconds = 15

###############################################################################
#
#   OLLAMA CHAT - CITY LIFE
#
#   mod-playerbots-plus keeps the crowd hanging out in a city busy
#   (PlayerbotsPlus.CityLife.* in its conf): shifting about, looking round
#   at whoever speaks, hopping, dancing, errands to the bank, auction house
#   and mailbox, fishing at the water's edge, flying in and out, and a few
#   wandering over to look when someone gets on a mount few people about
#   have. Here the two of those that are said:
#
#   - a rare mount: the first of those who came over to look says something
#     to the rider about it in /say, in its own chat style, told the mount's
#     real name and how few others online have one. A line nobody asked
#     for: none starts within Context.AmbientHoldSeconds of a real player
#     speaking nearby, it is dropped if one spoke while it was written, and
#     the other side (in a neutral city) is not spoken to, since their /say
#     arrives as gibberish. The rider, or another who came over, may answer.
#   - a dance: one who starts dancing, or joins someone dancing, does it
#     with the text emote ("X bursts into dance.", "X dances with Y."). The
#     dance and its end are mod-playerbots-plus's.
#
#   The other way round, this module tells mod-playerbots-plus when a bot is
#   talking or emoting, so it is not walked off mid-sentence; when someone
#   says something in /say, so those about may look round at them; and when
#   a /say exchange between bots starts, so they walk over and talk face to
#   face. Without mod-playerbots-plus (with city life) none of this is
#   there.
#
###############################################################################

#    OllamaChat.CityLife.Enable
#        Whether the crowd's city life is said at all (both below).
#        Default: 1
OllamaChat.CityLife.Enable = 1

#    OllamaChat.CityLife.MountPrompt
#        The prompt the remark about a rare mount is written from. Empty
#        silences it (they still come over to look). Placeholders:
#        {bot_name}, {bot_level}, {bot_race}, {bot_class}, {bot_personality},
#        {rider_name}, {mount} (the mount's name, "Swift Spectral Tiger"),
#        {rarity} ("nobody else about has one", "only 2 others about have
#        one": of everyone online), {who} (who came over: "you", "you and
#        one other person", "you and 2 others"), {zone}.
#        Default: (below)
OllamaChat.CityLife.MountPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, standing about in {zone}. Your chat style: {bot_personality} {rider_name} has just got on their mount, the {mount}, and {rarity}, so {who} wandered over to look at it. Say something to them about it in /say -- impressed, jealous, curious where they got it, or a joke about it, whatever suits your style -- and call it the {mount} if you name it. One line, 3 to 14 words, the way a player types it: no quotes, no name in front."

#    OllamaChat.CityLife.DanceEmotes
#        1: a bot that starts dancing, or joins someone dancing, does it with
#        the text emote, which says so in chat. 0: it only dances.
#        Default: 1
OllamaChat.CityLife.DanceEmotes = 1

###############################################################################
#
#   OLLAMA CHAT - STATUS AND THE FULL REPORT
#
#   In game the module says little, and the rest goes to a file:
#
#   .ollama status          a few lines: what it talks to, whether it is
#                           keeping up (requests waiting, failing), what is
#                           going on right now, and what looks wrong.
#   .ollama status <part>   the counts behind one part: chat (the requests on
#                           their way: the endpoint, think mode, the queue,
#                           what was held back and why), talk (what goes into
#                           the prompts), city (cities, presence, mingling),
#                           party (groups and dungeons), bots (buffs, orders,
#                           trades and the rest bots do for people).
#   .ollama report          every count, written to Report.File now (also
#                           ".ollama status all").
#
#   The file is written again every Report.Minutes as well, so the latest is
#   there to read, or to send on, when something has gone wrong and nobody
#   was in game to look. Hangouts, raid marks and the auction house are
#   mod-playerbots-plus's: .pbp status, and its own report file.
#
###############################################################################

#    OllamaChat.Report.Minutes
#        How often the full report is written to Report.File, in minutes (at
#        most 1440). 0: only when .ollama report asks.
#        Default: 10
OllamaChat.Report.Minutes = 10

#    OllamaChat.Report.File
#        The full report's file: a name, in the server's logs folder
#        (LogsDir in worldserver.conf), or a whole path. Written over each
#        time.
#        Default: "OllamaChatReport.log"
OllamaChat.Report.File = "OllamaChatReport.log"

###############################################################################
#
#   OLLAMA CHAT - WHAT BOTS CARRY, AND TRADING IT
#
#   A bot knows what is in its bags: what it could part with and what it
#   keeps, and why. The judgement is playerbots' own item usage -- the one it
#   loots, rolls and sells by -- so it never offers the upgrade it is about to
#   put on or the quest item it is collecting. Spare is anything tradeable it
#   has no use for: cloth it does not work, greens for another class or worse
#   than what it wears, things it would sell. Kept: an upgrade, a quest item,
#   its trade goods, the food and potions it uses, anything soulbound.
#
#   Asked what it has ("got anything to trade?", "what did you loot", a
#   linked item, "come trade me"), its reply prompt gets the list
#   (PromptText): the spare things as links, what it just looted first, a few
#   things it keeps with the reason, and its money.
#
#   Asked for something ("can I have your [Linen Cloth]", "ill take the
#   leggings", "trade me the cloth", or just "me!" / "yes please" right after
#   it offered one), a spare thing goes over in a trade the way a mage's water
#   does -- the bot's side accepted already, so the person's accept completes
#   it, free -- and a kept one gets a no and the reason, in the bot's own
#   words. The bot's side is only kept accepted while it holds exactly what
#   was given: anything else put in (gold, another item) makes it an ordinary
#   trade, priced by playerbots. Whole stacks go over: the biggest, then
#   more only while they stay within what was asked and one stack's worth.
#   Someone outside the bot's group gets what it offered them, and anything
#   else they ask for is a favour, its own call (Favor.Strangers,
#   Buff.Style.<KEY>): it may say no (HintNo) or let it go by. While the
#   trade is on, its playerbots AI is held so the trade is not turned down.
#   With Favor.Strangers = 0 they are told to invite the bot first instead;
#   if they do within InviteWaitSeconds, the trade starts by itself. "me!" in
#   General gets its answer by whisper.
#
###############################################################################

#    OllamaChat.Bags.Enable
#        Default: 1
OllamaChat.Bags.Enable = 1

#    OllamaChat.Bags.RecentMinutes
#        What a bot looted this recently is "just looted", and offered first.
#        Default: 30
OllamaChat.Bags.RecentMinutes = 30

#    OllamaChat.Bags.OfferSeconds
#        After a bot links something spare in a line (or offers it,
#        OllamaChat.Needs), "me!" there claims it for this long.
#        Default: 180
OllamaChat.Bags.OfferSeconds = 180

#    OllamaChat.Bags.InviteWaitSeconds
#        Told to invite the bot first (Favor.Strangers = 0): the trade starts
#        by itself if they do within this long.
#        Default: 120
OllamaChat.Bags.InviteWaitSeconds = 120

#    OllamaChat.Bags.MaxSpare
#    OllamaChat.Bags.MaxKept
#        How many spare and kept things the list names.
#        Default: 6, 3
OllamaChat.Bags.MaxSpare = 6
OllamaChat.Bags.MaxKept = 3

#    OllamaChat.Bags.MaxGiftQuality
#    OllamaChat.Bags.MaxGiftCopper
#        What goes over is free, so only what a player would give away free
#        counts as spare: nothing better than MaxGiftQuality (0 grey, 1
#        white, 2 green, 3 blue, 4 epic), and no stack that sells to a vendor
#        for more than MaxGiftCopper (20000 is 2 gold). Anything better is
#        kept, "worth good gold, so you would sell it rather than give it
#        away".
#        Default: 2, 20000
OllamaChat.Bags.MaxGiftQuality = 2
OllamaChat.Bags.MaxGiftCopper = 20000

#    OllamaChat.Bags.GiveAway
#    OllamaChat.Bags.NoGiftReason
#    OllamaChat.Bags.SupplyReason
#        Players don't hand their things to strangers for nothing, so with
#        GiveAway off (the default) a bot gives nothing away and offers
#        nothing free: asked for something it has no use for, it says no
#        (NoGiftReason), and the Needs "spare" offers stop. Whatever
#        playerbots hands a bot for free -- ammo, food and drink, potions,
#        class reagents, sharpening stones, weightstones, oils, poisons -- it
#        never gives away either way (SupplyReason): they are its supplies.
#        With GiveAway on, what it has no use for goes free again, within
#        MaxGiftQuality and MaxGiftCopper.
#        Default: 0, (below), (below)
OllamaChat.Bags.GiveAway = 0
OllamaChat.Bags.NoGiftReason = "you have no use for it, but you don't give your things away"
OllamaChat.Bags.SupplyReason = "it is one of your own supplies"

#    OllamaChat.Bags.PromptText
#        The list, in a reply prompt: when the line is about items (TalkWords,
#        or a link), or a trade window between the two is open. Placeholders:
#        {spare} ("[Linen Cloth] x12 (just looted), [Ironspine's Eye] (a
#        blue)"), {kept} ("[Wolf Meat] (you need it for the quest [Bounty on
#        Wolves])"), {money}.
#        Whatever spare thing the bot then names in its answer ("just have
#        some [Ankh] if you want") counts as offered, the way a Needs offer
#        does: "sure yes please", "trade it" or "can you trade me?" next takes
#        it, and everything else that same line named.
OllamaChat.Bags.PromptText = "What you have on you (bring up only what fits what they said): you could spare {spare}; you are keeping {kept}; and you have {money}. Asked for something you can spare, you are happy to let them have it; asked for something you are keeping, say no and why. Never offer anything that is not listed here, and never offer to give anything away that is not on the spare list; name what you mention exactly, in square brackets."

#    OllamaChat.Bags.HandoverText
#        Added after the list, and on its own to the bot's replies for
#        OfferSeconds after it was shown the list or while a trade window
#        between the two is open: saying so hands nothing over, so it never
#        claims to have put something in their bags. Empty: not added.
OllamaChat.Bags.HandoverText = "Saying so hands nothing over: things only change hands in a trade window, and you are told when one is opening. So never say you have given, sent, traded or put anything in their bags."

#    OllamaChat.Bags.TalkWords
#        A line with one of these (or with a link) is about trading or what
#        someone has, and gets the list. Words as CrowdText reads them:
#        lowercase, no apostrophes.
OllamaChat.Bags.TalkWords = "trade|trading|tradeable|loot|looted|loots|drop|dropped|drops|bags|inventory|spare|sell|selling|wts|wtb|for sale|what do you have|what have you got|what you got|what u got|whatcha got|watcha got|got anything|have anything|anything good|anything nice|anything for me|do you have|have you got|got any|you got any|u got any|any spare|need any|items|gear|can i have|could i have|can i get|could i get|give me|gimme|trade me|ill take"

#    OllamaChat.Bags.AskWords
#    OllamaChat.Bags.YesWords
#    OllamaChat.Bags.ClaimWords
#    OllamaChat.Bags.NotWords
#        Asking for something: an AskWords phrase plus the thing (linked,
#        named, or a word only one thing it carries has: "the leggings").
#        Right after a bot offered something (OllamaChat.Needs, or named it
#        when asked what it has), a line made of nothing but YesWords that
#        says yes somewhere (ClaimWords: "me", "yes please", "dibs", "go on
#        then") claims it -- "ty" or "please" alone does not -- and so does an
#        ask that points at it or names nothing else ("can I have it", "ill
#        take the cloth", "trade it", "can you trade me?"). Names do not count:
#        "me Joanni" is a claim. A NotWords word ("dont", "no thanks") means it
#        is not an ask.
OllamaChat.Bags.AskWords = "can i have|could i have|can i get|could i get|can i grab|can i take|may i have|give me|gimme|giv me|trade me|trade it|send me|send it|pass me|hand me|ill take|i will take|ill have|i will have|i want|id like|i would like|id love|can you trade|could you trade|can u trade|dibs"
OllamaChat.Bags.YesWords = "me|mee|meee|me2|mine|dibs|yes|yess|yeah|yea|ye|yep|yup|sure|please|pls|plz|plez|i|would|want|it|that|one|oh|ooh|too|do|go|on|then|trade|ok|okay"
OllamaChat.Bags.ClaimWords = "me|mee|meee|me2|mine|dibs|yes|yess|yeah|yea|ye|yep|yup|sure|want|go on then|go on|trade"
OllamaChat.Bags.NotWords = "dont|do not|doesnt|not|no|nah|nope|never|cant|wont|didnt"

#    OllamaChat.Bags.HintGive
#    OllamaChat.Bags.HintInvite
#    OllamaChat.Bags.HintNo
#    OllamaChat.Bags.HintKeep
#    OllamaChat.Bags.HintNotHave
#    OllamaChat.Bags.HintCant
#    OllamaChat.Bags.HintAlready
#        What the bot is told to answer with. Placeholders: {player_name},
#        {item} ("[Linen Cloth] x12", "[Linen Cloth] x12 and [Ankh]"), {when}
#        ("now", "once they come over to you, since you are too far apart to
#        trade"), {reason} (kept: "it is an upgrade you mean to put on";
#        cannot: "their bags are full, so they need to make room first").
#        HintAlready: asked again ("sure", then "trade it") while it is going
#        over already. HintInvite: someone outside its group, with
#        Favor.Strangers = 0. HintNo: someone outside its group, and it won't.
OllamaChat.Bags.HintGive = "{player_name} asked for {item}, which you have no use for, so you are trading it over to them {when}. Say so in a few words, in your own way."
OllamaChat.Bags.HintInvite = "{player_name} wants {item}, which you could spare, but you only trade with people in your group: tell them to invite you and you will trade it over."
OllamaChat.Bags.HintNo = "{player_name} asked for {item}, which you could spare, but you are not giving it to them: say no in a few words, in your own chat style, with or without a reason."
OllamaChat.Bags.HintKeep = "{player_name} asked for {item}, but you are keeping it: {reason}. Say no, and why, in your own way."
OllamaChat.Bags.HintNotHave = "{player_name} asked for {item}, but you do not have one. Say so."
OllamaChat.Bags.HintCant = "{player_name} asked for {item}, and you would give it to them, but you can't right now: {reason}. Say so."
OllamaChat.Bags.HintAlready = "{player_name} asked again for {item}, which is going over to them already: it is in the trade window, or will be as soon as the window is open. Say so in a few words."

#    OllamaChat.Bags.CancelPhrases
#    OllamaChat.Bags.CancelNotPhrases
#    OllamaChat.Bags.HintCancel
#        "actually no, take it out", "nvm", "you keep it": while a bot is
#        handing a real player something -- a spare thing, a mage's water,
#        offered, waiting or already in the window, or promised once they
#        invite it -- a line with one of CancelPhrases (whole words, separated
#        by |) calls it off: the trade window is closed, and the bot says so
#        (HintCancel, {player_name}, {item}). Not where one of
#        CancelNotPhrases runs into it: "thank you, keep it up" holds "you
#        keep it" and "dont take it out" holds "take it out", and neither is
#        calling anything off. (One wholly inside the cancel phrase does not
#        count: "no thanks" is still a no.) A bare "keep it" or "no need" is
#        not in the list: "ill keep it", "no need to thank me". Empty
#        CancelPhrases turns it off.
#        Default: (below)
OllamaChat.Bags.CancelPhrases = "take it out|take them out|take that out|take it back|take them back|take it away|actually no|actually nah|no wait|nvm|nevermind|never mind|cancel|cancel it|cancel that|cancel the trade|you keep it|you keep them|you can keep it|you can keep them|dont want it|dont want them|dont need it|dont need them|no thanks|no ty|nah its fine|changed my mind|on second thought|forget it|no need for it|no need for them"
OllamaChat.Bags.CancelNotPhrases = "thank you|keep it up|keep it coming|keep them coming|keep em coming|dont take*|do not take*|dont cancel|do not cancel|never cancel*"
OllamaChat.Bags.HintCancel = "{player_name} changed their mind about {item}, so you have taken it back out and closed the trade window. Say so in a few words, in your own chat style, no fuss."

###############################################################################
#
#   OLLAMA CHAT - A PLAYER GIVING AWAY OR SELLING SOMETHING
#
#   "anyone want my [Woolen Bag]?" used to read to the bots as talk about
#   items, so each of them was shown what it could spare (OllamaChat.Bags):
#   one said it had no bags to spare, one offered its own vest. Now a real
#   player's line in party, raid or a whisper that links something they have
#   on them, with one of OfferWords or SellWords -- or a price ("5g", "1g
#   50s", "75 silver") -- is read as what it is. The words around the links
#   count, not the item names: "[Gold Ring]" is no price.
#
#   Each bot of the group on the player's map judges the thing the way
#   playerbots does when it loots: a quest item it still needs, an upgrade,
#   a bag bigger than its smallest one or a bag slot it has free (all the
#   more with its bags nearly full), something for its profession, something
#   it would use. One named in the line, or the one whispered, answers alone.
#
#   Given away: the one it is most use to says yes please (HintWant), and
#   playerbots takes it when it is put in a trade window with it, as it takes
#   any gift it has a use for. Sometimes (SecondVoiceChance) a second voice:
#   another who could have used it (HintWantToo) or a no thanks (HintNoNeed).
#   When nobody can use it, one no thanks now and then (NobodyChance).
#   Soulbound, and past its loot trade window: one bot says it cannot be
#   traded (HintNotTradable).
#
#   Sold: with no price named, the one who could use it asks how much
#   (HintAskPrice), and the price that follows within FollowUpSeconds goes
#   to it. At a price it would pay -- no more than playerbots' own value of
#   the thing (what a vendor would charge for it, times this bot's buy rate),
#   so its trade check always passes, and no more than MaxSpendPercent of its
#   money -- it says it will buy (HintBuy); when the player puts the thing in
#   a trade window with it, it puts the money in on its side, and the
#   player's accept completes it. Asked more, it offers what it would pay,
#   rounded (HintCounter), and that price stands if they trade at it; too
#   dear for its purse, it says so (HintTooDear). Only what it could really
#   use is bought, never something it would only vendor.
#
#   Afterwards, for RememberSeconds, its replies know what it said yes to,
#   offered or agreed to pay (Said*Text), and the replies to the line do not
#   list their own spare things. Off when playerbots' random-bot trading is
#   off or only lets bots sell (Playerbots.EnableRandomBotTrading 0 or 3).
#
###############################################################################

#    OllamaChat.Gifts.Enable
#        Default: 1
OllamaChat.Gifts.Enable = 1

#    OllamaChat.Gifts.OfferWords
#    OllamaChat.Gifts.SellWords
#        Whole words and phrases, separated by |, that make a line with a
#        linked thing an offer or a sale. A price makes it a sale too.
#        Default: (below)
OllamaChat.Gifts.OfferWords = "anyone want|anybody want|any1 want|anyone wants|anybody wants|who wants|who want|whoever wants|anyone need|anybody need|any1 need|who needs|whoever needs|you want|u want|ya want|you need|u need|want my|want this|want it|want one|need this|need it|need one|need my|free|for free|freebie|giving away|give away|giving it away|giving this away|giving them away|up for grabs|anyone use|anybody use|can anyone use|can anybody use|any use|use this|use it|you can have|u can have|can have it|have it if|take it|take this|have this|for you|for u|here you go|here u go|dont need|do not need|no longer need|getting rid|get rid"
OllamaChat.Gifts.SellWords = "wts|selling|for sale|buy|buying|buyer|buyers|make an offer|make me an offer|any offers|best offer|or offer|obo|cheap|bargain|pay|paying"

#    OllamaChat.Gifts.GreedyPersonalities
#        Chat styles that take a free thing they could only sell. Separated by |.
#        Default: NAT_GOLDMAKER|NAT_RUDE
OllamaChat.Gifts.GreedyPersonalities = "NAT_GOLDMAKER|NAT_RUDE"

#    OllamaChat.Gifts.SecondVoiceChance
#    OllamaChat.Gifts.NobodyChance
#        Percent: a second voice after the yes please; a no thanks when nobody
#        can use it (or buy it).
#        Default: 35, 60
OllamaChat.Gifts.SecondVoiceChance = 35
OllamaChat.Gifts.NobodyChance = 60

#    OllamaChat.Gifts.FollowUpSeconds
#        A line from the same player with no link of its own ("5g then", "its
#        free") is still about the last thing, this long after it.
#        Default: 90
OllamaChat.Gifts.FollowUpSeconds = 90

#    OllamaChat.Gifts.RememberSeconds
#        How long a bot remembers what it said yes to, and a price it agreed
#        stands.
#        Default: 300
OllamaChat.Gifts.RememberSeconds = 300

#    OllamaChat.Gifts.MaxSpendPercent
#        The most of its money a bot pays for one thing.
#        Default: 50
OllamaChat.Gifts.MaxSpendPercent = 50

#    OllamaChat.Gifts.HintWant ... OllamaChat.Gifts.HintNoBuy
#    OllamaChat.Gifts.InviteText
#        What the answering bot is told. {player_name}, {item} ("[Woolen
#        Bag]"), {why} (what use it is to it, or why none), {price} (what they
#        asked), {counter} (what it offers), {money} (what it has), {first}
#        (who already said yes). InviteText goes after a yes from a bot outside
#        their group, with Favor.Strangers = 0; otherwise a bot outside it
#        trades with them too, its AI held and its side accepted for it.
OllamaChat.Gifts.HintWant = "{player_name} is giving away {item} for free to anyone in the group who wants it -- they are offering it, not asking for one. It would be useful to you: {why}. Say you would like it, in a few words and in your own way, so they can trade it to you."
OllamaChat.Gifts.HintWantToo = "{player_name} is giving away {item} for free, and {first} has already said they would like it. It would have been useful to you too ({why}); if you say anything, keep it light -- that you would have taken it too, or that {first} can have it."
OllamaChat.Gifts.HintNoNeed = "{player_name} is giving away {item} for free to anyone who wants it -- they are offering it, not asking for one. It is no use to you: {why}. If you say anything, just a quick no thanks in your own words."
OllamaChat.Gifts.HintNotTradable = "{player_name} is offering {item}, but it is soulbound, so it cannot be traded to anyone. Say so lightly, in a few words."
OllamaChat.Gifts.HintAskPrice = "{player_name} is selling {item} but has not said what they want for it. It would be useful to you: {why}. Ask how much they want for it, in a few words."
OllamaChat.Gifts.HintBuy = "{player_name} is selling {item} for {price}. It would be useful to you ({why}) and that is a fair price, so you will buy it: say so in a few words, and that they can trade it to you."
OllamaChat.Gifts.HintCounter = "{player_name} is selling {item} for {price}. It would be useful to you ({why}), but {price} is more than you would pay: offer {counter} for it instead, in a few words."
OllamaChat.Gifts.HintTooDear = "{player_name} is selling {item} for {price}. It would be useful to you, but you cannot afford that: you only have {money}. Say so, in a few words."
OllamaChat.Gifts.HintNoBuy = "{player_name} is selling {item}. It is no use to you: {why}. If you say anything, a quick no thanks."
OllamaChat.Gifts.InviteText = "You are not in their group, and you only trade with your group: ask them to invite you first."

#    OllamaChat.Gifts.SaidGiftText ... OllamaChat.Gifts.SaidAskText
#        Added to the bot's reply prompts afterwards. {player_name}, {item},
#        {price} (agreed, or offered). Empty: not added.
OllamaChat.Gifts.SaidGiftText = "You told {player_name} you would like their {item}: it comes over when they put it in a trade window with you."
OllamaChat.Gifts.SaidBuyText = "You agreed to buy {player_name}'s {item} for {price}: when they put it in a trade window with you, you put the money in."
OllamaChat.Gifts.SaidCounterText = "You offered {player_name} {price} for their {item}; if they agree, they can put it in a trade window with you and you pay that."
OllamaChat.Gifts.SaidAskText = "You asked {player_name} how much they want for their {item}."

###############################################################################
#
#   OLLAMA CHAT - THE TANK DOWN, A WIPE, NOBODY LEFT TO REZ
#
#   A group wiped and its bots had no idea: "shes coming back soon i think",
#   "just waiting for urdrudes to get back then", with all of them lying
#   dead. Once a second, each group with a real player in it is looked at:
#
#     * The tank -- mod-dungeon-clear's tank when there is one, else whoever
#       tanks by spec -- dies while the rest are still fighting: one bot
#       still standing says so the way people do, "uh oh", "oh no"
#       (TankDown*), once a fight, a moment after.
#     * Everyone where the group was fighting is dead -- a wipe: a bot tank
#       says sorry (Apology*), and a few seconds later someone says nobody is
#       left to rez, so it is release and run back (NoRez*) -- unless one of
#       them has a soulstone or a reincarnation ready, which gets them up
#       without anyone.
#     * A fight over with some of them dead and nobody alive who can
#       resurrect -- real players count -- one of the dead bots says it is
#       running back (RunBack*), as mod-playerbots-plus then has it do
#       (PlayerbotsPlus.Revive).
#
#   Each line is the model's, in the bot's own voice (the *Prompt settings:
#   {bot_name}, {bot_level}, {bot_race}, {bot_class}, {bot_personality},
#   {tank}, {place}), or now and then (TypedChance) a typed one from the
#   *Lines lists -- which also go out when the model cannot be reached.
#
#   And every reply prompt of a bot in such a group says who is dead, whether
#   it was a wipe and whether the tank went down first, and who can still
#   bring them back (State*Text), for StateMinutes after a wipe, so "we
#   wiped, we need to respawn" is understood.
#
###############################################################################

#    OllamaChat.Wipe.Enable
#        Default: 1
OllamaChat.Wipe.Enable = 1

#    OllamaChat.Wipe.TankDownChance
#    OllamaChat.Wipe.ApologyChance
#    OllamaChat.Wipe.NoRezChance
#    OllamaChat.Wipe.RunBackChance
#        Percent for each.
#        Default: 60, 75, 90, 60
OllamaChat.Wipe.TankDownChance = 60
OllamaChat.Wipe.ApologyChance = 75
OllamaChat.Wipe.NoRezChance = 90
OllamaChat.Wipe.RunBackChance = 60

#    OllamaChat.Wipe.TypedChance
#        Percent of these lines that are typed from the lists instead of the
#        model's. None in roleplay mode, where a bare "uh oh" breaks character.
#        Default: 35
OllamaChat.Wipe.TypedChance = 35

#    OllamaChat.Wipe.RunBackQuietSeconds
#        After the last of a fight, before a dead bot says it is running back.
#        Default: 4
OllamaChat.Wipe.RunBackQuietSeconds = 4

#    OllamaChat.Wipe.StateMinutes
#        How long after a wipe the reply prompts still call it one.
#        Default: 5
OllamaChat.Wipe.StateMinutes = 5

#    OllamaChat.Wipe.TankDownPrompt
#    OllamaChat.Wipe.ApologyPrompt
#    OllamaChat.Wipe.NoRezPrompt
#    OllamaChat.Wipe.RunBackPrompt
OllamaChat.Wipe.TankDownPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a group in {place}. Your chat style: {bot_personality} You are in the middle of a fight and {tank}, your tank, has just died. React in party chat the way players do the moment it starts going wrong: a couple of words like uh oh or oh no, in your own way. Under 6 words, no name in front, no quotes."
OllamaChat.Wipe.ApologyPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, the tank of your group in {place}. Your chat style: {bot_personality} Your whole group has just died: a wipe, and as the tank it is on you. Say sorry in party chat in a few words, your own way (sorry all, my bad, that one's on me). No long excuses, under 10 words, no name in front, no quotes."
OllamaChat.Wipe.NoRezPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a group in {place}. Your chat style: {bot_personality} Your whole group has just died -- a wipe -- and nobody is left alive who could resurrect anyone. Say in party chat, in a few words, that it is release and run back for everyone (no rez, gotta run back, release and run in). Under 12 words, no name in front, no quotes."
OllamaChat.Wipe.RunBackPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in a group in {place}. Your chat style: {bot_personality} You died in that fight, and nobody still alive in your group can resurrect you. Say in party chat, in a few words, that you will release and run back (no rez, running back). Under 10 words, no name in front, no quotes."

#    OllamaChat.Wipe.TankDownLines
#    OllamaChat.Wipe.ApologyLines
#    OllamaChat.Wipe.NoRezLines
#    OllamaChat.Wipe.RunBackLines
#        Typed lines, separated by |.
OllamaChat.Wipe.TankDownLines = "uh oh|oh no|uh oh...|oh no tank|uh oh, tank down|oh dear|oh no no no|this is bad|uh oh guys|welp|tank down!"
OllamaChat.Wipe.ApologyLines = "sorry guys|my bad|sorry all, my fault|my bad guys|sorry all|oops, my fault|thats on me, sorry|sorry, my bad"
OllamaChat.Wipe.NoRezLines = "no one left to res, gotta run back|release and run back i guess|no rez, run back time|guess we're running back|nobody can res, release and run in|corpse run time|run back time all"
OllamaChat.Wipe.RunBackLines = "no rez, running back|running back|no one can res me, running back|ill run back|corpse run, brb|releasing, brb"

#    OllamaChat.Wipe.StateWipeText ... OllamaChat.Wipe.StateBackText
#        For reply prompts. StateWipeText after a wipe ({place}, {first}: the
#        StateTankFirstText when the tank went down first, {rez}); otherwise
#        StateDeadText ({dead}: who else is dead, {is_are}, {you}: " (you
#        too)" when the bot is, {rez}) and StateTankDeadText when the tank is
#        one of them. {rez} is StateSelfResText ({name}), StateRezzerText
#        ({rezzers}, {them}), StateRunBackText after a wipe or
#        StateNoRezzerText. StateBackText ({back}, {is_are}) names who is back
#        up after a wipe. Empty StateWipeText and StateDeadText: nothing added.
OllamaChat.Wipe.StateWipeText = "Your whole group died a moment ago in {place}: a wipe{first}. {rez}"
OllamaChat.Wipe.StateDeadText = "In your group, {dead} {is_are} dead{you}. {rez}"
OllamaChat.Wipe.StateTankFirstText = " -- {tank}, the tank, went down first"
OllamaChat.Wipe.StateTankDeadText = "{tank}, your tank, is one of them."
OllamaChat.Wipe.StateSelfResText = "{name} can get back up on their own and bring the rest back."
OllamaChat.Wipe.StateRezzerText = "{rezzers} can resurrect {them} once the fight is over."
OllamaChat.Wipe.StateRunBackText = "Nobody is left alive who could resurrect anyone, so everyone has to release their spirit and run back in from the graveyard."
OllamaChat.Wipe.StateNoRezzerText = "Nobody still alive can resurrect, so the dead have to release and run back."
OllamaChat.Wipe.StateBackText = "{back} {is_are} back up already."

###############################################################################
#
#   OLLAMA CHAT - GEAR TALK, AND TEASING THAT STOPS
#
#   "im wearing robes what you mean" had nothing to go on -- the bots knew
#   nobody's gear -- so they made it up and egged each other on: "those look
#   like actual pieces of wood", "hard to be rude when you're wearing trees".
#
#   When gear comes up -- TalkWords in the line, or in the last three lines
#   of the chat there, within a minute and a half -- the reply prompt says
#   what the people in the conversation visibly wear (PromptText, {gear}):
#   whoever spoke, anyone named, the real players in the group and the bot
#   itself, at most MaxPeople, each by helm, shoulders, chest, trousers,
#   gloves, boots and weapons, with name, quality and kind ("[Robe of
#   Evocation] (green cloth robe)"), and nothing on the chest or legs where
#   that is so. The text tells the bot to go only by that, and not to pile
#   on.
#
#   A real player saying they feel picked on -- BackOffWords: "rude",
#   "harsh", "leave me alone" -- gets every bot in their group to drop it for
#   BackOffMinutes (BackOffText, {player_name}).
#
###############################################################################

#    OllamaChat.Gear.Enable
#        Default: 1
OllamaChat.Gear.Enable = 1

#    OllamaChat.Gear.TalkWords
#    OllamaChat.Gear.BackOffWords
#        Whole words and phrases, separated by |.
#        Default: (below)
OllamaChat.Gear.TalkWords = "gear|geared|wearing|wear|wears|worn|outfit|outfits|robe|robes|armor|armour|cloth|leather|chainmail|chain mail|plate|helm|helmet|hat|shoulders|pauldrons|pants|trousers|leggings|boots|gloves|gauntlets|staff|wand|sword|axe|mace|dagger|shield|weapon|weapons|transmog|ilvl|item level|gearscore|gear score|naked|dressed|fashion|drip|rags|tailor|look like|looks like"
OllamaChat.Gear.BackOffWords = "rude|rood|harsh|so mean|thats mean|youre mean|you are mean|being mean|how mean|leave me alone|stop it|stop that|knock it off|bully|bullying|bullies|not nice|uncalled for|no need for that|wow ok|ok wow|savage|toxic|hurtful"

#    OllamaChat.Gear.MaxPeople
#        Default: 4
OllamaChat.Gear.MaxPeople = 4

#    OllamaChat.Gear.BackOffMinutes
#        Default: 5
OllamaChat.Gear.BackOffMinutes = 5

#    OllamaChat.Gear.PromptText
#    OllamaChat.Gear.BackOffText
#        Empty: not added.
OllamaChat.Gear.PromptText = "What the people in this chat are wearing, as anyone can see by looking at them: {gear}. If gear comes up, go only by this. Never make up what someone's gear looks like or is made of -- no wood, trees, rags or sacks -- and never invent gear they are not wearing. A light tease about something real is fine once, but do not pile on: if someone has already teased them about it, let it go."
OllamaChat.Gear.BackOffText = "{player_name} has said they feel picked on: do not tease them any more. A quick sorry, something kind, or just talk about something else."

###############################################################################
#
#   OLLAMA CHAT - WHISPERED ASIDES IN A GROUP
#
#   Now and then -- rarely -- a bot in a group with a real player whispers
#   them a quick catty, cheeky or gossipy remark about someone else in the
#   group, the kind of thing people only say in a whisper. About something
#   real and nothing made up: a line that someone just said in party chat
#   (FactSaid), their class and spec (FactClass), a level well off the rest
#   of the group (FactLevel), a piece of what they wear -- something grey
#   first (FactGear), their pet (FactPet), how often they have died with the
#   group (FactDeaths).
#
#   Only the chat styles in Personalities do it, each with a weight: the
#   percent of its chances it takes (NAT_GOSSIP all of them). The chances: a
#   party or raid line of MinWords or more (LineChance), and once every
#   CheckSeconds out of a fight (IdleChance). Never more than one to the same
#   player in PlayerMinutes -- from whichever bot, so several gossips in a
#   group do not take turns -- one bot not again within BotMinutes, never the
#   same person talked about twice running, and not while the player or the
#   bot is fighting, nor to a player AFK or busy.
#
#   The whisper goes into that bot's history with the player (HistoryNote is
#   what the player "said" before it), so a whisper back carries on from it
#   -- when bots answer whispers at all (OllamaChat.EnableWhisperReplies; with
#   that off, an aside is a one-off remark, which is all it needs to be).
#
###############################################################################

#    OllamaChat.Aside.Enable
#        Default: 1
OllamaChat.Aside.Enable = 1

#    OllamaChat.Aside.Personalities
#        STYLE:weight, separated by |. A style not listed never does it.
#        Default: (below)
OllamaChat.Aside.Personalities = "NAT_GOSSIP:100|NAT_BUTTERFLY:50|NAT_BANTER:40|NAT_DEADPAN:30|NAT_JOKER:30|NAT_RUDE:30|NAT_GRUMBLER:25|NAT_RAIDER:25|NAT_SOCIAL:25|NAT_TROLL:20|NAT_CONTRARIAN:20|NAT_MINMAXER:20|NAT_PETLOVER:20|NAT_PRANKSTER:20|NAT_KEYBOARD:20|NAT_HYPE:15"

#    OllamaChat.Aside.LineChance
#    OllamaChat.Aside.MinWords
#        Percent of party lines of at least MinWords words that are a chance.
#        Default: 10, 4
OllamaChat.Aside.LineChance = 10
OllamaChat.Aside.MinWords = 4

#    OllamaChat.Aside.IdleChance
#    OllamaChat.Aside.CheckSeconds
#        Percent chance, every CheckSeconds, for each real player in a group.
#        Default: 4, 60
OllamaChat.Aside.IdleChance = 4
OllamaChat.Aside.CheckSeconds = 60

#    OllamaChat.Aside.PlayerMinutes
#    OllamaChat.Aside.BotMinutes
#        Default: 20, 45
OllamaChat.Aside.PlayerMinutes = 20
OllamaChat.Aside.BotMinutes = 45

#    OllamaChat.Aside.Prompt
#        {bot_name}, {bot_level}, {bot_race}, {bot_class}, {bot_personality},
#        {player_name} (whispered), {subject} (talked about), {fact}.
OllamaChat.Aside.Prompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}. Your chat style: {bot_personality} You are in a group with {player_name} and with {subject}. Whisper {player_name} privately: a quick aside about {subject}, the cheeky, gossipy or slightly catty kind of remark you would only make in a whisper, to get a laugh out of them. Base it on this, and nothing else: {fact}. Keep it playful, never cruel, nothing about anyone's real life, and make up nothing about {subject} beyond that. Do not say you are whispering. One short line, under 20 words, no name in front, no quotes."

#    OllamaChat.Aside.HistoryNote
OllamaChat.Aside.HistoryNote = "(nothing yet: you whispered them first)"

#    OllamaChat.Aside.FactSaid ... OllamaChat.Aside.FactDeaths
#        {subject}, {level}; FactSaid {line}; FactClass {race}, {role} ("feral
#        druid"), {duty} (", the group's tank"); FactLevel {gap}, {dir} (below
#        or above); FactGear {item}; FactPet {family}, {pet}; FactDeaths
#        {deaths}. Empty: that kind is never used. (No double quotes inside a
#        value: the server's config reader drops every one of them.)
OllamaChat.Aside.FactSaid = "{subject} just said in party chat: '{line}'"
OllamaChat.Aside.FactClass = "{subject} is a level {level} {race} {role}{duty}"
OllamaChat.Aside.FactLevel = "{subject} is level {level}, {gap} levels {dir} the rest of the group"
OllamaChat.Aside.FactGear = "{subject} is wearing {item}"
OllamaChat.Aside.FactPet = "{subject}'s pet is a {family} called {pet}"
OllamaChat.Aside.FactDeaths = "{subject} has died {deaths} times since joining the group"

###############################################################################
#
#   OLLAMA CHAT - WHERE THINGS ARE, AND HOW TO GET THEM
#
#   "anyone know where i get Rune of Teleportation" had only the model's own
#   memory of WoW to go on: it sent the asker to the auction house, then to
#   kill a dragon, and every answer after the first agreed with it. "where is
#   the engineering trainer in ironforge" got "near the entrance by the
#   forge". Now a line asking where something is or how to get it
#   (QuestionWords, unless it is selling: NotAskingWords) gets the answer
#   from the game's own data in the reply prompt:
#
#     * An item -- linked, in brackets or just named: whether vendors sell it
#       and how widely (SpreadManyText, SpreadSomeText, SpreadOneText), the
#       kind most of them are (KindText: "Reagents"), the nearest one to the
#       asker and where it stands (NearestText), that it costs tokens or
#       honor rather than gold (TokensText); which professions make it
#       (CraftText, CraftAlsoText); that nothing sells or makes it, so it is
#       looted, gathered or earned (NoVendorText), and then that players can
#       trade it (TradeText) -- or that it binds when picked up (BoundText).
#       Vendors of the other faction do not count; when only they sell it,
#       EnemyOnlyText says so.
#     * A place in a town or city -- a class or profession trainer, the bank,
#       the auction house, the inn, the flight master and the rest: what the
#       guards say when asked for directions (the gossip menus behind their
#       "What do you need directions to?") and what they mark on the minimap
#       (PlaceText, MarkText). A town, city, district or zone named in the
#       line ("in ironforge", "in goldshire", "sw") decides whose guards;
#       else the guards nearest the asker, within GuardRange. A line naming
#       somewhere with no such guards gets nothing, rather than another
#       town's answer. "where are the class trainers" gets that a guard
#       points you to each (HeadingText). Synonyms covers "ah", "fp", "lw"
#       and the like. A class's trainer is only meant when a trainer is
#       asked for (TrainerWords: "the mage district" is not the mage
#       trainer), and a profession's, without that, only by its own name
#       ("where do i buy fish" is not the fishing trainer).
#     * For FollowSeconds after such a question, a reply to a line from
#       whoever asked it, or from a bot that answered it, gets the same
#       answer (EarlierText) and that anyone who said otherwise got it wrong
#       (FollowText): a wrong answer gets put right.
#
#   Each bot is told this is how it is, and to answer from it in as many
#   words as its style takes (AnswerText): a blunt one says "reagent
#   vendors", a chatty one that they are in every city. The styles in
#   WrongOnPurpose -- the keyboard warrior -- are told the right answer too,
#   and to give a wrong one with a straight face (WrongText).
#
#   Built from the world database the first time anyone asks (well under a
#   second, once per restart; the log says how long). Zones come from the
#   world map; a district ("Trade District") only where the map around the
#   spot is loaded already -- nothing is loaded for this. Holiday-only
#   vendors and anything in an instance are left out. .ollama status talk
#   shows how many answers went into prompts.
#
#   Templates take {placeholders} as listed; no other braces, and no double
#   quotes inside a value (the server's config reader drops every one).
#
###############################################################################

#    OllamaChat.Knowledge.Enable
#        Default: 1
OllamaChat.Knowledge.Enable = 1

#    OllamaChat.Knowledge.QuestionWords
#    OllamaChat.Knowledge.NotAskingWords
#        A line with any of QuestionWords and none of NotAskingWords is a
#        question about where something is or how to get it. Words and
#        phrases as CrowdText reads them, separated by |.
#        Default: (below)
OllamaChat.Knowledge.QuestionWords = "where|wheres|whereabouts|who sells|what sells|anyone sell|anybody sell|anyone selling|anybody selling|who has|how do i get|how do you get|how to get|how can i get|how would i get|how do i find|how to find|any idea where|know where|cant find|cannot find|can not find"
OllamaChat.Knowledge.NotAskingWords = "wts|sell it|sell this|sell my|sell these|sell them|sell those|to sell|can i sell|do i sell|im selling|i am selling|i sell"

#    OllamaChat.Knowledge.TrainerWords
#        Words that ask for a trainer: "where can i learn first aid".
#        Default: (below)
OllamaChat.Knowledge.TrainerWords = "trainer|trainers|train|training|learn|learning|teach|teacher|teaches|teaching|spells|skill|skills"

#    OllamaChat.Knowledge.Synonyms
#        What players' shorthand stands for: TRIGGERS=WORDS, separated by |.
#        TRIGGERS are words or phrases separated by commas; WORDS are added
#        to the question when one is in it. "fp" adds every flight master's
#        name, so it finds the Gryphon Master in Stormwind and the Wind Rider
#        Master in Orgrimmar.
#        Default: (below)
OllamaChat.Knowledge.Synonyms = "ah,auctioneer,auctioneers=auction house|banker,bankers,vault=bank|fp,flight path,flight paths,flightmaster,flight master,flight masters=flight master gryphon wind rider bat handler hippogryph dragonhawk|innkeeper,innkeepers,hearth,tavern=inn|mail,mailbox,mailboxes=mailbox|tram,subway=deeprun tram|boat,boats,ship,ships,docks,harbour=harbor|zep,zepp,zeppelin,zeppelins=zeppelin master|guild charter,charter,tabard,tabards,make a guild,create a guild,start a guild=guild master|lockpicking,lockpick=locksmith|stable,stables,pet stable,stablemaster=stable master|weapon master,weapon trainer,weapon skill,weapon skills,weapons master=weapons trainer|battle master,battlemasters,bg,bgs,battleground,battlegrounds=battlemaster|haircut,hair,barbershop,barber shop=barber|pally,pallies=paladin|lock,locks=warlock|sham,shammy=shaman|dk,dks=death knight|lw,leather working=leatherworking|bs,black smithing,blacksmith=blacksmithing|jc,jewel crafting,jewelcrafter=jewelcrafting|ench,enchanter,enchant=enchanting|engi,eng,engy,engineer=engineering|alch,alchemist=alchemy|insc,scribe=inscription|herb,herbing,herbalist=herbalism|skin,skinner=skinning|tailor=tailoring|cook,chef=cooking|fish,fisher,fisherman=fishing|miner=mining|firstaid=first aid|sw=stormwind|org,orgri=orgrimmar|uc=undercity|tb=thunder bluff|darna=darnassus|exo=exodar|smc=silvermoon|shatt=shattrath|dal,dala=dalaran"

#    OllamaChat.Knowledge.GuardRange
#        How near the asker the nearest guard has to be, in yards, when the
#        line names no town.
#        Default: 500
OllamaChat.Knowledge.GuardRange = 500

#    OllamaChat.Knowledge.MaxGuardChars
#        A guard's directions are cut to about this many characters (at the
#        end of a sentence where one ends late enough).
#        Default: 240
OllamaChat.Knowledge.MaxGuardChars = 240

#    OllamaChat.Knowledge.ManyZones
#        Sold in this many zones or more is "all over" (SpreadManyText);
#        fewer, and the zones are named (SpreadSomeText).
#        Default: 8
OllamaChat.Knowledge.ManyZones = 8

#    OllamaChat.Knowledge.FollowSeconds
#        For this long after a question, whoever asked it and the bots that
#        answered it are on it: a reply to a line of theirs gets the answer
#        too. 0 turns that off.
#        Default: 120
OllamaChat.Knowledge.FollowSeconds = 120

#    OllamaChat.Knowledge.WrongOnPurpose
#        Chat styles that answer such questions wrong on purpose, separated
#        by |. Empty: nobody does.
#        Default: NAT_KEYBOARD
OllamaChat.Knowledge.WrongOnPurpose = "NAT_KEYBOARD"

#    OllamaChat.Knowledge.ItemText
#    OllamaChat.Knowledge.SpreadManyText
#    OllamaChat.Knowledge.SpreadSomeText
#    OllamaChat.Knowledge.SpreadOneText
#    OllamaChat.Knowledge.KindText
#    OllamaChat.Knowledge.TokensText
#    OllamaChat.Knowledge.NearestText
#    OllamaChat.Knowledge.CraftText
#    OllamaChat.Knowledge.CraftAlsoText
#    OllamaChat.Knowledge.NoVendorText
#    OllamaChat.Knowledge.EnemyOnlyText
#    OllamaChat.Knowledge.TradeText
#    OllamaChat.Knowledge.BoundText
#        An item's answer, in that order: ItemText {item}; then the Spread
#        that fits -- SomeText {zones}, OneText {vendor} {place} -- with
#        " -- " and KindText {kinds} after it when most vendors are one or
#        two kinds; TokensText when none of them takes gold; NearestText
#        {asker} {vendor} {place}; CraftText or, when vendors sell it too,
#        CraftAlsoText {professions}; EnemyOnlyText when only the other
#        faction's vendors sell it; NoVendorText when nothing sells or makes
#        it; BoundText when it binds when picked up, else TradeText when no
#        vendor sells it. Empty leaves that part out.
#        Default: (below)
OllamaChat.Knowledge.ItemText = "How to get {item}, as it is in the game:"
OllamaChat.Knowledge.SpreadManyText = "vendors all over sell it, in nearly every city and in many towns"
OllamaChat.Knowledge.SpreadSomeText = "vendors in {zones} sell it"
OllamaChat.Knowledge.SpreadOneText = "only {vendor}, in {place}, sells it"
OllamaChat.Knowledge.KindText = "mostly {kinds} vendors"
OllamaChat.Knowledge.TokensText = "It costs tokens or honor rather than gold."
OllamaChat.Knowledge.NearestText = "The nearest one to {asker} is {vendor}, in {place}."
OllamaChat.Knowledge.CraftText = "No vendor sells it, but players with {professions} can make it."
OllamaChat.Knowledge.CraftAlsoText = "Players with {professions} can make it too."
OllamaChat.Knowledge.NoVendorText = "No vendor sells it and no profession makes it: it is looted, gathered or earned from a quest."
OllamaChat.Knowledge.EnemyOnlyText = "Only the other faction's vendors sell it."
OllamaChat.Knowledge.TradeText = "Players can trade it, so the auction house might have some."
OllamaChat.Knowledge.BoundText = "It binds when picked up, so nobody can trade it to anyone."

#    OllamaChat.Knowledge.PlaceText
#    OllamaChat.Knowledge.MarkText
#    OllamaChat.Knowledge.HeadingText
#        A place's answer. PlaceText: {place} ("the leatherworking trainer"),
#        {town}, {guard} (what the guard says), {marked} (MarkText {mark},
#        what the guard marks on the minimap, or nothing when it marks
#        nothing). Under a heading with a few places -- Shattrath's two banks
#        -- {guard} has what is said of each. HeadingText, for a heading with
#        more -- every class's trainer: {heading}, {town}, {choices}.
#        Default: (below)
OllamaChat.Knowledge.PlaceText = "Where {place} is in {town}, as the guards there tell anyone who asks them for directions: '{guard}'{marked} Just telling them to ask a guard is a fine answer too."
OllamaChat.Knowledge.MarkText = "A guard also marks it on the minimap ({mark})."
OllamaChat.Knowledge.HeadingText = "In {town}, a guard asked for directions to the {heading} offers {choices}, and marks the one picked on the minimap -- so: ask a guard."

#    OllamaChat.Knowledge.EarlierText
#    OllamaChat.Knowledge.FollowText
#        A reply to a chat where the question was just asked: EarlierText
#        {asker} {question} before the answer, FollowText after it (not for
#        the WrongOnPurpose styles).
#        Default: (below)
OllamaChat.Knowledge.EarlierText = "{asker} asked a moment ago: '{question}'."
OllamaChat.Knowledge.FollowText = "If anyone in the chat said otherwise, they got it wrong."

#    OllamaChat.Knowledge.AnswerText
#    OllamaChat.Knowledge.WrongText
#        What a bot is told to do with the answer: AnswerText, or WrongText
#        for the WrongOnPurpose styles.
#        Default: (below)
OllamaChat.Knowledge.AnswerText = "That is how it is in the game: if you answer, answer from it and add nothing it does not say -- in a few words or a bit more, as your style goes."
OllamaChat.Knowledge.WrongText = "That is the right answer and you know it -- but, as you do, give a wrong one with a straight face, to wind them up: another real place, vendor or way from the game, never one you made up. If someone corrects you, double down."

###################################################################################################
# WANTED GEAR: "I NEED A WAND"
#
# In Wailing Caverns someone said they still needed a wand, and a bot sent
# them to kill a few more murlocs in the south, past the big bridge in the
# east -- none of it real, and asked "south of where?" it made up more. A
# line saying its speaker is after a kind of item now has each reply prompt
# told what is really so for the speaker's level and class, from the game's
# own data: in a dungeon, which of its bosses can drop one they could use
# (and whether it is down already this run), or that none does; a dungeon or
# two around their level where a boss can; what a profession makes of the
# kind around their level; and whether the bot answering could use one
# itself. It answers from that in its own way: the boss here, another
# dungeon, a crafter, hoping one drops, needing one too.
#
# The kinds: wands, staves, bows, guns, crossbows, thrown and ranged
# weapons, fist weapons, two-handers, swords, axes, maces, daggers,
# polearms, any weapon, shields, off-hands, cloaks, rings, necklaces,
# trinkets, and helms, shoulders, chest pieces, bracers, gloves, belts,
# leggings and boots of the armour they wear, and relics.
#
# Boss loot is read from the world database once, on the first such line
# (a few small queries): the dungeon finder's dungeons, their bosses as the
# instance encounters credit them, and the green-or-better gear their own
# loot tables drop -- not the world-drop tables half the world refers to.
###################################################################################################

#    OllamaChat.Wants.Enable
#        Default: 1
OllamaChat.Wants.Enable = 1

#    OllamaChat.Wants.Words
#        Saying you are after something: one of these (| between, a trailing *
#        matches any ending) comes before what you call the kind of item,
#        with only words like "a", "new", "good", "fukin", "to get" between
#        ("i still need a fukin wand", "where can i get a good shield", "lf
#        cloak"). Not a line asking someone else ("do you need a wand?",
#        "anyone need a wand?") or saying no ("dont need a wand").
#        Default: (below)
OllamaChat.Wants.Words = "need|needs|needed|needing|neeed|want|wants|wanna|looking for|lookin for|looking 4|lf|hunting for|after|could use|could do with|where|wish i had"

#    OllamaChat.Wants.FollowSeconds
#        For this long after, the speaker's next lines ("south of where?")
#        and their group's replies carry the same facts. 0: only the line
#        itself. At most 600.
#        Default: 120
OllamaChat.Wants.FollowSeconds = 120

#    OllamaChat.Wants.Text
#    OllamaChat.Wants.FollowText
#        What a reply prompt is told: Text for the line that says it,
#        FollowText for one a moment after (which may be about something
#        else). {speaker} {kind} ("a wand", "new shoulders") {level} {class}
#        {facts} (what is so, as sentences) {self} (whether the bot answering
#        could use one itself). Empty: nothing told.
#        Default: (below)
OllamaChat.Wants.Text = "{speaker} is after {kind}. What is really so about getting one, for a level {level} {class}: {facts} {self} Answer in your own way and style, from that: the boss here that can drop one, one of those dungeons, a crafter, the auction house, hoping one drops for them, needing one too, or just a word of sympathy. Never send them anywhere, or tell them to kill or buy anything, that is not in this."
OllamaChat.Wants.FollowText = "A moment ago {speaker} said they are after {kind}. What is really so about getting one, for a level {level} {class}: {facts} {self} If what you are answering is about that, answer from this, in your own way, and never send them anywhere, or tell them to kill or buy anything, that is not in it; if it is about something else, leave this be."

#    OllamaChat.Clock.FixWeekdays
#    OllamaChat.Clock.Words
#    OllamaChat.Clock.PromptText
#        "It is far too quiet for a Tuesday" -- on a Saturday. The model has
#        no calendar. FixWeekdays: a weekday a bot says as being today ("for a
#        tuesday", "on a tuesday", "its tuesday", "it is tuesday", "happy
#        tuesday", "today is tuesday") goes out as the server's real weekday;
#        "on tuesday", "next tuesday" and "last tuesday" are other days and
#        stay. Words: a line with any of these (CrowdText words, | between, a
#        trailing * matches any ending) is about days or times, and a bot
#        replying to it is told PromptText: {now} ("Saturday afternoon"),
#        {weekday}, {part_of_day}, {time} ("14:51", server time). The
#        time-of-day topic (EnvCommentTimeOfDay) has the weekday too. Empty
#        Words or PromptText turns the telling off.
#        Default: 1, (below)
OllamaChat.Clock.FixWeekdays = 1
OllamaChat.Clock.Words = "today|tonight|tomorrow|yesterday|weekend|weekday|this week|monday*|tuesday*|wednesday*|thursday*|friday*|saturday*|sunday*|what day|which day|what time|time is it|this morning|this afternoon|this evening|morning|afternoon|evening|midnight|bedtime|so late|so early|oclock|o clock|work tomorrow|school night"
OllamaChat.Clock.PromptText = "For everyone here it is {now} right now ({time} server time)."

#    OllamaChat.GuildEnvCommentGuildMOTDUnset
#        Used instead of GuildEnvCommentGuildMOTD when the guild's
#        message of the day is still "No message set." -- the text the game
#        gives every guild whose MOTD nobody ever wrote, which is every bot
#        guild. Read out as if someone had written it, bots made it a thing:
#        "no message set is my spirit animal". With this they know it is the
#        game's default and that nobody set one -- and they call it the gmotd
#        or the guild message of the day, so a guildmate knows what they mean.
#        Pipe-separated (|) list; empty turns the topic off for those guilds.
#        (No double quotes inside a value: the server's config reader drops
#        every one of them.)
#        Placeholders: {guild_motd}
#        Default: (below)
OllamaChat.GuildEnvCommentGuildMOTDUnset = "the guild message of the day (the note at the top of the guild window): nobody has ever set one, so it still shows the game's default text, No message set. Call it the gmotd or the guild message of the day, so everyone knows what you mean, and say nobody has set one rather than repeating the default text."

#    OllamaChat.GuildEventTypeGuildMOTD
#        Event type for a new guild message of the day. When someone
#        sets one (/gmotd), a guildmate or two react in guild chat:
#        "raid tonight 8pm" gets "im in". The game does not say who
#        set it, so the guild leader stands for it when online,
#        else a real player of the guild who is; a guild with no
#        real player online is not told. The game's own "No message
#        set." is not reacted to. GuildChatterBotCommentChance and
#        GuildChatterMaxBotsPerEvent apply as for the other events.
#        Default: set the guild message of the day to:, 100
OllamaChat.GuildEventTypeGuildMOTD = set the guild message of the day to:
OllamaChat.GuildEventTypeGuildMOTD_Chance = 100

#    OllamaChat.Rolls.Enable
#        Loot rolls the bots can see. A player lost a greed roll with a 1,
#        typed "1 lol", and got "don't spend it all at once": the rolls only
#        reach the players' chat frames. Now each loot roll in a group with a
#        real player goes into the group's chat transcript once it is decided
#        (NoteText), so a reply knows what "1 lol" was about.
#        Default: 1
OllamaChat.Rolls.Enable = 1

#    OllamaChat.Rolls.NoteText
#        {item}, {rolls} ("Ynos 93 (greed), Kami 1 (greed)"), {winner}.
#        Default: (below)
OllamaChat.Rolls.NoteText = "loot roll for {item} (1 to 100, highest wins; need beats greed): {rolls} -- {winner} won it."

#    OllamaChat.Rolls.LowRoll
#    OllamaChat.Rolls.HighRoll
#    OllamaChat.Rolls.ReactChance
#    OllamaChat.Rolls.ReactCooldownSeconds
#    OllamaChat.Rolls.LowPrompt
#    OllamaChat.Rolls.HighPrompt
#        A real player's roll of LowRoll or less (as unlucky as it gets) or
#        HighRoll or more (as lucky): ReactChance percent of the time a bot
#        in the group says something about it in party chat, not twice in
#        ReactCooldownSeconds in one group. Prompts: {bot_name}, {bot_level},
#        {bot_race}, {bot_class}, {bot_personality}, {player_name}, {roll},
#        {item}, {outcome} (", and won it", ", and Ynos won it on a need
#        roll"). 0 ReactChance: never.
#        Default: 2, 99, 50, 60, (below)
OllamaChat.Rolls.LowRoll = 2
OllamaChat.Rolls.HighRoll = 99
OllamaChat.Rolls.ReactChance = 50
OllamaChat.Rolls.ReactCooldownSeconds = 60
OllamaChat.Rolls.LowPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}. Your chat style: {bot_personality} In your group's loot roll for {item}, {player_name} just rolled {roll} out of 100 -- about as unlucky as a roll gets{outcome}. Say something about it in party chat the way players do: a quick tease, or feel their pain. Under 10 words, no name in front, no quotes."
OllamaChat.Rolls.HighPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}. Your chat style: {bot_personality} In your group's loot roll for {item}, {player_name} just rolled {roll} out of 100 -- about as lucky as a roll gets{outcome}. React in party chat the way players do: gz, lucky, nice roll, or a joke about it. Under 10 words, no name in front, no quotes."

###############################################################################
#
#   OLLAMA CHAT - A POTION IN A PINCH
#
###############################################################################

#    OllamaChat.Potions.Enable
#    OllamaChat.Potions.HealthPct
#    OllamaChat.Potions.ManaPct
#        "That pot saved my arse." A bot in a dungeon that uses a healing
#        potion at HealthPct percent health or less -- the tank on its last
#        legs -- or a mana potion at ManaPct percent mana or less -- the
#        healer running dry -- and comes through the fight alive may say so
#        in party once the fight is over and it has caught its breath. What
#        counts is what the game says the item does: a consumable whose spell
#        heals (a healing potion, a healthstone) or gives back mana (a mana
#        potion, a mana gem). Not when it died anyway, nor in a group without
#        a real player.
#        Default: 1, 35, 20
OllamaChat.Potions.Enable = 1
OllamaChat.Potions.HealthPct = 35
OllamaChat.Potions.ManaPct = 20

#    OllamaChat.Potions.Chance
#    OllamaChat.Potions.Personalities
#    OllamaChat.Potions.BotCooldownMinutes
#    OllamaChat.Potions.GroupCooldownSeconds
#        How likely a bot is to say so, by its chat style: Personalities is
#        "KEY:percent" pairs, | separated (the hype merchant nearly always,
#        the quiet one hardly ever), and Chance is for a style not listed. At
#        most once every BotCooldownMinutes for a bot, and one bot in a group
#        every GroupCooldownSeconds.
#        Default: 35, (below), 15, 120
OllamaChat.Potions.Chance = 35
OllamaChat.Potions.Personalities = "NAT_HYPE:70|NAT_EXCITABLE:65|NAT_JOKER:60|NAT_BANTER:55|NAT_PRANKSTER:50|NAT_REACTOR:50|NAT_GRUMBLER:50|NAT_NEWBIE:50|NAT_BUTTERFLY:50|NAT_SOCIAL:45|NAT_DEADPAN:45|NAT_BINGER:45|NAT_FRIENDLY:40|NAT_TROLL:40|NAT_RAIDER:40|NAT_KEYBOARD:35|NAT_RUDE:30|NAT_MINMAXER:30|NAT_EXPERT:30|NAT_PROPER:25|NAT_HELPFUL_VET:25|NAT_CHILL:25|NAT_TERSE_VET:10|NAT_LONER:10|NAT_QUIET:5"
OllamaChat.Potions.BotCooldownMinutes = 15
OllamaChat.Potions.GroupCooldownSeconds = 120

#    OllamaChat.Potions.HealPrompt
#    OllamaChat.Potions.ManaPrompt
#        What the bot is told, for a healing potion and for a mana one:
#          {bot_name} {bot_level} {bot_race} {bot_class}
#          {bot_personality}  its chat style
#          {role}      the group's tank, the group's healer, or one of the
#                      group's damage dealers
#          {dungeon}   where: Wailing Caverns
#          {item}      what it used, with a or an: a Healing Potion
#          {pct}       its health or mana, percent, when it did
#        "{~a|b|c}" is one of them, picked each time, so the line is not the
#        same every time. No double quotes inside it.
#        Default: (below)
OllamaChat.Potions.HealPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, {role} in a {dungeon} run. Your chat style: {bot_personality} In the fight that just ended your health got down to {pct}%, so you used {item}, and it kept you alive. Say something about it in party chat the way players do -- {~that the pot saved you|how close that was|a joke about it|being glad you had one on you} -- in your own style. One short line, 3 to 12 words, no quotes, no name in front."
OllamaChat.Potions.ManaPrompt = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class}, {role} in a {dungeon} run. Your chat style: {bot_personality} In the fight that just ended you were down to {pct}% mana, so you used {item}, and you all pulled through. Say something about it in party chat the way players do -- {~that the pot saved the day|how close that was|a joke about it|being glad you had one on you} -- in your own style. One short line, 3 to 12 words, no quotes, no name in front."

###############################################################################
#
#   OLLAMA CHAT - MINGLING: BOTS CHATTING AMONG THEMSELVES IN /SAY
#
#   In a city a real player had bots talking to them -- a wave as they
#   passed, an answer to their /say -- and bots arguing in General, but two
#   bots standing next to each other never had a word for each other. Now,
#   while a real player is in a city and not fighting, two or three idle
#   bots near them now and then get chatting in /say: a few lines, the way
#   people standing about do, ending with a laugh, a goodbye or someone
#   heading off. Several can be going at once at different spots, whatever
#   General is doing. Bots hanging out at a spot (CITY HANGOUTS) are picked
#   first; one walking past stops to talk.
#
#   One generation writes the whole exchange (PromptTemplate), so it has a
#   start and an end and costs one request instead of one per line; then each
#   line goes out as that bot's own /say, after a pause to read the one before
#   and the time to type it (TypingSimulation*), through the same checks as
#   any other line. A line can be an emote at the other one -- "Grigohm laughs
#   at Thimack." -- and whoever is spoken to turns to the speaker. Other bots
#   in earshot leave them to it.
#
#   It stops early when one of them is wanted (a fight, an invite, a trade, a
#   queue), walks off or logs out, when a line is held back (a stock phrase,
#   a line it said itself lately), when no real player can hear it any more,
#   or when a real player says something to one of them in /say -- who then
#   gets an answer the usual way.
#
#   And now and then two bots standing close just greet each other without a
#   word (Mingle.Emote.*).
#
#   .ollama status city shows how many were asked for, written, finished and
#   cut.
#
###############################################################################

#    OllamaChat.Mingle.Enable
#        Default: 1
OllamaChat.Mingle.Enable = 1

#    OllamaChat.Mingle.CitiesOnly
#        Only near a real player in a capital or a hub town (CITIES). 0: near
#        a real player anywhere outside instances.
#        Default: 1
OllamaChat.Mingle.CitiesOnly = 1

#    OllamaChat.Mingle.GapMinSeconds
#    OllamaChat.Mingle.GapMaxSeconds
#    OllamaChat.Mingle.StartChance
#        Every GapMin..GapMax seconds near each real player, at random, an
#        exchange starts with StartChance (0-100): one little chat every 5
#        to 30 minutes. When none can start just then (two bots free to have
#        it, one already going on near them, the model busy) it tries again
#        a minute or so later, not a whole gap. The first near someone who
#        has just turned up waits a minute to GapMin.
#        Default: 300, 1800, 100
OllamaChat.Mingle.GapMinSeconds = 300
OllamaChat.Mingle.GapMaxSeconds = 1800
OllamaChat.Mingle.StartChance = 100

#    OllamaChat.Mingle.MaxActive
#    OllamaChat.Mingle.MaxNearPlayer
#        At most this many at once on the realm, and near any one real player.
#        Default: 4, 1
OllamaChat.Mingle.MaxActive = 4
OllamaChat.Mingle.MaxNearPlayer = 1

#    OllamaChat.Mingle.HearRange
#    OllamaChat.Mingle.PairRange
#    OllamaChat.Mingle.ThreeChance
#        The bots are within HearRange yards of the real player, so they hear
#        it, and within PairRange of each other. ThreeChance (0-100): a third
#        one standing close joins in.
#        Default: 25, 9, 25
OllamaChat.Mingle.HearRange = 25
OllamaChat.Mingle.PairRange = 9
OllamaChat.Mingle.ThreeChance = 25

#    OllamaChat.Mingle.MinLines
#    OllamaChat.Mingle.MaxLines
#    OllamaChat.Mingle.MaxEmotes
#        How many lines one is asked to run to, emotes included: rolled
#        twice between MinLines and MaxLines and the lower taken, so most are
#        short. A model that needs a line or two more to finish properly gets
#        them -- never more than MaxLines + 4. At most MaxEmotes are emotes.
#        Default: 2, 10, 1
OllamaChat.Mingle.MinLines = 2
OllamaChat.Mingle.MaxLines = 10
OllamaChat.Mingle.MaxEmotes = 1

#    OllamaChat.Mingle.BotCooldownSeconds
#        A bot that took part waits this long before the next one.
#        Default: 600
OllamaChat.Mingle.BotCooldownSeconds = 600

#    OllamaChat.Mingle.QueueLimit
#    OllamaChat.Mingle.NumPredict
#        Nobody is waiting on one, so none is asked for while more than
#        QueueLimit requests are waiting for the model: answers to people come
#        first. NumPredict: the token limit for writing one, instead of
#        NumPredict -- a whole exchange is longer than one line.
#        Default: 4, 320
OllamaChat.Mingle.QueueLimit = 4
OllamaChat.Mingle.NumPredict = 320

#    OllamaChat.Mingle.ReadMinMs
#    OllamaChat.Mingle.ReadMaxMs
#        Between one line and the next: a pause to read it (a third of it when
#        the same one carries on), then the time to type the next one
#        (TypingSimulation*). An emote comes quicker.
#        Default: 1200, 3500
OllamaChat.Mingle.ReadMinMs = 1200
OllamaChat.Mingle.ReadMaxMs = 3500

#    OllamaChat.Mingle.PromptTemplate
#        What the model is asked, to write one. Placeholders:
#          {count}       Two or Three
#          {where}       the spot they are at, or the area and city
#          {at}          the same, to follow "standing near each other": "in
#                        the Trade District in Stormwind", "outside the bank
#                        in Orgrimmar" -- a spot named with its own
#                        preposition keeps it, anything else gets "in"
#          {when}        the day and the time of day ("Saturday afternoon")
#          {people}      a line each: what the others can see of them (level,
#                        race, class, the mount they are riding, their hunter
#                        pet, demon or companion pet -- each named as what it
#                        is -- sitting on a bench) and their chat style --
#                        each on a new line; then, with ThingsText, what the
#                        quests and items in their "lately" are
#          {relation}    MingleSameGuildText or MingleStrangersText
#          {premise}     what gets them talking (Premises)
#          {example}     the format, with their names -- on new lines
#          {lines}       how many lines this one runs to
#          {emotes}      the emotes they can use, as /commands (Emotes)
#          {max_emotes}  MaxEmotes
#        (No double quotes inside it: the server's config reader drops every
#        one of them.)
#        Default: (below)
OllamaChat.Mingle.PromptTemplate = "{count} World of Warcraft players are standing near each other {at} and get chatting in /say. It is {when}. They are:{people}{relation} What gets them talking: {premise}. Write what they type, one message per line, each line starting with the speaker's name and a colon, like this:{example}About {lines} lines in all, mostly taking turns. It reads like a real chat: every line follows on from the one before it, answering what was just asked, reacting to what was just said, or asking something back, and nobody answers a question nobody asked. A greeting gets a greeting back, or a question. When one of them says what they have been doing, it is what they have been doing lately as told above, put the way a player would in a few words, what and where; with nothing told, they have not been up to much. They can see each other's level and class just by looking, so nobody says their own level unless asked, and they hardly ever ask. Each line is what that player types: short (2 to 12 words), casual, in their own chat style, mostly lowercase, but a question ends with a question mark, and a line can end with an exclamation mark where it fits. Reactions and goodbyes are as short as players make them, in each one's own style. Instead of words, a line can be just an emote at the other one, written as a slash command ({emotes}), at most {max_emotes} in all. It ends the way a chat between players does: a laugh, a goodbye, someone heading off, or simply done. No narration, no actions in asterisks, no quotation marks, and nothing made up from the game -- no item, quest, NPC, creature, place, mount or pet that is not really in it, and nobody riding a mount or with a pet out but as told above (a hunter's pet, a warlock's demon or a companion pet is no mount); plainly made-up fun is fine as an imagine-if. A famous line from a film or show is fine now and then, but never say what it is from."

#    OllamaChat.Mingle.Premises
#        What gets them talking, one picked each time: a premise only the
#        lowest level among them fits (a tag like [15+] or [10-39] in front,
#        as for Conversation.Premises), and not one used lately. Things people
#        standing about chat about -- not the arguments General has. | separated.
#        A premise can also need something to be there, so it is about
#        something real: [mount] one of them is riding a mount, [pet] one of
#        them has a pet or companion out, [loot] one of them got something
#        worth showing off lately, [quest] one of them handed in a quest
#        lately (what a bot has been up to, Lately). "[mount] one of them
#        admires the mount the other is riding" is never picked for two on
#        foot. [duel]: the two of them could go out to the gates and duel
#        there now (mod-playerbots-plus's Duels.*: of a side, within
#        Duels.LevelGap levels, near a duel spot) -- {duel_where} in it is
#        where ("outside the gates of Stormwind"), and once the last line is
#        said they walk out there and fight it out; with no duel spot near,
#        or without mod-playerbots-plus, nobody talks of a duel at all.
#        [horde] or [alliance]: only that side's bots (only one side mingles
#        together). Tags go in front, with a level tag or without.
#        Default: (below)
OllamaChat.Mingle.Premises = "saying hello and asking what the other has been up to|[quest] one of them just got back from questing and moans about it|[quest] one of them asks the other about the quest they just handed in|[mount] one of them admires the mount the other is riding|[pet] one of them admires the other's pet or companion|one of them admires the other's gear|one of them teases the other about their race or class, all in good fun|swapping tips about levelling their classes|[duel] one of them challenges the other to a duel, and they agree to head {duel_where} and fight it out|one of them asks the other if they have a few silver to spare|[loot] one of them shows off something they got lately|people-watching: the players walking past|levelling their professions|which zone is the worst to quest in|being lost in this city|what they are saving their gold for|a funny death one of them had today|one of them is about to log off|their guilds, or not having one|an imagine-if one of them dreams up, plainly made up for a laugh|[alliance] gnomes|[horde] tauren|murlocs|[15+] whether to run a dungeon together later|[15+] a dungeon one of them ran earlier|[20+] getting their first mount|[40+] the epic mount they are saving for|[68+] flying mounts"

#    OllamaChat.Mingle.DuelChance
#        Two who could go out to the gates and duel ([duel] in
#        Mingle.Premises) talk themselves into one this share of the time
#        (percent); otherwise the duel is one premise among the rest. When
#        they do, they walk out there at the end and fight it out.
#        Default: 25
OllamaChat.Mingle.DuelChance = 25

#    OllamaChat.Mingle.SideText
#    OllamaChat.Mingle.HomeCityText
#        Outlook.SideText and Outlook.HomeCityText for the people in a /say
#        exchange (only one side mingles together): their side and its
#        cities ({side}, {cities}), and, standing in one of those, that they
#        are home ({city}). Added after the prompt. Empty leaves it out.
#        Default: "They all play {side}: their own side's cities are {cities}.",
#                 "{city} is one of those, so they are safe here, and its guards are on their side."
OllamaChat.Mingle.SideText = "They all play {side}: their own side's cities are {cities}."
OllamaChat.Mingle.HomeCityText = "{city} is one of those, so they are safe here, and its guards are on their side."

#    OllamaChat.Mingle.ChatText
#        What chat is like where they stand, for a /say exchange between bots,
#        if it comes up: that General and Trade show in every player's own
#        chat window, and with {chat} how busy they have really been
#        (Outlook.ChatStates). An exchange is written all at once, so it is
#        told this every time rather than only when chat comes up, as a reply
#        is (Outlook.ChatText). Added after the prompt. Empty leaves it out.
#        Default: "If chat comes up: General, and in the cities Trade, show in each player's own chat window wherever they stand, so nobody goes anywhere to read them, and {chat}."
OllamaChat.Mingle.ChatText = "If chat comes up: General, and in the cities Trade, show in each player's own chat window wherever they stand, so nobody goes anywhere to read them, and {chat}."

#    OllamaChat.Mingle.RaceText
#        Race.UseText for one of the people in a /say exchange between bots,
#        on the same chance: {name}, {a_race}, {race_plural}, {phrases}. Two
#        orcs meeting might zug zug each other. Empty turns it off.
#        Default: (below)
OllamaChat.Mingle.RaceText = "{name} is {a_race}: if it fits, they could slip in something {race_plural} say in the game, just for fun: {phrases}."

#    OllamaChat.Mingle.Emotes
#        The emotes an exchange can use, offered in the prompt. One the model
#        uses that is not a WotLK emote is left out; one in Presence.SkipEmotes
#        (rude or gross) is never done. | separated.
#        Default: (below)
OllamaChat.Mingle.Emotes = "wave|laugh|bow|nod|cheer|grin|shrug|flex|chuckle|wink|thank|salute|applaud|facepalm|sigh|smile|poke|hug|point|giggle|agree|clap"

#    OllamaChat.Mingle.SameGuildText
#    OllamaChat.Mingle.StrangersText
#        {relation}: when they are all in one guild ({names}, {guild}), and
#        when not.
#        Default: (below)
OllamaChat.Mingle.SameGuildText = "{names} are in the same guild, {guild}."
OllamaChat.Mingle.StrangersText = "They do not know each other, beyond seeing each other around."

#    OllamaChat.Mingle.LatelyText
#        Added to each of them in {people} when there is something from the
#        last Lately.Minutes (see WHAT A BOT HAS BEEN UP TO): what it would
#        answer "what you up to?" with, instead of something made up.
#        {name}, {lately}. Empty leaves it out.
#        Default: (below)
OllamaChat.Mingle.LatelyText = " What {name} has been doing lately: {lately}."

#    OllamaChat.Mingle.ThingsText
#        After the people, when what they have been up to lately names a quest
#        or an item (a quest handed in, something got): what each one is, so a
#        line about it is about what it really is -- a quest in Duskwood for
#        level 32, not a person; a pair of bracers, not a boss. {things}: as
#        Links.DescribeText's. Empty leaves it out.
#        Default: (below)
OllamaChat.Mingle.ThingsText = "So they know what those are: {things}."

#    OllamaChat.Mingle.LinksText
#        Added to the prompt while Links.Enable is on: names in square
#        brackets, which become links when the line goes out, as in any other
#        bot line -- "how long does [Are We There, Yeti?] take?". A name
#        nothing in the game matches loses its brackets. Empty: no links in
#        these.
#        Default: (below)
OllamaChat.Mingle.LinksText = "When a line asks about, offers, asks for or shows off a particular item or quest, its exact name goes in square brackets, the way players link things in chat; named in passing or in a joke, it is written plainly."

#    OllamaChat.Mingle.Emote.Enable
#    OllamaChat.Mingle.Emote.MinSeconds
#    OllamaChat.Mingle.Emote.MaxSeconds
#    OllamaChat.Mingle.Emote.Chance
#    OllamaChat.Mingle.Emote.ReturnChance
#    OllamaChat.Mingle.Emote.Range
#    OllamaChat.Mingle.Emote.BotCooldownSeconds
#    OllamaChat.Mingle.Emote.Greetings
#        Two bots greeting each other without a word, near a real player in a
#        city: every MinSeconds..MaxSeconds with Chance (0-100), two free bots
#        within Range yards of each other -- one of Greetings at the other,
#        and with ReturnChance one back a moment later (a wave for a wave, a
#        bow for a bow). A bot greets again after BotCooldownSeconds. No
#        model is asked: it costs nothing. The first near someone who has
#        just turned up waits a minute to MinSeconds.
#        Default: 1, 300, 1200, 50, 60, 8, 300, (below)
OllamaChat.Mingle.Emote.Enable = 1
OllamaChat.Mingle.Emote.MinSeconds = 300
OllamaChat.Mingle.Emote.MaxSeconds = 1200
OllamaChat.Mingle.Emote.Chance = 50
OllamaChat.Mingle.Emote.ReturnChance = 60
OllamaChat.Mingle.Emote.Range = 8
OllamaChat.Mingle.Emote.BotCooldownSeconds = 300
OllamaChat.Mingle.Emote.Greetings = "wave|nod|bow|smile|hello|salute|wink|cheer|grin"

###############################################################################
#
#   OLLAMA CHAT - ASKS WITH A REAL REASON
#
#   Real people in General ask for a Hogger group, where potions are sold,
#   for a few silver as a new player, or give away loot they cannot use. Now
#   and then (Chance) an ambient line is one of these, read off the bot
#   itself, and its reason is remembered:
#
#     quest    an elite, group or dungeon quest in its log that it is the
#              right level for -- out in the world one for that zone, in a
#              city any ("LF hogger group", "LFG deadmines, have the quests");
#     errand   in a city, a "where's the ...?" it actually needs: a repair
#              with gear nearly broken, a vendor or the auction house with its
#              bags full, potions when it has none, the riding trainer at 20
#              with no riding, its profession's trainer at a skill cap;
#     spare    something it carries and has no use for, linked, free to
#              whoever wants it ("me!" then claims it: WHAT BOTS CARRY above);
#     short    a low-level bot with hardly any money, asking for a few silver.
#
#   A bot in a real player's group asks there, and only about a quest or a
#   spare thing; otherwise in General (Trade for spare things in a city, the
#   LFG channel for quests when it is in it), or /say with someone in earshot.
#   For RememberMinutes afterwards, every reply prompt of that bot carries why
#   it asked (ReasonText), so "why do you need hogger?" gets the real answer.
#
###############################################################################

#    OllamaChat.Needs.Enable
#    OllamaChat.Needs.Chance
#        Of the ambient lines bots near real players say, the share (0-100)
#        that try one of these first.
#        Default: 1, 20
OllamaChat.Needs.Enable = 1
OllamaChat.Needs.Chance = 20

#    OllamaChat.Needs.BotCooldownMinutes
#    OllamaChat.Needs.RepeatMinutes
#    OllamaChat.Needs.ZoneCooldownSeconds
#        A bot asks at most once per BotCooldownMinutes, never the same thing
#        twice in RepeatMinutes, and one zone hears one ask of each kind per
#        ZoneCooldownSeconds, so General is not a wall of LFG.
#        Default: 20, 60, 300
OllamaChat.Needs.BotCooldownMinutes = 20
OllamaChat.Needs.RepeatMinutes = 60
OllamaChat.Needs.ZoneCooldownSeconds = 300

#    OllamaChat.Needs.RememberMinutes
#        How long it remembers why it asked.
#        Default: 15
OllamaChat.Needs.RememberMinutes = 15

#    OllamaChat.Needs.WeightQuest
#    OllamaChat.Needs.WeightErrand
#    OllamaChat.Needs.WeightSpare
#    OllamaChat.Needs.WeightShort
#        Among the kinds it has something for, how likely each is. 0 turns a
#        kind off. A spare thing is only ever offered free with
#        Bags.GiveAway on: off, there is nothing spare to offer.
#        Default: 40, 25, 25, 10
OllamaChat.Needs.WeightQuest = 40
OllamaChat.Needs.WeightErrand = 25
OllamaChat.Needs.WeightSpare = 25
OllamaChat.Needs.WeightShort = 10

#    OllamaChat.Needs.ShortMaxLevel
#    OllamaChat.Needs.ShortCopperPerLevel
#        Up to this level, a bot with less money than its level times this
#        (in copper: 1200 is 12 silver a level) may ask for a few silver.
#        Default: 15, 1200
OllamaChat.Needs.ShortMaxLevel = 15
OllamaChat.Needs.ShortCopperPerLevel = 1200

#    OllamaChat.Needs.PromptTemplate
#        The line's prompt. Placeholders: {bot_name}, {bot_level},
#        {bot_race}, {bot_class}, {bot_zone}, {bot_personality}, {channel}
#        ("General", "party chat", "/say"), {need} (one of the Ask* below).
OllamaChat.Needs.PromptTemplate = "You are {bot_name}, a level {bot_level} {bot_race} {bot_class} in {bot_zone}. Your chat style: {bot_personality} {need} Write the line you type into {channel} for it, the way players do: short and plain, 2 to 12 words, no greeting, no name in front, nothing made up beyond what is given here."

#    OllamaChat.Needs.ReasonText
#        Added to the bot's reply prompts afterwards. {reason}: one of the
#        Reason* below.
OllamaChat.Needs.ReasonText = "A little while ago you asked something in chat because {reason}. If anyone asks about it or answers it, that is what it was about."

#    OllamaChat.Needs.PlanText
#    OllamaChat.Needs.PlanWords
#    OllamaChat.Needs.PlanMaxQuests
#        Asked what it is up to (a PlanWords phrase: "what you doing?",
#        "going for yowler?"), or a line naming one of its quests or what one
#        needs killed or brought, a bot's reply prompt gets what it is really
#        doing: where it is, and up to PlanMaxQuests of its quests -- those
#        the line names first -- with how far along it is. {doing}: "you are
#        in Duskwood; your quests: [Wanted: Yowler] (kill Yowler 0/1), ...".
#        So "you going to do yowler?" gets "yeah still need him", not "nah
#        just chilling". Empty PlanText turns it off.
#        Default: (below), 4
OllamaChat.Needs.PlanText = "What you are actually doing right now: {doing}. Answer from that, never from anything made up: if they ask about one of these, you are on it; if they offer to help with one, that is useful to you."
OllamaChat.Needs.PlanWords = "what you doing|what u doing|what are you doing|what r u doing|whatcha doing|watcha doing|wyd|what you up to|what u up to|what are you up to|you up to|you going|u going|going to do|gonna do|going for|you after|u after|plans|plan|heading|where you going|where u going|where are you going|wanna do|want to do|need help|need a hand|help with|group for|questing|quest|quests|working on|farming|you killing|u killing"
OllamaChat.Needs.PlanMaxQuests = 4

#    OllamaChat.Needs.AskQuest
#    OllamaChat.Needs.AskDungeon
#    OllamaChat.Needs.ReasonQuest
#        {quest} ("[Wanted: Hogger]", linked), {target} (" (you have to
#        kill Hogger)", or empty), {where} (its zone, or the dungeon), {kind}
#        ("an elite quest", "a group quest for 3 players", "a dungeon quest"),
#        {objective} (what the quest log says it asks, "Bring the Huge Gnoll
#        Claw to Marshal Dughan."). Only a quest with something to fight in it
#        -- a kill, or a quest item, which comes off something killed -- gets
#        a group ask: nobody needs a healer to fetch a bronze tube.
OllamaChat.Needs.AskQuest = "You are on the quest {quest} in {where}{target}, {kind}, too much to do alone at your level. What it asks: {objective} Ask if anyone wants to group up for it, the way players looking for a group do, saying what it is you need a hand with."
OllamaChat.Needs.AskDungeon = "You have {quest}, a quest for {where}, in your log. Ask if anyone wants to run {where}, the way players looking for a dungeon group do."
OllamaChat.Needs.ReasonQuest = "you are on {quest} in {where}{target}, {kind}, and need people for it (it asks: {objective}); anyone who wants to come can invite you"

#    OllamaChat.Needs.AskErrand
#    OllamaChat.Needs.ReasonErrand
#        {city}, {why} ("your [Worn Shortsword] is nearly broken", "your bags
#        are full", "you have no healing potions left", "you are level 20
#        and still cannot ride", "your Mining is stuck at 75 until you train
#        the next rank"), {what} ("where you can get your gear repaired
#        here", "where the nearest vendor or the auction house is", ...).
OllamaChat.Needs.AskErrand = "You are in {city} and {why}, so you want to know {what}. Ask, the way a player who is not sure where things are would."
OllamaChat.Needs.ReasonErrand = "you are in {city} and {why}, so you asked {what}"

#    OllamaChat.Needs.AskSpare
#    OllamaChat.Needs.ReasonSpare
#        {item} ("[Linen Cloth] x12"), {looted} (", which you just looted,"
#        or empty).
OllamaChat.Needs.AskSpare = "You have {item}{looted} in your bags and no use for it. Offer it, free, to anyone who wants it, naming it in square brackets."
OllamaChat.Needs.ReasonSpare = "you offered {item}, which you have no use for: whoever wants it can have it, in a trade"

#    OllamaChat.Needs.AskShort
#    OllamaChat.Needs.ReasonShort
#        {money} ("43s"), {want} ("your next skills at the trainer", "a
#        bigger bag").
OllamaChat.Needs.AskShort = "You are new and have only {money} to your name, saving for {want}. Ask if anyone could spare a few silver, the way new players do: friendly, not pushy."
OllamaChat.Needs.ReasonShort = "you only have {money} and are saving for {want}, so you asked for a few silver"

###############################################################################
#
#   OLLAMA CHAT - LEVEL, CLASS AND WHAT BOTS KNOW
#
#   The system prompt makes every bot a player who has "played for years",
#   so on its own a level 6 gnome complains about repair bills and a mage
#   offers to heal. Each prompt gets up to three short sentences about the
#   bot itself:
#
#     level      what fills a player's days at its level (LevelBands):
#                first quests at 6, Outland at 64, heroics and raids at 80;
#     class      which roles its class can fill: a mage only does damage, so
#                it never offers to tank or heal. Classes with more than one
#                role also say which one the bot plays right now;
#     knowledge  what anyone can see of another player (KnowledgeText), so
#                nobody comments on your unspent talents, gold or bags;
#     facts      nothing from the game made up (FactsText): every item, quest,
#                creature and place a bot names is really in the game, and
#                what it cannot remember it says it cannot remember.
#
#   Conversation premises can carry a level tag (see
#   Conversation.Premises), so Ulduar comes up between level 80s.
#
###############################################################################

#    OllamaChat.Outlook.Enable
#        Default: 1
OllamaChat.Outlook.Enable = 1

#    OllamaChat.Outlook.LevelBands
#        One sentence per level range, separated by |: "1-9: text",
#        "60-69: text", "80: text" or "80+: text". The first range that holds
#        the bot's level is used; a level no range holds gets nothing.
#        Placeholder: {level}. Keep these about the bot's own stage of the
#        game: where it quests, what it runs, what it is working toward.
OllamaChat.Outlook.LevelBands = "1-9: Your character is only level {level}, brand new and still in its starting area, so you talk like someone just starting out.|10-19: Your character is level {level}: early days, questing in the first big zones and trying the first dungeons.|20-39: Your character is level {level}, partway through levelling in the old world.|40-57: Your character is level {level}, well into the old world, with Outland still ahead.|58-69: Your character is level {level}, levelling in Outland, with Northrend still ahead.|70-79: Your character is level {level}, levelling in Northrend.|80: Your character is level 80, the level cap: heroics, raids, gear and gold fill your days."

#    OllamaChat.Outlook.LevelPhrases
#        A backstop for when the model slips: things only players of some
#        levels say, as "[40+] repair bill" or "[70-80] heroic", separated by
#        |. A line from a bot outside that range is not said. A phrase may be
#        listed for more than one range. Lines answering someone who spoke to
#        the bot directly are exempt, and so is a phrase the line being
#        answered used itself ("anyone for naxx?" -> "naxx? im only 12 lol").
#        Matched on whole words; a trailing * matches any word starting with
#        the rest. Outland and Northrend zones are on it too: a level 20 has
#        no business talking about Sholazar. Empty disables.
OllamaChat.Outlook.LevelPhrases = "[40+] repair bill|[40+] repair bills|[40+] repair costs|[70+] heroic|[70+] heroics|[70+] naxx|[70+] naxxramas|[75+] ulduar|[75+] icc|[75+] icecrown citadel|[75+] wintergrasp|[60+] gear score|[60+] gearscore|[80] emblems|[80] emblem of|[60+] epic flying|[55+] outland|[55+] hellfire|[55+] hellfire peninsula|[55+] zangarmarsh|[55+] terokkar|[55+] nagrand|[55+] blades edge|[55+] netherstorm|[55+] shadowmoon valley|[55+] shattrath|[55+] shatt|[65+] northrend|[65+] borean tundra|[65+] howling fjord|[65+] dragonblight|[65+] grizzly hills|[65+] zuldrak|[65+] zul drak|[65+] sholazar|[65+] sholazar basin|[65+] storm peaks|[65+] icecrown|[65+] crystalsong"

#    OllamaChat.Outlook.ClassRoles
#        Tell each bot which roles its class can fill (warrior and death
#        knight: tank or damage; priest and shaman: heal or damage; paladin
#        and druid: all three; the rest: damage only) and which one it is
#        set up for now.
#        Default: 1
OllamaChat.Outlook.ClassRoles = 1

#    OllamaChat.Outlook.KnowledgeText
#        What a bot can know about other players. Empty disables.
OllamaChat.Outlook.KnowledgeText = "You know other players only by what anyone could see of them: their name, level, race, class, spec and guild, and what they say in chat; not what they are up to, or why they are where they are."

#    OllamaChat.Say.SeenText
#        Added to a reply in /say: standing near each other, anyone can see
#        anyone's level and class just by looking, so a bot does not tell
#        them its level unless asked, and hardly ever asks theirs ("i'm 54,
#        just grinding" to someone who can see it is not what people say).
#        Mingle.PromptTemplate says the same of a /say exchange between bots.
#        Placeholder: {player_name}. Empty disables.
#        Default: "{player_name} is standing near you: you can each see the other's level and class just by looking, so you never tell them your level unless they ask, and you hardly ever ask theirs."
OllamaChat.Say.SeenText = "{player_name} is standing near you: you can each see the other's level and class just by looking, so you never tell them your level unless they ask, and you hardly ever ask theirs."

#    OllamaChat.Outlook.FactsText
#        What every bot is told about the game itself, on everything it says:
#        whatever it names from the game -- an item, quest, NPC, creature,
#        boss, dungeon, zone, mount, pet, spell or drop -- must really be in
#        Wrath of the Lich King; when it does not know or cannot remember, it
#        says so or asks, rather than make an answer up (or tell someone a
#        thing is not in the game); and made-up fun is fine when it is plainly
#        made up ("imagine if murlocs were ten feet tall"). Without it, bots
#        talking about trinkets invented "Trinket of the Hidden Sun". The
#        keyboard warrior's wrong answers (Knowledge.WrongText) still point at
#        real things. Empty disables.
#        Default: "Anything from the game you name -- an item, quest, NPC, creature, boss, dungeon, zone, mount, pet, spell or drop -- must really be in Wrath of the Lich King, called what it is really called. Never make one up, and never state a fact about one (where it drops, what it does, who can use it, or that it is not in the game) unless you are sure of it: when you do not know or cannot remember, say so, or ask. Made-up fun is fine when it is plainly made up, like imagine if murlocs were ten feet tall."
OllamaChat.Outlook.FactsText = "Anything from the game you name -- an item, quest, NPC, creature, boss, dungeon, zone, mount, pet, spell or drop -- must really be in Wrath of the Lich King, called what it is really called. Never make one up, and never state a fact about one (where it drops, what it does, who can use it, or that it is not in the game) unless you are sure of it: when you do not know or cannot remember, say so, or ask. Made-up fun is fine when it is plainly made up, like imagine if murlocs were ten feet tall."

#    OllamaChat.Outlook.SideText
#    OllamaChat.Outlook.HomeCityText
#    OllamaChat.Outlook.Cities.Horde
#    OllamaChat.Outlook.Cities.Alliance
#        Which side a bot plays, on everything it says. Never told, a Horde
#        bot in Orgrimmar asked General who was going AFK in Stormwind, and
#        bots there talked of the guards as if they were the enemy's ("these
#        grunts are too high level"). SideText names the bot's side and its
#        own side's cities: {side} is Horde or Alliance, {cities} its side's
#        Cities list. HomeCityText is added while it stands in one of its own
#        side's capitals -- the game's own say: the zone is a capital, and
#        that side's -- with {city} that city's name: it is safe there, and
#        the guards are its own side's. The Cities lists are names as they
#        are said in chat, | separated. An empty text leaves it out; both are
#        part of the outlook (Outlook.Enable). Mingle.SideText and
#        Mingle.HomeCityText say the same of a /say exchange between bots,
#        and premises and pool entries about one side's places carry that
#        side's tag (Conversation.Premises).
#        Default: "You play {side}: your own side's cities are {cities}.",
#                 "You are in {city}, one of your side's own cities: you are safe here, its guards are on your side, and people of every level come here: nobody is too low or too high a level for a city.",
#                 "Orgrimmar|Thunder Bluff|the Undercity|Silvermoon City",
#                 "Stormwind|Ironforge|Darnassus|the Exodar"
OllamaChat.Outlook.SideText = "You play {side}: your own side's cities are {cities}."
OllamaChat.Outlook.HomeCityText = "You are in {city}, one of your side's own cities: you are safe here, its guards are on your side, and people of every level come here: nobody is too low or too high a level for a city."
OllamaChat.Outlook.Cities.Horde = "Orgrimmar|Thunder Bluff|the Undercity|Silvermoon City"
OllamaChat.Outlook.Cities.Alliance = "Stormwind|Ironforge|Darnassus|the Exodar"

#    OllamaChat.Outlook.ChatText
#    OllamaChat.Outlook.ChatWords
#    OllamaChat.Outlook.ChatStates
#        What chat itself is really like, for a reply when the talk is of
#        chat. "trade chat is basically a warzone" and "brb gonna go check
#        trade chat" were said on a realm where nobody had typed in Trade all
#        evening, and as if it were somewhere to go. When the line a bot
#        answers, or one of the few before it, has one of ChatWords in it
#        ("check trade", "general is dead", "lfg"; | separated, a word ending
#        in * matches any word that starts with the rest), ChatText is added
#        to the prompt, with {chat} how busy Trade (in a city) and General
#        have really been: one of the four ChatStates -- nobody typed
#        anything, only a line or two (up to 3), a bit of chat (up to 29),
#        busy (30 or more) -- for each, with {channel} its name and {window}
#        "the past hour" (or the minutes since the server came up). Counted
#        are the lines people typed there and the lines this module's bots
#        said there; one of playerbots' own canned lines is not. An empty
#        ChatText leaves it out; Mingle.ChatText says the same of a /say
#        exchange between bots.
#        Default: "General, and in the cities Trade, show in your own chat window wherever you are, as they do in everyone's, so nobody goes anywhere to read them. What they have really been like here: {chat}. Say nothing about them that is not so.",
#                 "trade chat|trade channel|in trade|on trade|try trade|check trade|spam trade|trade is|trade was|trades dead|trade dead|general chat|general channel|in general|check general|general is|general was|generals dead|general dead|lfg|chat|chats|channel|channels|spam|spamming|spammy|spammers",
#                 "nobody has typed anything in {channel} for {window}|{channel} has had only a line or two in {window}|{channel} has had a bit of chat in {window}|{channel} has been busy in {window}"
OllamaChat.Outlook.ChatText = "General, and in the cities Trade, show in your own chat window wherever you are, as they do in everyone's, so nobody goes anywhere to read them. What they have really been like here: {chat}. Say nothing about them that is not so."
OllamaChat.Outlook.ChatWords = "trade chat|trade channel|in trade|on trade|try trade|check trade|spam trade|trade is|trade was|trades dead|trade dead|general chat|general channel|in general|check general|general is|general was|generals dead|general dead|lfg|chat|chats|channel|channels|spam|spamming|spammy|spammers"
OllamaChat.Outlook.ChatStates = "nobody has typed anything in {channel} for {window}|{channel} has had only a line or two in {window}|{channel} has had a bit of chat in {window}|{channel} has been busy in {window}"

#    OllamaChat.Sides.Cries.Horde
#    OllamaChat.Sides.Cries.Alliance
#    OllamaChat.Sides.OwnCryText
#    OllamaChat.Sides.EnemyCryText
#        Battle cries, | separated. A real player's short line that is one --
#        "FOR THE HORDE!!", "lok'tar ogar" -- is said to everyone, so a few
#        bots answer, and each reply prompt is told what it is: their own
#        side's (OwnCryText: shout it back, cheer, join in) or, said in their
#        side's chat, the other side's (EnemyCryText: give them stick for it,
#        all in fun). {player_name} said it, {cry} is the cry, {side} the
#        bot's side (Horde, Alliance) and {the_side} the same with "the".
#        A line is a cry when it is the cry and at most three other words,
#        not a sentence that mentions one. An empty text leaves that one out.
#        Default: "for the horde|lok'tar ogar|loktar ogar|lok-tar ogar", "for the alliance", (below)
OllamaChat.Sides.Cries.Horde = "for the horde|lok'tar ogar|loktar ogar|lok-tar ogar"
OllamaChat.Sides.Cries.Alliance = "for the alliance"
OllamaChat.Sides.OwnCryText = "{player_name} just shouted {the_side}'s battle cry ('{cry}'), and you are {side} too: shout it back, cheer or join in, in your own style."
OllamaChat.Sides.EnemyCryText = "{player_name} just shouted the other side's battle cry ('{cry}') among {the_side}: give them some stick for it, all in fun -- boo, call them a traitor or a spy, or ask whose side they are on -- in your own style."

#    OllamaChat.Race.Phrases.<Race>
#        What each race says in the game -- its NPCs' greetings and farewells,
#        and the best-known phrases of its own language -- so a bot knows its
#        race as more than a word: "zug zug" is an orc's okay, "hello mon" is
#        how trolls talk, "ishnu-alah" is darnassian for good fortune to you.
#        | separated entries, each "spellings=what it is": the spellings
#        comma-separated, the first as it is shown, the rest as players
#        might type it (apostrophes count for nothing, a hyphen splits a
#        word). The same spelling under two races ("well met") is both
#        theirs. <Race> is Human, Orc, Dwarf, NightElf, Undead, Tauren, Gnome,
#        Troll, BloodElf or Draenei. Only what really is in the game: these
#        come from its own NPC lines and its languages.
#        A real player's short line with one (at most four other words) is
#        said to everyone, a bot of that race answers first if one is there,
#        and each reply prompt is told what it is (HeardText) -- and a bot of
#        that race that saying it back is part of the joke (HeardSameText).
#        Default: (below)
OllamaChat.Race.Phrases.Human = "well met=a greeting human and dwarf NPCs give you|light bless you=a human NPC's farewell"
OllamaChat.Race.Phrases.Orc = "zug zug, zug-zug, zugzug=an orc's okay, the greeting orc NPCs give you, and what peons said in the old Warcraft games|lok'tar, lok-tar, loktar=orcish for victory, a war cry and an orc NPC's greeting|aka'magosh, akamagosh=orcish for a blessing on you and yours|dabu=orcish for I obey, what orc grunts said in the old Warcraft games|swobu=orcish for as you command, what orc peons and grunts said in the old Warcraft games|work work=what orc peons said in Warcraft III|go with honor, go with honour=an orc NPC's farewell"
OllamaChat.Race.Phrases.Dwarf = "well met=a greeting human and dwarf NPCs give you|off with ye=a dwarf NPC's farewell"
OllamaChat.Race.Phrases.NightElf = "ishnu-alah, ishnu alah, ishnualah=darnassian for good fortune to you, a greeting|elune-adore, elune adore=darnassian for Elune be with you, a greeting|ande'thoras-ethil, andethoras ethil=darnassian for may your troubles be diminished, a farewell|shan'do=darnassian for honoured teacher|shaha lor'ma=darnassian for thank you|elune be with you=a night elf NPC's greeting"
OllamaChat.Race.Phrases.Undead = "dark lady watch over you=a Forsaken NPC's farewell, the Dark Lady being Sylvanas"
OllamaChat.Race.Phrases.Tauren = "walk with the earth mother=a tauren NPC's farewell|ish-ne-alo por-ah, ishne alo porah, ishnealo porah=taur-ahe for may the days ahead be guided by the elders of long ago, Cairne Bloodhoof's greeting|moo=the cow joke every tauren hears"
OllamaChat.Race.Phrases.Gnome = "salutations=a gnome NPC's greeting|for gnomeregan=the gnomes' battle cry"
OllamaChat.Race.Phrases.Troll = "hello mon, hey mon, hi mon, greetings mon, ya mon, yah mon, yeh mon, yeah mon=how trolls talk in the game, in their Caribbean-sounding accent: troll NPCs greet you with hello mon|stay away from the voodoo, stay away from da voodoo, stay away from de voodoo=a troll NPC's farewell|see ya layta=a troll NPC's farewell"
OllamaChat.Race.Phrases.BloodElf = "bal'a dash malanore, bal'a dash, bala dash=thalassian for greetings, traveller|anaria shola=thalassian for speak your business, a blood elf NPC's greeting|shorel'aran, shorelaran=thalassian for farewell|selama ashal'anore=thalassian for justice for our people|sinu a'manore=thalassian for well met|anu belore dela'na=thalassian for the sun guides us|al diel shala=thalassian for safe travels"
OllamaChat.Race.Phrases.Draenei = "archenon poros, arkanon poros=draenei for good fortune|blessings upon you=a draenei NPC's greeting|dioniss aca=draenei for safe journey"

#    OllamaChat.Race.HeardText
#    OllamaChat.Race.HeardSameText
#        What a reply prompt is told about a race's phrase a real player said:
#        {player_name}, {phrase} (as listed), {meaning}, {race_plural} (whose:
#        orcs, humans and dwarves), and {same}, HeardSameText for a bot of
#        that race ({a_race}: an orc; {race_plural}: orcs), else nothing.
#        Default: (below)
OllamaChat.Race.HeardText = "{player_name} said '{phrase}': {meaning}. Players say these for fun, so play along if it suits your style.{same}"
OllamaChat.Race.HeardSameText = "You are {a_race} too: saying it back, or something else {race_plural} say, is part of the joke."

#    OllamaChat.Race.UseText
#    OllamaChat.Race.UseChance
#    OllamaChat.Race.StyleChance
#        Now and then a bot's own line -- a reply, or something it says
#        unprompted -- is told it could slip in something its own race says,
#        if it fits: UseChance percent of its lines, or its style's share in
#        StyleChance ("KEY:percent", space separated: the roleplayer more,
#        the quiet ones never). {a_race}, {race_plural}, and {phrases}: up to
#        three of its race's phrases, picked at random, each with what it is.
#        Not when the line it answers is one already. Mingle.RaceText is the
#        same for a /say exchange between bots. UseChance 0 or an empty text
#        turns it off.
#        Default: (below), 3, "NAT_ROLEPLAYER:25 NAT_LOREBUFF:10 NAT_JOKER:6 NAT_BANTER:6 NAT_PRANKSTER:6 NAT_HYPE:5"
OllamaChat.Race.UseText = "You are {a_race}. If it fits this line and your style, you could slip in something {race_plural} say in the game, just for fun: {phrases}."
OllamaChat.Race.UseChance = 3
OllamaChat.Race.StyleChance = "NAT_ROLEPLAYER:25 NAT_LOREBUFF:10 NAT_JOKER:6 NAT_BANTER:6 NAT_PRANKSTER:6 NAT_HYPE:5"

###############################################################################
#
#   OLLAMA CHAT - ITEM AND QUEST LINKS
#
#   Players link what they talk about. A model cannot write a link (it is
#   client markup with an id in it), so bots are asked to put an exact item
#   or quest name in square brackets, and each "[Name]" becomes a real link
#   when the line is said, from the first of:
#
#     1. a link someone posted in chat lately -- the exact one, random
#        suffix and all -- so a bot answering about it links the same thing;
#     2. a quest in the bot's quest log, or an item it carries;
#     3. the item and quest tables (UseGameData), picking the entry nearest
#        the bot's level, and for quests one its faction can take.
#
#   A name nothing matches just loses its brackets: a made-up "[Sword of
#   Doom]" reads as Sword of Doom. A line never grows past what the client
#   accepts (255 bytes); a link that would not fit stays as text.
#   .ollama status talk shows how many names were linked and how many were
#   not.
#
###############################################################################

#    OllamaChat.Links.Enable
#        Default: 1
OllamaChat.Links.Enable = 1

#    OllamaChat.Links.MaxPerLine
#        At most this many links in one line; the rest stay as text.
#        Default: 2 (0-5)
OllamaChat.Links.MaxPerLine = 2

#    OllamaChat.Links.RememberMinutes
#        How long a link someone posted stays the one bots use for that name.
#        0 keeps them until the server restarts (up to 400).
#        Default: 60
OllamaChat.Links.RememberMinutes = 60

#    OllamaChat.Links.RepeatSeconds
#        "anyone know where i get [Rune of Teleportation]?" and every answer
#        linked it again, a wall of the same link. Once a thing has been
#        linked in a chat -- in the line being answered, or by a bot -- bots
#        name it plainly there for this many seconds. 0 turns this off.
#        Default: 180
OllamaChat.Links.RepeatSeconds = 180

#    OllamaChat.Links.UseGameData
#        Look names up in the item and quest tables when nobody posted them
#        and the bot does not have them. The first lookup builds a name index
#        (well under a second, once per restart).
#        Default: 1
OllamaChat.Links.UseGameData = 1

#    OllamaChat.Links.PromptHint
#        What bots are told, at the end of chat, chatter and event prompts.
#        Told to bracket every item and quest they named, they linked things
#        nobody needed linked: answering a question about one, or joking about
#        it. A link is for asking about something, offering it, asking for it
#        or showing it off.
#        Default: (below)
OllamaChat.Links.PromptHint = "Put an item's or quest's exact name in square brackets -- which makes it a link -- only when you are asking about it, offering it, asking for it or showing it off. Just mentioning it, answering a question about it or joking about it, write the name plainly, without brackets."

#    OllamaChat.Links.QuestDoneText
#    OllamaChat.Links.QuestOnText
#    OllamaChat.Links.QuestRewardedText
#    OllamaChat.Links.QuestNoneText
#        A quest named in a line (see DescribeText below) comes with whether
#        the bot has it: done and only to hand in (QuestDoneText, {ender}: "
#        to Sven", or nothing), on it (QuestOnText, {progress}: ": Skeletal
#        Raider 7/15, Skeletal Healer 0/3", or nothing), done and handed in
#        already (QuestRewardedText), or not in its quest log (QuestNoneText).
#        "do you have [Proving Your Worth]?" read as asking for an item: "no
#        i need that for the quest". Empty leaves that one out.
#        Default: (below)
OllamaChat.Links.QuestDoneText = "(you have it in your quest log and it is done: it only needs handing in{ender})"
OllamaChat.Links.QuestOnText = "(you have it in your quest log, not done yet{progress})"
OllamaChat.Links.QuestRewardedText = "(you did it already)"
OllamaChat.Links.QuestNoneText = "(you do not have it in your quest log)"

#    OllamaChat.Links.DescribeEnable
#    OllamaChat.Links.DescribeMax
#    OllamaChat.Links.DescribeQuestChars
#    OllamaChat.Links.DescribeText
#        The model only sees a name in brackets: "anyone seen [Dusty Mining
#        Boots]?" got advice on how to kill the boots, and "need a healer for
#        [Look To The Stars]" was a delivery quest. A bot answering a line
#        that names items or quests -- links, or names in brackets that match
#        something real -- is told what they are (up to DescribeMax): an
#        item's kind, slot, quality and level ("[Dusty Mining Boots] is an
#        item, not a person or a creature: green leather armour, boots, worn
#        on the feet, item level 15"), a quest's zone, kind and what it asks
#        (its quest log objectives, at most DescribeQuestChars). DescribeText
#        holds them ({things}). Empty DescribeText, or Enable = 0, turns it
#        off.
#        Default: 1, 3, 180, (below)
OllamaChat.Links.DescribeEnable = 1
OllamaChat.Links.DescribeMax = 3
OllamaChat.Links.DescribeQuestChars = 180
OllamaChat.Links.DescribeText = "So you know what that is about: {things}. Talk about each as what it is."

#    OllamaChat.Links.QuestLevelsAbove
#    OllamaChat.Links.QuestTooHighText
#    OllamaChat.Links.QuestEasyText
#    OllamaChat.Links.ItemTooHighText
#        Each thing described says how it sits against the bot's own level,
#        so a level 12 does not offer to help with a level 26 quest. A quest
#        is too high for a bot when it is more than QuestLevelsAbove levels
#        above it (playerbots itself takes quests up to 3 above), or the bot
#        cannot take it yet; easy when it is grey to the bot. An item is too
#        high when it needs a higher level. Each text goes after the thing it
#        is about ({bot_level}); empty leaves it out.
#        Default: 3, (below)
OllamaChat.Links.QuestLevelsAbove = 3
OllamaChat.Links.QuestTooHighText = "(you are level {bot_level}, far too low for it: you could not do it or help anyone with it, so you would not offer to)"
OllamaChat.Links.QuestEasyText = "(you are level {bot_level}, so it would be easy for you)"
OllamaChat.Links.ItemTooHighText = "(you are level {bot_level}, too low to use it yet)"

#    OllamaChat.Links.QuietWhenTooLow
#        "LFG [Wanted: Gath'Ilzogg]" in General: bots far too low for every
#        quest a line names have nothing to offer and stay out of it, the way
#        people do, unless the line names them. Lines said in public (say,
#        yell, channels, guild), with crowd replies on (Crowd.Enable); party
#        and raid chat answer as before, with the level note above.
#        Default: 1
OllamaChat.Links.QuietWhenTooLow = 1

###############################################################################
#
#   OLLAMA CHAT - TOPIC ENGINE
#
#   What bots choose to talk about. The old pool was uniform over thirteen
#   topics, seven of which were the bot's own inventory and spellbook, and none
#   of which were the people standing next to it -- which is why bots sounded
#   like they were reading a character sheet aloud.
#
#   Weights are relative, not percentages.
#
###############################################################################

#    OllamaChat.Topic.WeightPeople
#        Nearby players by name and what they are doing, group members,
#        guildmates online, and things the bot just watched happen.
#        Default: 30
OllamaChat.Topic.WeightPeople = 30

#    OllamaChat.Topic.WeightWorld
#        The nearest INTERESTING creature (elite, rare, or a real level threat
#        -- never a critter), named NPCs by role, landmarks, corpses, the time
#        of day, and the instance the bot is in.
#        Default: 30
OllamaChat.Topic.WeightWorld = 30

#    OllamaChat.Topic.WeightActivity
#        Current quest objectives, danger assessment, and group needs
#        (someone low on health, someone out of mana).
#        Default: 25
OllamaChat.Topic.WeightActivity = 25

#    OllamaChat.Topic.WeightSelf
#        The original inward-facing topics: spells, equipped items, bag space.
#        Kept, but demoted. Raise this toward 100 to restore the old feel.
#        Default: 15
OllamaChat.Topic.WeightSelf = 15

#    OllamaChat.Topic.WeightGuild
#        Guild-flavoured topics, used only when the bot is in a guild with a
#        real player online.
#        Default: 20
OllamaChat.Topic.WeightGuild = 20

#    OllamaChat.Topic.WeightTalk
#    OllamaChat.EnvCommentGameTalk
#        The game itself, the way General talks about things nowhere near
#        anyone: a raid, an old meme, a bit of lore, a gripe about levelling.
#        It is one of the things a conversation in town opens with
#        (Conversation.Premises and .PremiseTemplates, level-tagged, filled
#        from the pools, and not again across the realm for
#        PremiseCooldownMinutes), offered as a passing remark through
#        EnvCommentGameTalk ({premise}). Not inside a dungeon. 0 turns it off.
#        Default: 25, (below)
OllamaChat.Topic.WeightTalk = 25
OllamaChat.EnvCommentGameTalk = "Something about the game on your mind: {premise}.|Something you could bring up, about the game: {premise}."

#    OllamaChat.Topic.WeightMarket
#    OllamaChat.Market.TalkMinutes
#    OllamaChat.EnvCommentMarketListed
#    OllamaChat.EnvCommentMarketSold
#    OllamaChat.EnvCommentMarketUnsold
#    OllamaChat.EnvCommentMarketBought
#        With mod-playerbots-plus in the same build, random bots trade on the
#        auction house. A bot that just put something up, sold it, got it back
#        unsold or bought something may bring it up in chat, once, within
#        TalkMinutes of it: while it is fresh it is one more topic, weighed
#        against the others by WeightMarket. In the lines: {item} is like
#        "20 [Linen Cloth]", {price} like "1g 20s", {to} is " to <buyer>" or
#        nothing, {from} is " from <seller>" or nothing. WeightMarket 0 turns
#        it off. Without mod-playerbots-plus none of this does anything.
#        Default: 30, 90, (below)
OllamaChat.Topic.WeightMarket = 30
OllamaChat.Market.TalkMinutes = 90
OllamaChat.EnvCommentMarketListed = "You just put {item} up on the auction house for {price}. Mention it the way players do in General: that it is up if anyone wants it, or ask what it usually goes for.|{item} is up on the auction house now, yours, for {price}. Say so in passing, or wonder whether you priced it right."
OllamaChat.EnvCommentMarketSold = "Your {item} just sold on the auction house for {price}{to}. Say something about it in passing: pleased it went, or that you should have asked more.|Someone bought your {item} off the auction house for {price}{to}. Mention it the way a player would."
OllamaChat.EnvCommentMarketUnsold = "Nobody bought your {item} on the auction house at {price}, and it came back in the mail. Grumble about it, or ask what it is actually worth.|Your {item} came back unsold from the auction house. Say something about the auction house, the way players do."
OllamaChat.EnvCommentMarketBought = "You just bought {item} off the auction house for {price}{from}. Mention it the way a player would: a bargain, a rip-off, or just what you needed.|You got {item} on the auction house for {price}{from}. Say something about it in passing."

#    OllamaChat.Topic.MemoryCount
#        How many recently used topics are suppressed per bot, so a bot does
#        not talk about the same thing twice in a row.
#        Default: 4
OllamaChat.Topic.MemoryCount = 4

#    OllamaChat.Topic.EventMemorySize
#        How many witnessed events each bot remembers -- "Kaelan killed a Fjord
#        Hawk", "Sereth was killed". This is what lets a bot comment on the
#        fight you were both just in instead of reciting a fact about itself.
#        0 disables witnessed-event memory.
#        Default: 6
OllamaChat.Topic.EventMemorySize = 6

#    OllamaChat.Topic.EventMemorySeconds
#        How long a witnessed event stays worth mentioning.
#        Default: 300
OllamaChat.Topic.EventMemorySeconds = 300

#    OllamaChat.Topic.PlayerRadius
#        How far a bot looks when picking a nearby player to talk about.
#        Default: 40
OllamaChat.Topic.PlayerRadius = 40

#    OllamaChat.RandomChatterQuestionChance
#        Percentage of ambient lines phrased as a question rather than a
#        statement. The old code was a fixed 50/50.
#        Default: 35
OllamaChat.RandomChatterQuestionChance = 35

###############################################################################
#
#   OLLAMA CHAT - GAME STATE SNAPSHOT LIMITS
#
###############################################################################

#    OllamaChat.Snapshot.IncludeSpells
#        Whether to list the bot's usable spells in the prompt.
#
#        This defaults to OFF now. The old code pasted EVERY non-passive,
#        off-cooldown spell a bot knew into the prompt -- dozens of lines of
#        the most concrete, most quotable text present -- which is the direct
#        reason bots kept talking about their spellbook.
#        Default: 0
OllamaChat.Snapshot.IncludeSpells = 0

#    OllamaChat.Snapshot.MaxSpells
#        If spells are included, how many to list (randomly chosen, so it is
#        not always the alphabetically-first ones).
#        Default: 6
OllamaChat.Snapshot.MaxSpells = 6

#    OllamaChat.Snapshot.MaxCreatures
#        Nearby creatures listed in the snapshot, nearest first. The snapshot
#        now uses a grid search; it previously walked every creature spawn on
#        the whole map on every prompt build. A place's guards and townsfolk,
#        and anything that never fights (a training dummy), are not listed.
#        Default: 8
OllamaChat.Snapshot.MaxCreatures = 8

#    OllamaChat.Snapshot.MaxObjects
#        Nearby gameobjects listed in the snapshot, nearest first.
#        Default: 8
OllamaChat.Snapshot.MaxObjects = 8

#    OllamaChat.Snapshot.MaxPlayers
#        Nearby players listed in the snapshot, nearest first. Resolved with a
#        grid search rather than a walk of every character online.
#        Default: 8
OllamaChat.Snapshot.MaxPlayers = 8

###############################################################################
#
#   OLLAMA CHAT - ROLEPLAY MODE
#
#   Race and class as a VOICE rather than as a stat line. Off by default.
#
###############################################################################

#    OllamaChat.Roleplay.Enable
#        Master switch for roleplay mode.
#        Default: 0
OllamaChat.Roleplay.Enable = 0

#    OllamaChat.Roleplay.Strictness
#        0 = Flavour only. Race and class voices colour the prompt; nothing
#            else changes. A drop-in upgrade.
#        1 = In character. Out-of-world vocabulary is filtered from replies and
#            faction attitude is applied.
#        2 = Hard in character. The roleplay chatter lists replace the shipped
#            out-of-character ones, injuries and distances are described rather
#            than quoted as figures, and think mode is used where supported.
#        Default: 1
OllamaChat.Roleplay.Strictness = 1

#    OllamaChat.Roleplay.UseRaceVoice
#        Give each race a speech register and cultural touchstones -- a Tauren
#        speaks of the Earthmother and the balance, a Forsaken is dry and calls
#        the living "breathers", a Gnome is fast and technical.
#        Default: 1
OllamaChat.Roleplay.UseRaceVoice = 1

#    OllamaChat.Roleplay.UseClassVoice
#        Give each class a worldview -- what that character NOTICES. A priest
#        sees wounds, a hunter reads tracks and terrain, a rogue counts exits.
#        Default: 1
OllamaChat.Roleplay.UseClassVoice = 1

#    OllamaChat.Roleplay.FactionAttitude
#        Bots speak as loyal to their own faction and wary of the other.
#        Default: 1
OllamaChat.Roleplay.FactionAttitude = 1

#    OllamaChat.Roleplay.BlockMetaTerms
#        At Strictness >= 1, reject any reply containing out-of-world
#        vocabulary. The line is dropped rather than mangled, so the bot stays
#        silent instead of stepping out of character.
#        Default: 1
OllamaChat.Roleplay.BlockMetaTerms = 1

#    OllamaChat.Roleplay.MetaTermList
#        Pipe-separated, matched as whole words, case-insensitive.
OllamaChat.Roleplay.MetaTermList = "dps|nerf|proc|patch|server|realm|respec|mmo|npc|toon|irl|lfg|afk|noob|meta|aggro|dot|hot|aoe|wipe|hitbox|hotfix|expansion"

#    OllamaChat.Roleplay.CrossFactionGibberish
#        Do not generate say/yell replies across factions. The client renders
#        Orcish and Common as gibberish anyway, so a fluent cross-faction reply
#        is the single most immersion-breaking thing the module can do --
#        and skipping it saves the LLM round trip too.
#        Default: 1
OllamaChat.Roleplay.CrossFactionGibberish = 1

#    OllamaChat.Roleplay.PromptVariations
#    OllamaChat.Roleplay.QuestionVariations
#        In-character replacements for RandomChatterPromptVariations and
#        RandomChatterQuestionVariations, used at Strictness 2. The shipped
#        lists push the other way ("Complain about nerfed abilities", "Ask if
#        dual spec was worth the cost") -- that is player-forum talk, not
#        in-world talk. Pipe-separated. Leave unset to use the built-in
#        defaults, which are already in-world.
# OllamaChat.Roleplay.PromptVariations = ""
# OllamaChat.Roleplay.QuestionVariations = ""

###############################################################################
#
#   OLLAMA CHAT - EMBODIMENT (FACING, GESTURES, EMOTE REACTIONS)
#
#   Makes a reply read as conversation rather than as a log line.
#
###############################################################################

#    OllamaChat.EnableBotFacing
#        Turn the bot to face whoever it is answering, just before the line
#        lands. Skipped while the bot is moving, casting, in combat, mounted in
#        flight, on a transport, or being teleported.
#        Default: 1
OllamaChat.EnableBotFacing = 1

#    OllamaChat.Facing.MaxDistance
#        Do not turn toward a target further away than this. 0 = no limit.
#        Default: 40
OllamaChat.Facing.MaxDistance = 40

#    OllamaChat.EnableBotEmotes
#        Let bots play a real text emote alongside a reply when the model
#        supplies a gesture tag. The prompt asks for "[emote:wave]"; the parser
#        also accepts "*waves*" and a bare "/wave", because models emit those
#        unprompted. Unrecognised tags are stripped rather than spoken.
#
#        The emote is played through the same code path the client uses, so
#        nearby players see the animation AND the "Bot waves at You." social
#        text, with the correct per-race and per-gender emote variant.
#        Default: 1
OllamaChat.EnableBotEmotes = 1

#    OllamaChat.GestureChance
#        Percent chance (0-100) that a line's prompt invites a gesture at all.
#
#        Gestures are offered on replies, random chatter AND event chatter.
#        Inviting one on every single line made bots gesture almost
#        constantly, which reads as twitchy rather than alive -- and it spends
#        prompt budget on a sentence most lines do not need. The model still
#        decides whether a gesture fits when it is offered, so the real rate is
#        lower than this number.
#
#        0 = never offer a gesture. Models sometimes emit "*waves*" unprompted
#        anyway, and that is still parsed.
#        Default: 40
OllamaChat.GestureChance = 40

#    OllamaChat.StateEmoteDurationMs
#        How long a bot holds a posture or looping emote, in milliseconds.
#
#        Two emotes stick, for two different reasons:
#
#          /dance          sets UNIT_NPC_EMOTESTATE. The only thing that clears
#                          it for a real player is the handler for a movement
#                          packet from the client, and bots move server-side
#                          through MotionMaster so they never send one. Without
#                          this a mirrored /dance danced forever, and even
#                          resumed after combat or a one-shot emote because the
#                          field was still set underneath.
#
#          /sit /sleep     the core's text-emote handler broadcasts the social
#          /kneel          line for these and then does nothing, so the bot
#                          announced it was sitting down while standing there.
#                          The module applies the posture the core leaves out,
#                          which means it also has to take it back off.
#
#        The bot is only stood back up when it is still in the exact posture
#        the emote put it in, so this never interrupts eating, drinking, or a
#        sit its own AI chose afterwards.
#
#        0 disables both the posture change and the clear.
#        Default: 15000
OllamaChat.StateEmoteDurationMs = 15000

#    OllamaChat.EmoteFallback
#        Gesture to play when the model supplies an emote name that is not a
#        real WoW emote. The prompt tells the model any common emote name
#        works, and models reach for ones the game does not have ("grunt"), so
#        those replies used to lose their gesture with nothing in the log.
#
#        Set to a name from the emote table, or leave empty for no fallback.
#        Unresolved names are logged when DebugEnable is on, so you can see
#        which ones your model favours and decide whether to care.
#        Default: talk
OllamaChat.EmoteFallback = "talk"

#    OllamaChat.BotExpressionDelayMs
#        Delay before the turn and gesture fire, in milliseconds. A small delay
#        keeps it from looking instant and robotic.
#        Default: 400
OllamaChat.BotExpressionDelayMs = 400

#    OllamaChat.EnableEmoteReactions
#        Bots react when a real player emotes at them.
#        Default: 1
OllamaChat.EnableEmoteReactions = 1

#    OllamaChat.Emote.EventText
#        An emote is part of what everyone nearby saw: a real player's at a
#        bot, a bot's back at them, and a bot's at someone walking past
#        (Presence) go into the chat transcript ("Jukaroug gave Kami a
#        /sigh"), for the people nearby and the one who did it's party.
#        Without it no bot knew it had happened, so "why you sighing at me?"
#        went to whoever had last said something, who had no idea what it
#        was being asked. Now the one who did it is who the next line is
#        taken to be aimed at, and it knows why; and a player who emotes at
#        a bot and then says something is taken to be talking to that bot.
#        Placeholders: {actor}, {target}, {emote} (its name: "sigh",
#        "wave"). Empty disables.
#        Default: (below)
OllamaChat.Emote.EventText = "{actor} gave {target} a /{emote}"

#    OllamaChat.EmoteReplyChance
#        Percentage chance a bot reacts to an emote aimed at it.
#        Default: 60
OllamaChat.EmoteReplyChance = 60

#    OllamaChat.EmoteReply.MirrorWeight
#    OllamaChat.EmoteReply.CounterWeight
#    OllamaChat.EmoteReply.SpeakWeight
#        Relative weights for the three reaction styles:
#            Mirror  - wave gets a wave, bow gets a bow. Free, no LLM call.
#            Counter - flex gets a laugh, rude gets a glare. Also free.
#            Speak   - answer in words, via the LLM.
#        Defaults: 55 / 30 / 15
OllamaChat.EmoteReply.MirrorWeight = 55
OllamaChat.EmoteReply.CounterWeight = 30
OllamaChat.EmoteReply.SpeakWeight = 15

#    OllamaChat.EmoteReply.CooldownSeconds
#        Debounce per (player, bot) pair, so /spam cannot flood the queue.
#        Default: 20
OllamaChat.EmoteReply.CooldownSeconds = 20

#    OllamaChat.EmoteReactionPromptTemplate
#        Prompt used when a bot answers an emote in words.
#        Placeholders: {bot_name} {bot_level} {bot_class} {bot_race}
#                      {bot_personality} {bot_personality_name}
#                      {player_name} {player_class} {player_race} {emote_name}
#        Leave unset to use the built-in default.
# OllamaChat.EmoteReactionPromptTemplate = ""

###############################################################################
#
#   OLLAMA CHAT - TOPIC COMMENT POOLS
#
#   Pipe-separated, exactly like the existing EnvComment* settings. All of
#   these ship with built-in defaults, so leaving them unset is fine.
#
###############################################################################

#    Nearby players. Placeholders: {player_name} {player_class} {player_race}
#    {player_level} {player_state} {level_gap}
#    {player_state} is one of: lying dead, fighting, mounted up, flying
#    overhead, standing idle, sitting down, badly hurt, passing by.
# OllamaChat.EnvCommentNearbyPlayer = ""

#    Group members. Placeholders: {member_name} {member_class} {member_state}
#    {member_level}
# OllamaChat.EnvCommentGroupMember = ""

#    Guildmates online. Placeholders: {member_name} {member_class} {member_level}
# OllamaChat.EnvCommentGuildMemberOnline = ""

#    Something the bot just witnessed. Placeholder: {event_text}
# OllamaChat.EnvCommentRecentEvent = ""

#    Named NPCs by role. Placeholders: {npc_name} {npc_role}
#    {npc_role} is one of: innkeeper, merchant, quest giver, trainer.
# OllamaChat.EnvCommentNamedNpc = ""

#    Where they are. Placeholders: {area_name} {zone_name}
# OllamaChat.EnvCommentZoneLandmark = ""

#    Time of day. Placeholder: {time_of_day}
# OllamaChat.EnvCommentTimeOfDay = ""

#    A corpse nearby. Placeholders: {creature_name} {creature_level} {level_delta}
# OllamaChat.EnvCommentCorpse = ""

#    A dangerous creature. Placeholders: {creature_name} {level_delta}
# OllamaChat.EnvCommentDanger = ""

#    Current quest objective. Placeholders: {quest_name} {objective}
# OllamaChat.EnvCommentQuestObjective = ""

#    A group member needs something. Placeholders: {member_name} {need}
# OllamaChat.EnvCommentGroupNeed = ""

###############################################################################
#
#   OLLAMA CHAT - OPTIONAL SAMPLING CONTROLS
#
#   Extra knobs for response diversity and repetition. All are UNSET by
#   default: when unset the field is not sent at all, so the model's own
#   default applies and behaviour is unchanged unless you opt in.
#
#   These act inside a single generation. They do not replace the repetition
#   controls under CONVERSATION GOVERNOR, which compare a candidate reply
#   against what was actually said earlier — a model cannot see that.
#
###############################################################################

#    OllamaChat.TopK
#        Sample only from the K most likely tokens. Lower = more focused,
#        higher = more varied. Typical range 20-100.
#        -1 = unset (default)
OllamaChat.TopK = -1

#    OllamaChat.MinP
#        Drop tokens below this fraction of the top token's probability. Often
#        a better diversity control than TopK. Typical range 0.02-0.10.
#        -1 = unset (default)
OllamaChat.MinP = -1

#    OllamaChat.PresencePenalty
#        Penalises tokens that have appeared at all, pushing toward new
#        subject matter. Typical range 0.0-1.0.
#        Unset by default.
# OllamaChat.PresencePenalty = 0.4

#    OllamaChat.FrequencyPenalty
#        Penalises tokens in proportion to how often they have appeared,
#        which curbs verbatim repetition within a reply. Typical range 0.0-1.0.
#        Unset by default.
# OllamaChat.FrequencyPenalty = 0.4

###############################################################################
#
#   OLLAMA CHAT - AMBIENT CHANNEL SELECTION
#
#   Which numbered channels ambient (random) chatter may speak in. Replies
#   always follow whichever channel the player used and are not affected by
#   these.
#
#   Channels are resolved by channel ID and zone, not by name — city channels
#   such as "Trade - Stormwind City" and "GuildRecruitment - Stormwind City"
#   now resolve correctly, including on localized realms.
#
#   Trade and GuildRecruitment only exist in cities, so enabling them simply
#   has no effect while a bot is out in the world.
#
###############################################################################

#    OllamaChat.Chatter.UseGeneralChannel
#        Default: 1
OllamaChat.Chatter.UseGeneralChannel = 1

#    OllamaChat.Chatter.UseTradeChannel
#        Default: 1
OllamaChat.Chatter.UseTradeChannel = 1

#    OllamaChat.Chatter.UseLookingForGroupChannel
#        Realm-wide, so bot chatter here is visible to everyone. Off by
#        default to avoid flooding it.
#        Default: 0
OllamaChat.Chatter.UseLookingForGroupChannel = 0

#    OllamaChat.Chatter.UseGuildRecruitmentChannel
#        Default: 0
OllamaChat.Chatter.UseGuildRecruitmentChannel = 0

###############################################################################
#
#   OLLAMA CHAT - LONG-TERM MEMORY AND RELATIONSHIPS
#
#   Conversation history is a sliding window: once a line falls out of it, the
#   bot has no idea it ever happened. That is why bots otherwise feel like they
#   meet you fresh every session no matter how much you have talked.
#
#   Two mechanisms fix that, both bounded so the prompt never grows without
#   limit however long a character has been alive:
#
#     MEMORY         History accumulates until it crosses a token budget, at
#                    which point the model condenses it into a few short
#                    narrator-style notes with importance scores and the raw
#                    history is cleared. The most important notes are then
#                    selected into each prompt within a smaller budget.
#
#     RELATIONSHIPS  When a name comes up often enough in a bot's history, the
#                    model writes (or revises) a sentence on how that bot feels
#                    about that person. It goes into future prompts, so a bot's
#                    attitude persists and evolves rather than resetting.
#
#   Both work in normal mode and roleplay mode. They complement the numeric
#   sentiment score, which stays as-is — this is the qualitative half.
#
#   Requires the tables from
#   data/sql/characters/base/2026_08_29_memory_relationships.sql
#
###############################################################################

#    OllamaChat.Memory.Enable
#        Master switch for long-term memory.
#        Default: 1
OllamaChat.Memory.Enable = 1

#    OllamaChat.Memory.HistoryTokenLimit
#        Condense once a bot's accumulated history exceeds roughly this many
#        tokens. Lower = memories form sooner but from less material.
#        0 disables condensation (history then just rolls off as before).
#        Default: 1500
OllamaChat.Memory.HistoryTokenLimit = 1500

#    OllamaChat.Memory.PromptTokenBudget
#        How much of each prompt remembered notes may occupy. This is the hard
#        stop on prompt growth.
#        Default: 400
OllamaChat.Memory.PromptTokenBudget = 400

#    OllamaChat.Memory.MaxPerBot
#        Notes retained per character. When exceeded the least important are
#        dropped.
#        Default: 40
OllamaChat.Memory.MaxPerBot = 40

#    OllamaChat.Memory.SaveInterval
#        Minutes between writes of memories and relationships to the database.
#        Default: 10
OllamaChat.Memory.SaveInterval = 10

#    OllamaChat.Memory.CondensePrompt
#        Prompt used to distil history into memories.
#        Placeholders: {bot_name} {history}
#        The model is asked for one note per line, prefixed "N | " where N is
#        an importance from 1 to 10. Leave unset to use the built-in default.
# OllamaChat.Memory.CondensePrompt = ""

#    OllamaChat.Memory.PromptTemplate
#        How remembered notes are introduced in the prompt.
#        Placeholder: {memories}
# OllamaChat.Memory.PromptTemplate = " Things you remember:\n{memories}"

#    OllamaChat.Relationship.Enable
#        Default: 1
OllamaChat.Relationship.Enable = 1

#    OllamaChat.Relationship.MentionThreshold
#        How many times a name must come up before the character's view of that
#        person is written or revised. Lower = relationships form faster and
#        cost more LLM calls.
#        Default: 8
OllamaChat.Relationship.MentionThreshold = 8

#    OllamaChat.Relationship.MaxPerPrompt
#        How many relationships to include in a prompt. Whoever the bot is
#        currently talking to is always listed first, so their own relationship
#        never gets squeezed out.
#        Default: 3
OllamaChat.Relationship.MaxPerPrompt = 3

#    OllamaChat.Relationship.MaxLength
#        Maximum characters kept from the model's description.
#        Default: 220
OllamaChat.Relationship.MaxLength = 220

#    OllamaChat.Relationship.UpdatePrompt
#        Placeholders: {bot_name} {other_name} {existing} {history}
# OllamaChat.Relationship.UpdatePrompt = ""

#    OllamaChat.Relationship.PromptTemplate
#        Placeholder: {relationships}
# OllamaChat.Relationship.PromptTemplate = " How you feel about people you know:\n{relationships}"

# --------------------------------------------
# ENVIRONMENTAL/CONTEXTUAL TEMPLATES (continued)
# --------------------------------------------
#
# These have working built-in defaults, but the core logs a "Missing
# property" warning for every key it cannot find, so they are written out
# here explicitly. The values below are the module’s own defaults.

# OllamaChat.EnvCommentNearbyPlayer
#   Description: A pipe-separated (|) list of template messages for when another player is seen nearby.
#   In a city, a line that names a level ({player_level} or {level_gap}) is not used: people of every
#   level are in one, and told "a level 12 Gnome Mage is near you", a bot asked in General why there
#   was a level 12 there. Keep a line without a level, or cities get none of these.
#   Placeholders (named): {player_name} {player_race} {player_class} {player_level} {player_state}
#   {level_gap}
OllamaChat.EnvCommentNearbyPlayer = You notice {player_name}, a {player_race} {player_class}, {player_state} nearby. Say something to or about them.|{player_name} the {player_class} is {player_state} close by. React to seeing them.|A level {player_level} {player_class} called {player_name} is nearby. Comment on them.|You size up {player_name}, a {player_race} {player_class}. Say what you make of them.|{player_name} is {player_state} within earshot. Greet or remark on them.|You spot {player_name} and note they are {player_state}. Say something fitting.

# OllamaChat.EnvCommentGroupMember
#   Description: A pipe-separated (|) list of template messages for when a party or raid member is worth commenting on.
#   Placeholders (named): {member_name} {member_class} {member_state}
OllamaChat.EnvCommentGroupMember = Your companion {member_name} the {member_class} is {member_state}. Say something to them.|{member_name} is {member_state}. Comment on how your group is doing.|You glance at {member_name}, your {member_class}, and remark on the group's state.|Talk to {member_name} about what the group should do next.

# OllamaChat.EnvCommentGuildMemberOnline
#   Description: A pipe-separated (|) list of template messages for when a guildmate is online.
#   Placeholders (named): {member_name} {member_class} {member_level}
OllamaChat.EnvCommentGuildMemberOnline = Your guildmate {member_name} the {member_class} is online. Say something to the guild about them.|Greet {member_name} in guild chat, or ask what they are up to.|Mention {member_name}, level {member_level}, to the guild.

# OllamaChat.EnvCommentRecentEvent
#   Description: A pipe-separated (|) list of template messages for when the bot recalls something it just witnessed.
#   Placeholders (named): {event_text}
OllamaChat.EnvCommentRecentEvent = You just saw this happen: {event_text}. React to it.|Something you witnessed: {event_text}. Comment on it naturally.|Bring up what just happened: {event_text}.|You are still thinking about this: {event_text}. Say something about it.

# OllamaChat.EnvCommentNamedNpc
#   Description: A pipe-separated (|) list of template messages for when a named NPC is standing nearby.
#   Placeholders (named): {npc_name} {npc_role}
OllamaChat.EnvCommentNamedNpc = {npc_name} the {npc_role} is standing nearby. Say something about them.|You see {npc_name}, a {npc_role}. Remark on what they offer.|Mention {npc_name} the {npc_role} and whether they are worth visiting.

# OllamaChat.EnvCommentZoneLandmark
#   Description: A pipe-separated (|) list of template messages for when the bot remarks on where it is.
#   Placeholders (named): {area_name} {zone_name}
OllamaChat.EnvCommentZoneLandmark = You are in {area_name}, part of {zone_name}. Say something about this place.|Remark on the look or feel of {area_name}.|Comment on what {zone_name} is known for.|Say whether {area_name} is worth lingering in.

# OllamaChat.EnvCommentTimeOfDay
#   Description: A pipe-separated (|) list of template messages for when the bot remarks on the hour.
#   Placeholders (named): {time_of_day} ("Saturday afternoon": the server's day and
#   time -- with the hour alone, bots made the day up), {weekday} ("Saturday"),
#   {part_of_day} ("afternoon").
OllamaChat.EnvCommentTimeOfDay = It is {time_of_day}. Remark on the hour.|Comment on it being {time_of_day} and what that means for travelling.|Mention that it is {time_of_day} and how you feel about it.

# OllamaChat.EnvCommentCorpse
#   Description: A pipe-separated (|) list of template messages for when a corpse is on the ground nearby.
#   Placeholders (named): {creature_name}
OllamaChat.EnvCommentCorpse = There is a dead {creature_name} on the ground here. React to it.|You see the corpse of a {creature_name}. Say something about the fight that happened.|Remark on the slain {creature_name} nearby.

# OllamaChat.EnvCommentDanger
#   Description: A pipe-separated (|) list of template messages for when a nearby creature outlevels the bot.
#   Placeholders (named): {creature_name} {level_delta}
OllamaChat.EnvCommentDanger = A {creature_name} is nearby and it is {level_delta} levels above you. Warn or brag.|The {creature_name} here looks dangerous. Say whether you would take it on.|Comment on the threat the {creature_name} poses.

# OllamaChat.EnvCommentQuestObjective
#   Description: A pipe-separated (|) list of template messages for when the bot is partway through a quest.
#   Placeholders (named): {quest_name} {objective}
OllamaChat.EnvCommentQuestObjective = You are partway through '{quest_name}' and still need to {objective}. Mention it.|Talk about your task '{quest_name}' and what is left: {objective}.|Bring up '{quest_name}' and ask for help or advice with it.|Complain or enthuse about '{quest_name}'.

# OllamaChat.EnvCommentGroupNeed
#   Description: A pipe-separated (|) list of template messages for when a group member needs something.
#   Placeholders (named): {member_name} {need}
OllamaChat.EnvCommentGroupNeed = {member_name} is {need}. Say something useful about it.|Point out that {member_name} is {need}.|React to {member_name} being {need}.

# OllamaChat.Roleplay.PromptVariations
#   Description: A pipe-separated (|) list of template messages for when roleplay-mode statement prompts, replacing the shipped random-chatter list at Roleplay.Strictness 2.
#   Placeholders (named): none
OllamaChat.Roleplay.PromptVariations = Remark on the weather or the road ahead.|Mention a rumour you heard in the last town.|Say something about the war and what it has cost.|Complain about the price of supplies.|Speak of someone you have lost.|Mention where you are headed and why.|Say something about your faith or what you believe in.|Comment on the state of the land here.|Talk about a beast or enemy you have fought recently.|Mention hunger, thirst, or how long since you last slept.|Say something about your homeland.|Remark on how far you are from anywhere safe.|Speak of an old debt or grudge.|Mention a piece of your gear and where it came from.|Say something about the people passing through here.

# OllamaChat.Roleplay.QuestionVariations
#   Description: A pipe-separated (|) list of template messages for when roleplay-mode question prompts, used the same way.
#   Placeholders (named): none
OllamaChat.Roleplay.QuestionVariations = Ask whether the road ahead is safe.|Ask if anyone has news from the front.|Ask where a person might find work here.|Ask what happened in this place.|Ask whether anyone has seen a particular kind of beast nearby.|Ask where the nearest inn or camp is.|Ask someone where they hail from.|Ask whether the local lord or chieftain is worth trusting.|Ask if anyone needs a hand with something.|Ask what the strangest thing seen around here has been.|Ask whether the water or food here can be trusted.|Ask how long the fighting has been going on.

# --------------------------------------------
# OPTIONAL PROMPT OVERRIDES
# --------------------------------------------
#
# Leave these EMPTY to use the module’s built-in prompt, which is what
# almost everyone wants. They are listed only so the core stops warning
# that the key is missing. Set one to override that prompt entirely.

# OllamaChat.EmoteReactionPromptTemplate
#   Description: Prompt used when a player emotes at a bot.
#   Empty = use the built-in default.
OllamaChat.EmoteReactionPromptTemplate = ""

# OllamaChat.Memory.CondensePrompt
#   Description: Prompt that distils a bot’s conversation history into long-term memories.
#   Empty = use the built-in default.
OllamaChat.Memory.CondensePrompt = ""

# OllamaChat.Memory.PromptTemplate
#   Description: Wrapper around the memory list injected into a prompt.
#   Empty = use the built-in default.
OllamaChat.Memory.PromptTemplate = ""

# OllamaChat.Relationship.PromptTemplate
#   Description: Wrapper around the relationship list injected into a prompt.
#   Empty = use the built-in default.
OllamaChat.Relationship.PromptTemplate = ""

# OllamaChat.Relationship.UpdatePrompt
#   Description: Prompt that rewrites how a bot feels about someone.
#   Empty = use the built-in default.
OllamaChat.Relationship.UpdatePrompt = ""

# --------------------------------------------
# OPTIONAL SAMPLING PENALTIES
# --------------------------------------------
#
# -1000 is a sentinel meaning "do not send this parameter at all", so the
# model’s own default applies. Set a real value (typically 0.0 to 2.0) only
# if you know you want it.

# OllamaChat.PresencePenalty
#   Description: Discourages tokens that already appeared. -1000 = omit the parameter.
#   Default: -1000
OllamaChat.PresencePenalty = -1000

# OllamaChat.FrequencyPenalty
#   Description: Discourages tokens by how often they appeared. -1000 = omit the parameter.
#   Default: -1000
OllamaChat.FrequencyPenalty = -1000

